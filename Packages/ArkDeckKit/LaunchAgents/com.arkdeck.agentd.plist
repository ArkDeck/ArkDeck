<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User-domain LaunchAgent template for arkdeck-agentd. `arkdeck agentd
  install` validates the two executable identities, replaces the placeholder
  strings below, writes the user-owned plist, and bootstraps it in gui/$UID.

  A Mach service exists only when launchd vends it: a daemon started straight
  from a shell has nothing to check in to, so its read-only XPC door stays
  closed and only the Unix socket serves. That is the correct configuration
  for CLI, CI and host agents, and nothing here changes it — this file exists
  for the one client that cannot use the Unix socket, the sandboxed App.

  Do not install this template by hand: unresolved placeholders deliberately
  fail closed. See README.md in this directory for the user workflow.

  The MachServices key below, ArkDeckAgentXPC.machServiceName, and the App's
  com.apple.security.temporary-exception.mach-lookup.global-name entitlement
  must all name the same service. AgentXPCTransportContractTests pins that.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.arkdeck.agentd</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ARKDECK_AGENTD_EXECUTABLE__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ARKDECK_HDC_PATH</key>
		<string>__ARKDECK_HDC_EXECUTABLE__</string>
	</dict>
	<key>MachServices</key>
	<dict>
		<key>com.arkdeck.agentd</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__ARKDECK_AGENTD_STDOUT__</string>
	<key>StandardErrorPath</key>
	<string>__ARKDECK_AGENTD_STDERR__</string>
</dict>
</plist>
