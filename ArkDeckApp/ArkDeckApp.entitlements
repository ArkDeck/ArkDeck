<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.serial</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- "Use system default" is intentionally narrower than OpenSSH itself:
	     ArkDeck can read only the two software-key formats supported by its
	     typed SSH client. It cannot enumerate ~/.ssh or access config,
	     known_hosts, agent sockets, public keys, or any other home path. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.ssh/id_rsa</string>
		<string>/.ssh/id_ed25519</string>
	</array>
	<!-- The daemon's Unix socket is unreachable from this container: the App
	     Sandbox classifies AF_UNIX connect() as its own operation, so neither
	     network.client nor any file entitlement reaches it (measured against a
	     live daemon, both denied with EPERM). A launchd-vended Mach service is
	     the only transport a sandboxed client can reach, and it needs this
	     exception even when the service name carries the Team ID prefix (also
	     measured: denied without it, allowed with it).

	     The name below must stay identical to ArkDeckAgentXPC.machServiceName
	     and to the LaunchAgent MachServices key. The service it names forwards
	     only the read-only control-plane allowlist, so this entitlement grants
	     the App no way to submit, execute, cancel or import anything. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.arkdeck.agentd</string>
	</array>
</dict>
</plist>
