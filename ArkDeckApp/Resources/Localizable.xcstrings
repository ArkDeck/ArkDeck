    "update.download": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载更新"
          }
        }
      }
    },
    "update.manualInstallDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck only downloads and verifies the DMG. After a separate confirmation it reveals the file in Finder. You must mount the DMG and replace the app manually; ArkDeck does not install, replace itself, update on quit, or claim automatic rollback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck 只下载并验证 DMG。再次确认后仅在 Finder 中显示文件；你需要手动挂载 DMG 并替换应用。ArkDeck 不会安装、自替换、退出时更新，也不承诺自动回滚。"
          }
        }
      }
    },
    "update.privacyDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update checks send only the ArkDeck version, macOS version, and CPU architecture. No device ID, user path, locale, telemetry, cookies, or credentials are sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新检查只发送 ArkDeck 版本、macOS 版本和 CPU 架构；不会发送设备标识、用户路径、区域设置、遥测、Cookie 或凭据。"
          }
        }
      }
    },
    "update.reveal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and Reveal Verified DMG"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认并显示已验证的 DMG"
          }
        }
      }
    },
