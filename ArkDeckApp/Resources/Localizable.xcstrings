    "app.shell.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck"
          }
        }
      }
    },
    "app.toolbar.openSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "app.unavailable.noOperationSubmitted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operation was submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提交任何操作。"
          }
        }
      }
    },
    "app.unavailable.reason": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace is not connected to ArkDeck Runtime in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未将该工作区连接到 ArkDeck Runtime。"
          }
        }
      }
    },
    "device.action.beginWait": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start waiting for authorization"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始等待授权"
          }
        }
      }
    },
    "device.action.recheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测"
          }
        }
      }
    },
    "device.action.rename": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名…"
          }
        }
      }
    },
    "device.action.retryWait": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry: start waiting for authorization"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试：开始等待授权"
          }
        }
      }
    },
    "device.detail.adoptViaCLI": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoption (durable binding) is performed from the CLI: arkdeck device adopt. This App does not submit adoption."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管（建立持久绑定）由 CLI 执行：arkdeck device adopt。本 App 不提交接管操作。"
          }
        }
      }
    },
    "device.detail.factsTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime facts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 事实"
          }
        }
      }
    },
    "device.detail.recheckNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting and re-checking refresh the latest timestamped HDC observation. They send nothing to the device and can be repeated freely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待与重新检测会刷新带时间的最新 HDC 观测；不向设备发送任何内容，可随时重复。"
          }
        }
      }
    },
    "device.detail.statusTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status and actions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态与操作"
          }
        }
      }
    },
    "device.detail.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device authorization — %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备授权 — %@"
          }
        }
      }
    },
    "device.fact.bindingRevision": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binding revision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Binding revision"
          }
        }
      }
    },
    "device.fact.connectKey": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect key"
          }
        }
      }
    },
    "device.fact.firmware": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统版本"
          }
        }
      }
    },
    "device.fact.model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device name / model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称 / 机型"
          }
        }
      }
    },
    "device.fact.observedAt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认时间"
          }
        }
      }
    },
    "device.fact.liveProvenance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device information was read directly over HDC. Unavailable fields use the latest successful observe.device@1 result. This does not change target binding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备信息由 HDC 直接读取；无法读取的字段使用最近一次成功的 observe.device@1 结果。此读取不会更改目标绑定。"
          }
        }
      }
    },
    "device.fact.observedProvenance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed facts come from the most recent succeeded observe.device@1 job — historical evidence, not the device's live state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观测事实来自最近一次成功的 observe.device@1 Job——是历史证据，不是设备此刻的实时状态。"
          }
        }
      }
    },
    "device.fact.state": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告状态"
          }
        }
      }
    },
    "device.fact.stateObservedAt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State observed at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态观测时间"
          }
        }
      }
    },
    "device.fact.target": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopted target"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接管目标"
          }
        }
      }
    },
    "device.fact.transport": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输方式"
          }
        }
      }
    },
    "device.rename.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "device.rename.commit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名"
          }
        }
      }
    },
    "device.rename.field": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称"
          }
        }
      }
    },
    "device.rename.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 1–64 characters. This name is shown only in ArkDeck; it does not change the device identity or binding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 1–64 个字符。此名称仅用于 ArkDeck 中显示，不会修改设备标识或绑定关系。"
          }
        }
      }
    },
    "device.rename.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名设备"
          }
        }
      }
    },
    "device.state.authorizedUnadopted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized · not adopted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权 · 未接管"
          }
        }
      }
    },
    "device.state.needsRecheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status needs re-check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态待重新确认"
          }
        }
      }
    },
    "device.state.needsTrust": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs trust"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要信任"
          }
        }
      }
    },
    "device.state.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线"
          }
        }
      }
    },
    "device.state.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就绪"
          }
        }
      }
    },
    "device.trust.authorizedUnadopted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized. The device is not adopted as a durable target yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权。该设备尚未被接管为持久目标。"
          }
        }
      }
    },
    "device.trust.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device reports Offline. Check the USB connection, then re-check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备报告离线。请检查 USB 连接后重新检测。"
          }
        }
      }
    },
    "device.trust.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized and adopted — this device is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权且已接管——设备就绪。"
          }
        }
      }
    },
    "device.trust.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the device screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁设备屏幕；"
          }
        }
      }
    },
    "device.trust.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the device's \"Trust this computer?\" prompt, choose Trust or Always Trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备弹出的「是否信任此计算机？」中选择 信任 或 始终信任；"
          }
        }
      }
    },
    "device.trust.step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck detects the authorization result automatically: a bounded wait re-reads the device state, with no repeated notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck 将自动检测授权结果：有界等待重复读取设备状态，不反复弹通知。"
          }
        }
      }
    },
    "device.trust.stepsTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上"
          }
        }
      }
    },
    "device.trust.unknownState": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tool reports an unrecognized state: %@. Shown as-is, not interpreted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具报告了未识别的状态：%@。按原文展示，不做解读。"
          }
        }
      }
    },
    "device.trust.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device reports Unauthorized: it has not trusted this computer yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备报告未授权：尚未信任本机。"
          }
        }
      }
    },
    "device.wait.openOverviewRecovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Overview to restart the shared HDC server…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 Overview 重启共享 HDC server…"
          }
        }
      }
    },
    "device.wait.polling": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for on-device confirmation…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待设备端确认…"
          }
        }
      }
    },
    "device.wait.timedOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization timed out. Check the device's USB debugging switch, then retry. If retrying does not help, restarting the shared HDC server is a separate, explicitly confirmed step — it affects DevEco and every connected device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备授权已超时。请检查设备的 USB 调试开关后重试。若重试无效，重启共享 HDC server 是独立且需显式确认的一步——会影响 DevEco 与所有已连接设备。"
          }
        }
      }
    },
    "device.wait.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to check authorization. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查设备授权。%@"
          }
        }
      }
    },
    "hdc.devices.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新设备"
          }
        }
      }
    },
    "history.action.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
