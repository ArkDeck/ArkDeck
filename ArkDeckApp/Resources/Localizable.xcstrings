    "overview.resume.drift.binding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The binding revision has changed since the source run. Its parameters can be prefilled, but the target epoch is not the one that run observed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自来源运行以来 binding revision 已变化。参数可以预填，但目标代次已不是那次运行观测到的。"
          }
        }
      }
    },
    "overview.resume.drift.target": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source run used a different target from the one this page is bound to. Its parameters can be prefilled, but this would not be a repeat of that run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源运行的目标与本页当前绑定的目标不同。参数可以预填，但这不是那一次运行的重复。"
          }
        }
      }
    },
    "overview.resume.drift.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source run's binding revision was not reported, so this cannot state whether the target epoch still matches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源运行未上报 binding revision，因此无法断言目标代次是否仍然一致。"
          }
        }
      }
    },
    "overview.resume.effect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果"
          }
        }
      }
    },
    "overview.resume.effect.unrecorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "unrecorded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录"
          }
        }
      }
