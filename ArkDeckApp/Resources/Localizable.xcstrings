    "overview.record.recent.rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A read-only run can be repeated straight away — its parameters are prefilled in the workspace and the submission still happens there. A mutating or destructive run re-enters its authorization gate every time, and a run whose external effect is unknown is never replayed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "readOnly 可以直接再来一次——参数预填到对应工作区，提交仍在那里发生。deviceMutation / destructive 每次都重新走授权闸；外部效果未知的运行永不重放。"
          }
        }
      }
    },
