    "update.checkNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查"
          }
        }
      }
