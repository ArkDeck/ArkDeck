      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check automatically when ArkDeck starts (at most once every 24 hours)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck 启动时自动检查（每 24 小时最多一次）"
          }
