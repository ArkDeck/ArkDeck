    "overview.resume.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This files a new run under the same thread. ArkDeck does not submit for you — confirming opens the workspace with these parameters prefilled, and you start it there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次将以同一条调试线提交一个新的运行。ArkDeck 不代你提交——确认后在对应工作区预填这些参数，由你按下开始。"
          }
        }
      }
    },
    "overview.resume.gated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run's effect grade is %@, so continuing re-enters that workspace's authorization gate rather than repeating a prefilled request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该次运行的效果分级是 %@，因此继续会重新走该工作区的授权闸，而不是重复一个预填的请求。"
          }
        }
      }
    },
    "overview.resume.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the source run's evidence…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
