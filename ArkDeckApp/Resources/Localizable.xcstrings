{
  "sourceLanguage": "en",
  "strings": {
    "app.devices.gone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device No Longer Listed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已不在候选列表"
          }
        }
      }
    },
    "app.devices.goneDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device left the candidate list — it may be unplugged. Re-check from another row, or reconnect it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备已离开候选列表——可能已拔出。可从其他行重新检测，或重新连接设备。"
          }
        }
      }
    },
    "app.devices.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device list unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备列表不可用"
          }
        }
      }
    },
