    "app.shell.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkDeck"
          }
        }
      }
