    "jobRecovery.archivePending.guidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime is waiting for a safe boundary before the recovery record can finish. This App cannot force the current step to stop."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 正在等待安全边界，之后才能完成恢复记录；此 App 不能强制停止当前步骤。"}}}},
    "jobRecovery.archivePending.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery archive is pending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复归档正在等待"}}}},
    "jobRecovery.humanRequired.guidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review the recorded reason and evidence before continuing through an approved Runtime path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先检查已记录的原因和证据，再通过已批准的 Runtime 路径继续。"}}}},
    "jobRecovery.humanRequired.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Human action is required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要人工处理"}}}},
    "jobRecovery.outcomeUnknown.guidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep the device unchanged when possible. Do not start another device operation until the outstanding effect is reconciled through an approved Runtime path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"条件允许时请保持设备状态不变。在通过已批准的 Runtime 路径核对未决影响前，不要开始其他设备操作。"}}}},
    "jobRecovery.outcomeUnknown.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device effect is unknown"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备影响未知"}}}},
    "jobRecovery.resumeSafe.guidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime recorded a confirmed safe boundary. Review the record before resuming through an approved Runtime path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 已记录确认过的安全边界。请先检查记录，再通过已批准的 Runtime 路径恢复。"}}}},
    "jobRecovery.resumeSafe.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A safe recovery boundary is available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有安全恢复边界"}}}},
    "jobRecovery.waiting.guidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep the current device state unchanged and review the Runtime record for the required recovery step."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请保持设备当前状态不变，并在 Runtime 记录中检查所需的恢复步骤。"}}}},
    "jobRecovery.waiting.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery is waiting"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复正在等待"}}}}
