    "jobInspector.result.supersededByRecovery": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Job's outcome remains unknown, but a later confirmed complete-overwrite recovery established the current target state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Job 的结果仍未知，但后续已确认的完整覆写恢复已建立当前目标状态。"}}}},
    "jobInspector.result.targetAliasResolved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Job's outcome remains unknown, but a later confirmed full Flash proved its target was an alias and established the current device state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Job 的结果仍未知，但后续已确认的完整刷机证明其目标是别名，并建立了当前设备状态。"}}}},
    "jobInspector.result.waitingForHuman": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime stopped at a human-required boundary."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 已停在需要人工处理的边界。"}}}},
