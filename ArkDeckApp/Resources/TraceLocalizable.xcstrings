    "trace.artifacts.contractPublished": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"PUBLISHED"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已发布"}}}},
    "trace.artifacts.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw, filtered, capture log and manifest remain distinct. Contract facts and Runtime-produced metadata are shown separately."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始 Trace、筛选结果、采集日志和清单始终分离；契约事实与 Runtime 实际产物元数据分开展示。"}}}},
    "trace.artifacts.runtimeTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Produced by recent jobs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近期任务实际产物"}}}},
    "trace.artifacts.filteredDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional host-derived filtering; raw bytes must remain unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选的主机派生筛选；原始字节必须保持不变。"}}}},
    "trace.artifacts.filteredRequested": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CreateFileAsset filtering requested locally, but no published output artifact exists."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地已选择 CreateFileAsset 筛选，但尚无已发布输出产物。"}}}},
    "trace.artifacts.logDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tool, phase and validation diagnostics required for a complete Trace session."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完整 Trace Session 所需的工具、阶段和校验诊断。"}}}},
    "trace.artifacts.manifestDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Generic indexes are published; Trace-specific before/after/restored parameters and filter statistics are not exposed by this operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已发布通用索引，但此操作未暴露 Trace 专用的参数前后/恢复值及筛选统计。"}}}},
    "trace.artifacts.nonemptyFormatHash": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Non-empty + recognized format + available checksum"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"非空 + 已识别格式 + 可用校验和"}}}},
    "trace.artifacts.partialFirst": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host partial before publication"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布前先写入主机 partial"}}}},
    "trace.artifacts.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私"}}}},
    "trace.artifacts.rawDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Immutable device bytes; a zero-byte or unrecognized trace cannot succeed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不可变的设备原始字节；零字节或无法识别的 Trace 不能成功。"}}}},
    "trace.artifacts.receive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Receive"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"接收"}}}},
    "trace.artifacts.role.derived": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"derived (rebuildable)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"derived（可重建）"}}}},
    "trace.artifacts.role.log": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"log"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"log"}}}},
    "trace.artifacts.role.manifest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"manifest"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"manifest"}}}},
    "trace.artifacts.role.raw": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"raw (immutable)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"raw（不可变）"}}}},
    "trace.artifacts.sensitive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sensitive, local-first, explicit export"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"敏感、本地优先、显式导出"}}}},
    "trace.artifacts.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Artifact completeness"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"产物完整性"}}}},
    "trace.artifacts.validate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Validation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"校验"}}}},
    "trace.viewer.artifactInvalid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but Runtime did not publish exactly one valid raw trace. Open the Job in History to inspect its Artifacts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集已完成，但 Runtime 未发布唯一且有效的原始 Trace。请在历史记录中打开该 Job 检查产物。"}}}},
    "trace.viewer.artifactListUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but its Artifact list is unavailable. Refresh Runtime and try opening the trace again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集已完成，但产物列表不可用。请刷新 Runtime 后重试打开 Trace。"}}}},
    "trace.viewer.opened": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trace sent to the viewer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Trace 已送入查看器"}}}},
    "trace.viewer.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verifying and opening the captured trace…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在校验并打开已采集的 Trace…"}}}},
    "trace.viewer.readFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but the trace could not be read and verified. Refresh Runtime and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集已完成，但 Trace 无法读取并校验。请刷新 Runtime 后重试。"}}}},
    "trace.viewer.stagingUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but ArkDeck could not create its protected local Trace inbox. Check available storage and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集已完成，但 ArkDeck 无法创建受保护的本地 Trace 收件目录。请检查可用存储空间后重试。"}}}},
    "trace.viewer.tryAgain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try opening trace again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试打开 Trace"}}}},
    "trace.availability.adapter": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Per-device adapter facts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"逐设备 Adapter 事实"}}}},
    "trace.availability.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagnostics operation is available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"诊断操作可用"}}}},
    "trace.availability.categories": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Typed trace categories"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"类型化 Trace 分类"}}}},
    "trace.availability.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking Runtime availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查 Runtime 可用性"}}}},
    "trace.availability.parameters": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Parameter snapshots"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数快照"}}}},
    "trace.availability.probeGap": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App read surface does not expose a target-bound hitrace/bytrace probe, raw help or supported tags. Tool selection and compatibility remain unknown rather than guessed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App 读面未暴露与目标绑定的 hitrace/bytrace probe、原始 help 或已支持 tag。工具选择与兼容性保持未知，不进行猜测。"}}}},
    "trace.availability.raw": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw trace artifact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始 Trace 产物"}}}},
    "trace.availability.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Production capability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生产能力"}}}},
    "trace.availability.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagnostics operation is unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"诊断操作不可用"}}}},
    "trace.blocker.adapter": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A fresh target-bound adapter probe and raw help family are required."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要与当前目标绑定的新鲜 Adapter probe 和原始 help family。"}}}},
    "trace.blocker.buffer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a buffer value inside the published KB range."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入已发布 KB 范围内的 buffer 值。"}}}},
    "trace.blocker.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wait for current Runtime availability facts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待当前 Runtime 可用性事实。"}}}},
    "trace.blocker.duration": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a duration inside the published second range."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入已发布秒数范围内的 duration。"}}}},
    "trace.blocker.noTags": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A capture always carries at least one tag; the current request is empty."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取始终至少带一个 tag；当前请求为空。"}}}},
    "trace.blocker.operation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The production diagnostics operation is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生产诊断操作不可用。"}}}},
    "trace.blocker.parameters": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Typed parameter snapshots and probe dispositions are not available to this App build."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前 App 构建无法获取类型化参数快照和 probe disposition。"}}}},
    "trace.blocker.tags": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Every requested tag is unverified for the selected device and adapter."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有请求 tag 均未针对所选设备和 Adapter 验证。"}}}},
    "trace.blocker.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an adopted target with a complete durable binding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择具有完整持久绑定的已接管目标。"}}}},
    "trace.cancel.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime did not accept cancellation for this App-owned Job."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 未接受对此 App 所属 Job 的取消请求。"}}}},
    "trace.bounds.buffer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trace buffer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Trace Buffer"}}}},
    "trace.bounds.bufferConverged": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The trace buffer converges from the device capability probe; it is not hand-entered."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Trace buffer 按设备能力探测收敛，不接受手输。"}}}},
    "trace.bounds.duration": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Duration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时长"}}}},
    "trace.bounds.maxTags": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Maximum tag count"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最大 tag 数量"}}}},
    "trace.bounds.progressNote": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No reliable byte-total capability receipt is available. A future active capture must show elapsed time with indeterminate progress, never a fabricated percentage or ETA."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前没有可靠的总字节能力回执。未来进行采集时必须显示已用时间和不确定进度，绝不伪造百分比或 ETA。"}}}},
    "trace.bounds.remoteStop": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Typed remote stop"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"类型化远端停止"}}}},
    "trace.bounds.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture bounds and progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集边界与进度"}}}},
    "trace.bounds.total": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Progress mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进度模式"}}}},
    "trace.configuration.custom": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Custom"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义"}}}},
    "trace.configuration.mode": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tag configuration mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Tag 配置模式"}}}},
    "trace.configuration.preset": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preset"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预设"}}}},
    "trace.configuration.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preset and adapter-constrained tags"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预设与 Adapter 约束 Tag"}}}},
    "trace.custom.count": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld tags selected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已选 %lld 个 tag。"}}}},
    "trace.custom.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No device-confirmed tags are available. Custom selection is empty, not an unrestricted text field."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有设备已确认的 tag。自定义选择为空，不会退化为无限制文本框。"}}}},
    "trace.custom.minimumOne": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The last selected tag cannot be removed; a capture always carries one tag."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最后一个已选 tag 不可移除；抓取始终带一个 tag。"}}}},
    "trace.custom.noFreeText": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Custom can select only tags from a fresh adapter probe; arbitrary tag or command text is prohibited."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义只能选择新鲜 Adapter probe 返回的 tag；禁止任意 tag 或命令文本。"}}}},
    "trace.custom.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmed tags"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已确认 Tag"}}}},
    "trace.filter.createFileAsset": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Filter CreateFileAsset chatter into a derived trace"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在派生 Trace 中筛除 CreateFileAsset 噪声"}}}},
    "trace.filter.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Filtering is a host post-process. Header-aware parsing decides what may be removed and records deletion statistics."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选属于主机后处理；由识别 header 的 parser 决定可删除内容并记录删除统计。"}}}},
    "trace.filter.rawImmutable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The raw artifact is immutable. Derived filtering never overwrites it or deletes a fixed number of leading lines."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始产物不可变；派生筛选不会覆盖原始数据，也不会固定删除开头若干行。"}}}},
    "trace.filter.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Derived filtering"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"派生筛选"}}}},
    "trace.jobs.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These diagnostics Jobs are read-only. The App cannot infer their optional Trace leg, stop them, cancel them or resume them."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这些诊断 Job 仅供读取；App 无法推断其可选 Trace leg，也无法停止、取消或恢复。"}}}},
    "trace.jobs.selectionUnknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagnostics job — Trace leg selection unknown"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"诊断 Job — Trace leg 是否选择未知"}}}},
    "trace.jobs.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Related diagnostics Jobs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"相关诊断 Job"}}}},
    "trace.parameters.after": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行后"}}}},
    "trace.parameters.before": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Before"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原值"}}}},
    "trace.parameters.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Snapshots stay typed as missing, unreadable or exact string values. This table shows Not observed because no target-bound snapshot response exists."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快照保持 missing、unreadable 或精确字符串值；由于没有与目标绑定的快照响应，此表显示“未读取”。"}}}},
    "trace.parameters.desired": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile value"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Profile 值"}}}},
    "trace.parameters.mode.persistentChange": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep profile values"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持 Profile 值"}}}},
    "trace.parameters.mode.persistentChange.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires per-parameter persistent-write support and a second explicit confirmation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要逐参数持久写支持和第二次明确确认。"}}}},
    "trace.parameters.mode.temporaryRestore": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apply temporarily and restore"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"临时应用并恢复"}}}},
    "trace.parameters.mode.temporaryRestore.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires exact writable original strings, supported probe receipts and verified readback."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要精确且可写回的原始字符串、支持回执及 readback 验证。"}}}},
    "trace.parameters.mode.unchanged": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Leave parameters unchanged"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数保持不变"}}}},
    "trace.parameters.mode.unchanged.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Do not set or restore any debug parameter."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不设置或恢复任何调试参数。"}}}},
    "trace.parameters.name": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Parameter"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数"}}}},
    "trace.parameters.notChanged": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not applicable (unchanged)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不适用（未修改）"}}}},
    "trace.parameters.notObserved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not observed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未读取"}}}},
    "trace.parameters.missing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Missing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不存在"}}}},
    "trace.parameters.snapshotReady": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime read all nine parameter states from the selected target. This snapshot grants no write authority; mutation and restore remain unavailable until Runtime has verified per-parameter capability and readback."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 已从所选目标读取全部九项参数状态。该快照不授予写权限；在 Runtime 验证逐参数能力与回读前，修改与恢复仍不可用。"}}}},
    "trace.parameters.unreadable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不可读"}}}},
    "trace.parameters.persistConfirm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I understand these debug parameters remain changed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我了解这些调试参数会保持变更"}}}},
    "trace.parameters.persistConfirmDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmation is enabled only after a matching persistent-write capability receipt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅在获得匹配的持久写能力回执后才可确认。"}}}},
    "trace.parameters.rebootTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reboot impact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重启影响"}}}},
    "trace.parameters.rebootUnchanged": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No reboot is requested while parameters remain unchanged. A future parameter mutation must disclose reboot and durable rebind requirements before dispatch."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数保持不变时不会请求重启。未来参数变更必须在派发前说明重启与持久重绑定要求。"}}}},
    "trace.parameters.restore": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Auto restore"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动恢复"}}}},
    "trace.parameters.snapshotGap": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Missing and unreadable are not false or zero. Temporary restore and persistent change stay unavailable until exact snapshots and capability receipts are readable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"missing 与 unreadable 不是 false 或 0。读取到精确快照和能力回执前，临时恢复与持久变更均保持不可用。"}}}},
    "trace.parameters.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Debug parameter snapshot diff"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调试参数快照差异"}}}},
    "trace.preset.arkuiDeep": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkUI deep"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkUI 深度"}}}},
    "trace.preset.attachmentPanorama": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attachment panorama"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"附件全景"}}}},
    "trace.preset.attachmentWarning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This logical preset carries a historical buffer value of 327680 with an unconfirmed unit. The published KB input caps at 65536; no historical value is applied until the current adapter confirms unit and policy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此逻辑预设带有历史 buffer 值 327680，但单位未确认。已发布 KB 输入上限为 65536；当前 Adapter 确认单位和策略前不会应用该历史值。"}}}},
    "trace.preset.io": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I/O"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"I/O"}}}},
    "trace.preset.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Logical preset"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"逻辑预设"}}}},
    "trace.preset.logicalNote": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A preset is a logical request. Only tags proven by the selected device and adapter may become executable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预设是逻辑请求；只有所选设备与 Adapter 证明支持的 tag 才能执行。"}}}},
    "trace.preset.renderAnimation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Render / animation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"渲染 / 动画"}}}},
    "trace.preset.schedulingIpc": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scheduling / IPC"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调度 / IPC"}}}},
    "trace.probe.rawHelp.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No target-bound raw help response. This is unknown capability, not an empty tag list."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有与目标绑定的原始 help 响应；这表示能力未知，不代表 tag 列表为空。"}}}},
    "trace.probe.rawHelp.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw hitrace / bytrace help"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"hitrace / bytrace 原始 help"}}}},
    "trace.progress.cancelDetail": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Published capture cancellation is %1$@. Typed remote-stop support is unverified; stop and cancel controls stay unavailable rather than guessing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已发布采集取消策略为 %1$@。类型化远端停止能力未验证；停止与取消控件保持不可用。"}}}},
    "trace.progress.cancelTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stop and cancellation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"停止与取消"}}}},
    "trace.progress.honestRule": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"During an active capture without reliable total bytes, show an indeterminate indicator and elapsed time. Percentage and ETA remain absent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在采集且没有可靠总字节时，显示不确定进度与已用时间；不显示百分比和 ETA。"}}}},
    "trace.progress.indeterminate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Indeterminate; elapsed time only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不确定；仅显示已用时间"}}}},
    "trace.progress.noActive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No active Trace Job is observable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有可观察的活动 Trace Job"}}}},
    "trace.progress.noActiveDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The complete stage model is shown below as Not started. Related diagnostics jobs cannot be relabeled as Trace without their input facts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下方完整阶段模型均标记为“未开始”；没有输入事实时，不能把相关诊断 Job 重新标记为 Trace。"}}}},
