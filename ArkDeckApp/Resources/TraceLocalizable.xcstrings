    "trace.availability.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查…"}}}},
    "trace.availability.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法抓取"}}}},
    "trace.blocker.adapterUnsupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device's hitrace category list is not supported by this ArkDeck version. Update ArkDeck or use a supported device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前 ArkDeck 版本尚未支持此设备的 hitrace 分类列表。请更新 ArkDeck 或使用已支持的设备。"}}}},
    "trace.blocker.buffer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The default trace buffer is unavailable for this device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前设备不支持默认 Trace 缓冲区。"}}}},
    "trace.blocker.capability": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trace capability check is incomplete for this device. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前设备的 Trace 能力检查尚未完成，请刷新后重试。"}}}},
    "trace.blocker.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wait for the device check to finish."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请等待设备检查完成。"}}}},
    "trace.blocker.duration": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a duration inside the allowed range."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入允许范围内的时长。"}}}},
    "trace.blocker.noTags": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a capture profile."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择抓取场景。"}}}},
    "trace.blocker.operation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trace capture is unavailable. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Trace 抓取暂不可用，请刷新后重试。"}}}},
    "trace.blocker.tags": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This profile is not supported by the selected device. Choose another profile."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选设备不支持这个抓取场景，请选择其他场景。"}}}},
    "trace.blocker.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an adopted device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择已接管的设备。"}}}},
    "trace.bounds.duration": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Duration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时长"}}}},
    "trace.cancel.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to cancel this capture. Wait for the current safe step to finish and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法取消此次抓取。请等待当前安全步骤结束后重试。"}}}},
    "trace.capture.device": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备"}}}},
    "trace.capture.finished": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture complete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取完成。"}}}},
    "trace.capture.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The trace stays on this Mac and opens automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Trace 只保存在这台 Mac，并会在完成后自动打开。"}}}},
    "trace.capture.notCompleted": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture ended without a viewable trace. Open History for details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取已结束，但没有可查看的 Trace。请打开历史记录了解详情。"}}}},
    "trace.capture.outcomeUnknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture outcome is unknown. Check History before starting another capture."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取结果未知。再次抓取前请先查看历史记录。"}}}},
