    "trace.duration.quick": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick duration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快捷时长"}}}},
    "trace.duration.seconds": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Seconds"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"秒"}}}},
    "trace.duration.set10Seconds": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 10 seconds"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 10 秒"}}}},
    "trace.duration.set15Seconds": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 15 seconds"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 15 秒"}}}},
    "trace.duration.set1Minute": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 1 minute"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 1 分钟"}}}},
    "trace.duration.set2Minutes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 2 minutes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 2 分钟"}}}},
    "trace.duration.set30Seconds": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 30 seconds"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 30 秒"}}}},
    "trace.duration.set3Minutes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 3 minutes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 3 分钟"}}}},
    "trace.duration.set5Seconds": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set duration to 5 seconds"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将时长设为 5 秒"}}}},
    "trace.duration.setCustom": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set a custom duration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置自定义时长"}}}},
    "trace.duration.unit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Duration unit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时长单位"}}}},
    "trace.preset.arkuiDeep": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App responsiveness"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用响应"}}}},
    "trace.preset.arkuiDeep.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Best for slow interactions, layout work and ArkUI jank."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"适合分析交互迟缓、布局耗时和 ArkUI 卡顿。"}}}},
    "trace.preset.attachmentPanorama": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System overview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统概览"}}}},
    "trace.preset.attachmentPanorama.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Captures the broadest system activity and produces the largest trace."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"覆盖最广的系统活动，生成的 Trace 也最大。"}}}},
    "trace.preset.io": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I/O"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"I/O"}}}},
    "trace.preset.io.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Best for file, storage and work-queue investigations."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"适合分析文件、存储和工作队列问题。"}}}},
    "trace.preset.renderAnimation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rendering and animation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"渲染与动画"}}}},
    "trace.preset.renderAnimation.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Best for frame production, graphics and animation issues."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"适合分析出帧、图形和动画问题。"}}}},
    "trace.preset.schedulingIpc": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CPU scheduling"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CPU 调度"}}}},
    "trace.preset.schedulingIpc.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Best for thread scheduling, contention and IPC investigations."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"适合分析线程调度、资源争用和 IPC 问题。"}}}},
    "trace.target.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No adopted devices. Connect and adopt a device, then refresh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有已接管的设备。请连接并接管设备，然后刷新。"}}}},
    "trace.validation.decimal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use whole numbers only."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只能输入整数。"}}}},
    "trace.validation.missing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a duration."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入抓取时长。"}}}},
    "trace.validation.range": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a value from %1$d through %2$d."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 %1$d 到 %2$d 之间的值。"}}}},
    "trace.viewer.artifactInvalid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but no valid raw trace was published. Open History to inspect the job."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取已完成，但没有发布有效的原始 Trace。请打开历史记录检查任务。"}}}},
    "trace.viewer.artifactListUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but its trace is unavailable. Refresh and try opening it again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取已完成，但 Trace 暂不可用。请刷新后重试。"}}}},
    "trace.viewer.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open a local trace or choose a recent trace in the viewer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在查看器中打开本地 Trace，或继续查看最近的 Trace。"}}}},
    "trace.viewer.latest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest captured trace is ready"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最新抓取的 Trace 已就绪"}}}},
    "trace.viewer.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verifying and opening the captured trace…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在校验并打开抓取的 Trace…"}}}},
    "trace.viewer.readFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture completed, but the trace could not be read. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抓取已完成，但无法读取 Trace。请刷新后重试。"}}}},
    "trace.viewer.stagingUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to prepare the trace for viewing. Check available storage and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备要查看的 Trace。请检查可用存储空间后重试。"}}}},
    "trace.viewer.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"View traces"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看 Trace"}}}},
    "trace.viewer.tryAgain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try opening trace again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试打开 Trace"}}}},
    "trace.workspace.summary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture a trace from an adopted OpenHarmony device, then inspect it in the built-in viewer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从已接管的 OpenHarmony 设备抓取 Trace，然后在内置查看器中分析。"}}}}
  },
  "version": "1.0"
}
