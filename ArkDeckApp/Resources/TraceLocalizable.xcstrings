    "trace.artifacts.cleanup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remote cleanup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"远端清理"}}}},
    "trace.artifacts.cleanupAfterPublish": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only after verified atomic publication"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅在验证并原子发布后"}}}},
