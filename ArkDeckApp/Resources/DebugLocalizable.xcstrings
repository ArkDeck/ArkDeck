    "debug.blocked.bufferOperation":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No published Runtime operation exposes device buffer mutation. Normal capture never clears, resizes, or flushes it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前没有已发布 Runtime operation 提供设备 buffer 变更；普通采集绝不会清空、扩容或 flush。"}}}},
    "debug.blocked.commandOperation":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"These approved action IDs are discoverable, but no published Runtime operation exposes a generic one-shot command request to the App."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这些 approved action ID 可供查看，但当前没有已发布 Runtime operation 向 App 开放通用一次性命令请求。"}}}},
    "debug.blocked.forwardOperation":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No published Runtime operation lists, creates, or removes HDC forward/reverse rules. Validation remains local and dispatch count stays zero."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前没有已发布 Runtime operation 用于列出、新建或删除 HDC forward/reverse 规则；校验仅在本地进行，dispatch 数保持为零。"}}}},
    "debug.blocked.hapImport":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App transport cannot import a HAP or obtain an Artifact lease, and it exposes no job submission method."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App 通道无法导入 HAP、获取 Artifact lease，也没有 job 提交方法。"}}}},
    "debug.blocked.readOnlyTransport":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App transport can read availability, targets, and jobs only; it cannot submit this capture."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App 通道只能读取可用性、目标设备与 Job，无法提交本次采集。"}}}},
