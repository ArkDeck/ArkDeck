    "debug.apps.identity.note":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Names are validated against the Catalog schema; they are never interpreted as arguments."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"名称按 Catalog schema 校验，绝不会被解释为命令参数。"}}}},
