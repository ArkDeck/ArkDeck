    "debug.apps.mutationDetail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install, start, stop, uninstall, and remote staging are device mutations. Every dispatch must bind the durable target revision and consume matching authority."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装、启动、停止、卸载与远端暂存均为设备变更。每次 dispatch 必须绑定持久设备 revision 并消费匹配授权。"}}}},
    "debug.apps.mutationScope":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device mutation scope is explicit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备变更影响范围明确可见"}}}},
