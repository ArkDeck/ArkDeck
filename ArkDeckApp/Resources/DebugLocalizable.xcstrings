{
  "sourceLanguage" : "en",
  "strings" : {
    "debug.apps.runningCleanupHint":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall after run removes the app, so it cannot stay running. Choose Retain installed app to keep observing it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"运行后卸载会移除应用，无法保持运行。要继续观察应用，请选择“保留已安装应用”。"}}}},
    "debug.apps.selection.duplicatePackage":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each package can be selected only once. Remove the duplicate selection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同一个安装包只能选择一次，请移除重复选择。"}}}},
    "debug.apps.selection.tooManyPackages":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose at most 16 additional packages."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"附加安装包最多可选 16 个。"}}}},
    "debug.apps.selection.invalidAdditional":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose .hap or .hsp files with basenames containing letters, numbers, dots, underscores or hyphens."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择 .hap 或 .hsp 文件，文件名仅含字母、数字、点、下划线或连字符。"}}}},
    "debug.apps.selection.invalidEntry":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose one entry .hap. Use a basename with letters, numbers, dots, underscores or hyphens."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择一个 .hap 入口包，文件名仅含字母、数字、点、下划线或连字符。"}}}},
    "debug.apps.clearSelection":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear package selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清空安装包选择"}}}},
    "debug.apps.additional.removeNamed":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除 %@"}}}},
    "debug.apps.additional.remove":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除"}}}},
    "debug.apps.additional.add":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add HAP / HSP…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 HAP / HSP…"}}}},
    "debug.apps.additional.note":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the entry HAP first. Add up to 16 feature HAPs or HSPs from the same bundle; all packages are installed together. Each file must be 1 byte–64 MiB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先选择入口 HAP，再添加同一 Bundle 的 feature HAP 或 HSP，最多 16 个，所有包一起安装。每个文件为 1 字节至 64 MiB。"}}}},
    "debug.apps.additional.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Additional packages (optional)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"附加安装包（可选）"}}}},
    "debug.action.cancel":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stop after the current step"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前步骤后停止"}}}},
    "debug.action.refresh":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh Debug facts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新调试信息"}}}},
    "debug.artifacts.abi":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Artifact ABI"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"产物 ABI"}}}},
    "debug.artifacts.abi.observed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read from the signed ELF during validation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"校验时从已签名 ELF 自动读取"}}}},
    "debug.artifacts.advanced":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Required verification and rollback"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"必需的验证与回滚"}}}},
    "debug.artifacts.bundle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Target bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标 Bundle"}}}},
    "debug.artifacts.bundleInvalid":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a dotted bundle name such as com.example.app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 com.example.app 形式的 Bundle 名称。"}}}},
    "debug.artifacts.chooseLibrary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose local .so…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择本地 .so…"}}}},
    "debug.artifacts.destination.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Name the owning app and library. Runtime derives the app-owned device destination from the published profile; this page never accepts a remote path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"填写所属应用与动态库名称。Runtime 根据已发布 profile 推导 app-owned 设备目标位置；此页面不接受远端路径。"}}}},
    "debug.artifacts.destination.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deployment target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部署目标"}}}},
    "debug.artifacts.logicalName":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Library name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"动态库名称"}}}},
    "debug.artifacts.logicalNameInvalid":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a lib<name>.so filename with no directory components."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入不含目录的 lib<name>.so 文件名。"}}}},
    "debug.artifacts.noLibrary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No local library selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未选择本地动态库"}}}},
    "debug.artifacts.notVerified":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deployment did not reach verified completion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部署未达到验证完成状态"}}}},
    "debug.artifacts.openLogs":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture logs to verify"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"获取日志并验证"}}}},
    "debug.artifacts.planReady":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime plan is ready for review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 计划已可检查"}}}},
    "debug.artifacts.policy.required":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Native Debug path always verifies the published hash, restarted process, and loaded-library maps. Any failed verification automatically restores and re-verifies the previous library."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Native Debug 路径始终验证发布 hash、重启后的进程与动态库加载 maps；任一验证失败都会自动恢复并复验旧动态库。"}}}},
    "debug.artifacts.preparing":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Validating the signed ELF and materializing the Runtime plan…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在校验已签名 ELF 并生成 Runtime 计划…"}}}},
    "debug.artifacts.preview":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Validate and review plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"校验并检查替换计划"}}}},
    "debug.artifacts.productionBoundary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Production supports one signed app-owned .so per request from either a local file or a verified read-only SSH build source. Every request still passes ELF/ABI/Build ID/hash validation, backup, atomic publish, Ability restart, loaded-library readback, and rollback on failure. SMB, WSL, batches, .abc replacement, and standalone device restart remain unavailable until published as typed behavior."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前生产能力每次支持一个本地文件或已验证只读 SSH 构建源中的已签名 app-owned .so；两种来源都执行 ELF / ABI / Build ID / hash 校验、备份、原子发布、Ability 重启、加载 readback 与失败回滚。SMB、WSL、批量、.abc 替换和独立设备重启在对应 typed behavior 发布前保持不可用。"}}}},
    "debug.artifacts.reopenPlan":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review prepared plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查已准备计划"}}}},
    "debug.artifacts.results.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Publish and verification Artifacts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布与验证 Artifact"}}}},
    "debug.artifacts.review.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Validation must complete before the plan can be submitted. The reviewed plan digest pins the exact target, binding, Artifact lease, inputs, and step sequence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"校验完成后才能提交计划。已检查的 plan digest 会固定精确 target、binding、Artifact lease、输入和步骤序列。"}}}},
    "debug.artifacts.review.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and run"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查并运行"}}}},
    "debug.artifacts.rollback":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rollback policy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"回滚策略"}}}},
    "debug.artifacts.rollback.auto":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore and verify the previous library on failure"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败时恢复并复验旧动态库"}}}},
    "debug.artifacts.running":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime is deploying and verifying the library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 正在部署并验证动态库"}}}},
    "debug.artifacts.running.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for the next durable Runtime stage."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在等待下一个持久化 Runtime 阶段。"}}}},
    "debug.artifacts.selectedLibrary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已选动态库"}}}},
    "debug.artifacts.sheet.back":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回选择"}}}},
    "debug.artifacts.sheet.bundle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Owning bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所属 Bundle"}}}},
    "debug.artifacts.sheet.digest":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan digest"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Plan digest"}}}},
    "debug.artifacts.sheet.library":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"动态库"}}}},
    "debug.artifacts.sheet.rollback":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Failure handling"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败处理"}}}},
    "debug.artifacts.sheet.run":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back up, replace, restart, and verify"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份、替换、重启并验证"}}}},
    "debug.artifacts.sheet.steps":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Materialized steps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已生成步骤"}}}},
    "debug.artifacts.sheet.target":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精确目标设备"}}}},
    "debug.artifacts.sheet.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review replacement plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查替换计划"}}}},
    "debug.artifacts.sheet.verification":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Required verification"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"必需验证"}}}},
    "debug.artifacts.sheet.warning":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"ABI and signature validation block incompatible input before device writes. Runtime backs up the current library, publishes atomically, restarts the owning Ability, and requires loaded-library maps. Any failed verification automatically restores and re-verifies the previous library."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ABI 与签名校验会在设备写入前阻止不兼容输入。Runtime 随后备份当前动态库、原子发布、重启所属 Ability，并要求动态库加载 maps；任一验证失败都会自动恢复并复验旧动态库。"}}}},
    "debug.artifacts.source.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose one signed app-owned native library from a local output or a verified remote build source. Only the selected bytes enter the controlled Artifact import channel."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从本地输出或已验证的远端构建源中选择一个已签名的 app-owned 动态库；只有所选文件字节会进入受控 Artifact 导入通道。"}}}},
    "debug.artifacts.source.kind":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Build source"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"构建来源"}}}},
    "debug.artifacts.source.local":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local file"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地文件"}}}},
    "debug.artifacts.source.remote":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remote server"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"远端服务器"}}}},
    "debug.artifacts.source.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Build Artifact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编译产物"}}}},
    "debug.artifacts.sourceBoundary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH sources are read-only, host-key pinned, and confined to the saved canonical build root. SMB, WSL, batch selection, and .abc search remain unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SSH 构建源为只读能力，固定主机密钥并限制在已保存的真实编译根目录内。SMB、WSL、批量选择与 .abc 搜索仍未开放。"}}}},
    "debug.artifacts.browseRemote":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Browse remote .so…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"浏览远端 .so…"}}}},
    "debug.artifacts.remoteBrowser.cancel":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "debug.artifacts.remoteBrowser.choose":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use selected library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用所选动态库"}}}},
    "debug.artifacts.remoteBrowser.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Browse folders below the verified build root. Only lib*.so files are shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"浏览已验证编译根目录以内的文件夹；这里只显示 lib*.so 文件。"}}}},
