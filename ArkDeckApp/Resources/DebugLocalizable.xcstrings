    "debug.failure.executionFailed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Execution failed. Review this Job’s artifacts and diagnostics."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行失败。请检查此 Job 的 Artifact 和诊断信息。"}}}},
    "debug.failure.executionConfirmedNotPerformed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The operation did not run. Runtime proof is required before another request."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作未执行。提交另一个请求前必须取得 Runtime 证明。"}}}},
    "debug.failure.artifactPublicationFailed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime could not publish an execution artifact. Review the Job details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 无法发布执行 Artifact。请检查 Job 详情。"}}}},
    "debug.failure.artifactFinalizationFailed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime could not finalize all artifacts. Review the Job details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 无法完成全部 Artifact。请检查 Job 详情。"}}}},
