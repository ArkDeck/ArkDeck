    "debug.apps.localOnly":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App checks and imports every package in bounded chunks before submitting one Job. Local paths never cross into Runtime."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App 会先逐个校验并分块导入所有安装包，再提交一个 Job。本地路径不会进入 Runtime。"}}}},
    "debug.apps.importing":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking and importing packages…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在校验并导入安装包…"}}}},
