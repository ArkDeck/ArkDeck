    "debug.artifacts.remoteBrowser.empty.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add and verify an SSH server in Settings > Servers first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先在“设置 > 服务器”中添加并验证 SSH 服务器。"}}}},
    "debug.artifacts.remoteBrowser.empty.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No remote servers"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未配置远端服务器"}}}},
