    "debug.artifacts.remoteBrowser.noArtifacts":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No folders or native libraries here"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此处没有文件夹或动态库"}}}},
    "debug.artifacts.remoteBrowser.openSettings":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Server Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开服务器设置"}}}},
    "debug.artifacts.remoteBrowser.refresh":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh directory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新目录"}}}},
