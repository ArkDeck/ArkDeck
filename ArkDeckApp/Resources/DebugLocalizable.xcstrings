    "debug.failure.outcomeUnknown":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The device effect is unknown. Keep the device unchanged while Runtime reconciles it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备影响未知。Runtime 核对期间请保持设备状态不变。"}}}},
    "debug.failure.cancelled":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The operation stopped at a safe boundary."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作已在安全边界停止。"}}}},
