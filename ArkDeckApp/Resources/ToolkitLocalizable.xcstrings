{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "toolkit.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A still, not a live view. Each gesture is one typed operation; an unknown outcome is never resent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是静止画面，不是实时预览。每个手势都是一次 typed operation；结果未知时绝不重发。"
          }
        }
      }
    },
    "toolkit.frame.age": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture taken"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面拍摄于"
          }
        }
      }
    },
    "toolkit.frame.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无画面"
          }
        }
      }
    },
    "toolkit.frame.unknownAge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture age unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面年龄未知"
          }
        }
      }
    },
    "toolkit.gesture.longPress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long press"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按"
          }
        }
      }
    },
    "toolkit.gesture.swipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动"
          }
        }
      }
    },
    "toolkit.gesture.tap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击"
          }
        }
      }
    },
    "toolkit.gestures.longPress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for half a second to send a long press."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住半秒以上，发送一次长按。"
          }
        }
      }
    },
    "toolkit.gestures.swipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to send a swipe; the time you held it is the swipe's duration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动发送一次滑动；你按住的时长就是滑动时长。"
          }
        }
      }
    },
    "toolkit.gestures.tap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the picture to send a tap at that point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击画面，在该点发送一次点击。"
          }
        }
      }
    },
    "toolkit.gestures.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How input works"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作方式"
          }
        }
      }
    },
    "toolkit.log.captureFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图失败"
          }
        }
      }
    },
    "toolkit.log.captured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot captured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已获取截图"
          }
        }
      }
    },
    "toolkit.log.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认"
          }
        }
      }
    },
    "toolkit.log.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing sent yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未发送任何操作。"
          }
        }
      }
    },
    "toolkit.log.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败"
          }
        }
      }
    },
    "toolkit.log.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation log"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作记录"
          }
        }
      }
    },
    "toolkit.log.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "outcome unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知"
          }
        }
      }
    },
    "toolkit.screen.capture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取截图"
          }
        }
      }
    },
    "toolkit.screen.capturing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取截图…"
          }
        }
      }
    },
    "toolkit.screen.empty.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopt exactly one device to use Toolkit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管且仅接管一台设备后才能使用真机操作。"
          }
        }
      }
    },
    "toolkit.screen.empty.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a screenshot to act on the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取一张截图后即可在其上操作设备。"
          }
        }
      }
    },
    "toolkit.screen.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screenshot yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未获取截图"
          }
        }
      }
    },
    "toolkit.stale.badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期"
          }
        }
      }
    },
    "toolkit.stale.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent — this picture is out of date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送——这张画面已经过期"
          }
        }
      }
    },
    "toolkit.stale.refused.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last gesture changed the device. Get a new screenshot before pressing again; a point picked on this one no longer means what it did."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一个手势已经改变了设备。再点之前先取一张新截图——在这张图上选的位置，已经不是它原来指的东西了。"
          }
        }
      }
    },
    "toolkit.target.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无设备"
          }
        }
      }
    },
    "toolkit.target.none.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolkit sends device mutations and will not guess which device you meant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真机操作会写设备，因此不会替你猜是哪一台。"
          }
        }
      }
    }
  }
}
