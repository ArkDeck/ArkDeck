{
  "sourceLanguage": "en",
  "strings": {
    "diagnostics.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断"
          }
        }
      }
    },
    "diagnostics.session.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No session open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无诊断会话"
          }
        }
      }
    },
    "diagnostics.session.none.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm a capture, work the device, then mark what you saw."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先布防一次采集，在设备上复现，然后标记你看到的东西。"
          }
        }
      }
    },
    "diagnostics.alignment.sameClock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一时钟"
          }
        }
      }
    },
    "diagnostics.alignment.calibrated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已校准"
          }
        }
      }
    },
    "diagnostics.alignment.cannotAlign": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot align"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法对齐"
          }
        }
      }
    },
    "diagnostics.alignment.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks are host time. Without a calibration nothing here can be lined up against what the device recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记走的是主机时间。没有校准，这里的任何东西都无法与设备记录的内容对齐。"
          }
        }
      }
    },
    "diagnostics.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不完整"
          }
        }
      }
    },
    "diagnostics.partial.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is missing a product it declared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次会话缺少它自己声明过的产物。"
          }
        }
      }
    },
    "diagnostics.marks.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记"
          }
        }
      }
    },
    "diagnostics.marks.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was marked in this session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次会话没有任何标记。"
          }
        }
      }
    },
    "diagnostics.mark.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动标记"
          }
        }
      }
    },
    "diagnostics.mark.auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动标记"
          }
        }
      }
    },
    "diagnostics.shot.takenAfter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "taken after the mark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄于标记之后"
          }
        }
      }
    },
    "diagnostics.shot.standsFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot stands for the moment it was taken, not the moment it was asked for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图只代表拍摄时刻，不代表标记时刻的画面。"
          }
        }
      }
    },
    "diagnostics.shot.tooFar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture proves this moment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一时刻没有可证明对应的画面"
          }
        }
      }
    },
    "diagnostics.shot.tooFar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nearest screenshot is too far from this mark to stand for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的一张截图距这个标记太远，不能代表它。"
          }
        }
      }
    },
    "diagnostics.shot.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图失败"
          }
        }
      }
    },
    "diagnostics.shot.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screenshot was taken here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处未拍摄截图"
          }
        }
      }
    },
    "diagnostics.notDerived.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not looked for"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查的种类"
          }
        }
      }
    },
    "diagnostics.notDerived.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These marker kinds were never derived, so their absence says nothing about the run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些标记种类从未被反推，所以它们的缺席不说明这次运行发生了什么。"
          }
        }
      }
    },
    "diagnostics.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing products"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失的产物"
          }
        }
      }
    },
    "diagnostics.selection.timeOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a time point is selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅选择了时间点"
          }
        }
      }
    },
    "diagnostics.selection.driftedAway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the cursor has left this event"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标已离开该事件"
          }
        }
      }
    },
    "diagnostics.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another session holds this device. A capture and a gesture cannot share it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备正被另一个会话持有。采集与手势不能共用同一台设备。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
