{
  "sourceLanguage": "en",
  "strings": {
    "diagnostics.capture.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session capture is not available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断会话采集尚不可用"
          }
        }
      }
    },
    "diagnostics.capture.unavailable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive arm, append-marker and stop controls are not connected. Open a saved bounded capture from History, or use Trace and Debug › Logs to capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交互式布防、追加标记和停止尚未接通。可从 History 打开已保存的有界采集，或使用 Trace 与 Debug › Logs 采集。"
          }
        }
      }
    },
    "diagnostics.alignment.calibrated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已校准"
          }
        }
      }
    },
    "diagnostics.alignment.cannotAlign": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot align"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法对齐"
          }
        }
      }
    },
    "diagnostics.alignment.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks are host time. Without a calibration nothing here can be lined up against what the device recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记走的是主机时间。没有校准，这里的任何东西都无法与设备记录的内容对齐。"
          }
        }
      }
    },
    "diagnostics.alignment.sameClock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一时钟"
          }
        }
      }
    },
    "diagnostics.capture.arm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm a session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布防会话"
          }
        }
      }
    },
    "diagnostics.capture.mark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark (⌘M)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打标记（⌘M）"
          }
        }
      }
    },
    "diagnostics.mark.auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动标记"
          }
        }
      }
    },
    "diagnostics.mark.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动标记"
          }
        }
      }
    },
    "diagnostics.marks.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was marked in this session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次会话没有任何标记。"
          }
        }
      }
    },
    "diagnostics.marks.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记"
          }
        }
      }
    },
    "diagnostics.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing products"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失的产物"
          }
        }
      }
    },
    "diagnostics.notDerived.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These marker kinds were never derived, so their absence says nothing about the run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些标记种类从未被反推，所以它们的缺席不说明这次运行发生了什么。"
          }
        }
      }
    },
    "diagnostics.notDerived.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not looked for"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查的种类"
          }
        }
      }
    },
    "diagnostics.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不完整"
          }
        }
      }
    },
    "diagnostics.partial.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is missing a product it declared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次会话缺少它自己声明过的产物。"
          }
        }
      }
    },
    "diagnostics.selection.driftedAway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the cursor has left this event"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标已离开该事件"
          }
        }
      }
    },
    "diagnostics.selection.timeOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a time point is selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅选择了时间点"
          }
        }
      }
    },
    "diagnostics.session.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No session open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无诊断会话"
          }
        }
      }
    },
    "diagnostics.session.none.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a capture.diagnostics Job from History to read its verified artifacts. No connected device is needed to read a saved capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 History 打开 capture.diagnostics 记录，读取校验后的产物。读取已保存的采集无需连接设备。"
          }
        }
      }
    },
    "diagnostics.shot.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图失败"
          }
        }
      }
    },
    "diagnostics.shot.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screenshot was taken here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处未拍摄截图"
          }
        }
      }
    },
    "diagnostics.shot.standsFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot stands for the moment it was taken, not the moment it was asked for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图只代表拍摄时刻，不代表标记时刻的画面。"
          }
        }
      }
    },
    "diagnostics.shot.takenAfter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "taken after the mark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄于标记之后"
          }
        }
      }
    },
    "diagnostics.shot.tooFar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture proves this moment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一时刻没有可证明对应的画面"
          }
        }
      }
    },
    "diagnostics.shot.tooFar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nearest screenshot is too far from this mark to stand for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的一张截图距这个标记太远，不能代表它。"
          }
        }
      }
    },
    "diagnostics.shot.undecidable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here can tell"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处无法判定"
          }
        }
      }
    },
    "diagnostics.shot.undecidable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot was taken around this mark, but the interval it could have been taken in is wider than the tolerance, so it cannot be said to be this moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个标记附近确有一张截图，但它可能被拍摄的时间区间宽于容差，因此无法断定它就是这一时刻。"
          }
        }
      }
    },
    "diagnostics.session.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading session artifacts…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取会话产物…"
          }
        }
      }
    },
    "diagnostics.session.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read this session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此会话"
          }
        }
      }
    },
    "diagnostics.session.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry reading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取"
          }
        }
      }
    },
    "diagnostics.session.reload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载会话"
          }
        }
      }
    },
    "diagnostics.session.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved capture · read only. Viewing does not start a new Job."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的采集 · 只读。查看不会启动新 Job。"
          }
        }
      }
    },
    "diagnostics.session.timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime timeline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 时间线"
          }
        }
      }
    },
    "diagnostics.ring.covered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime found the coverage anchor in the ring snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 已在环形快照中找到覆盖锚点。"
          }
        }
      }
    },
    "diagnostics.ring.lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring snapshot lost its coverage anchor. Earlier events may be missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环形快照未保留覆盖锚点，较早事件可能缺失。"
          }
        }
      }
    },
    "diagnostics.artifacts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session artifacts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话产物"
          }
        }
      }
    },
    "diagnostics.artifacts.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text previews stay in this App. Sensitive content is read only when you select it; nothing is exported or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本预览仅留在此 App。敏感内容仅在选择后读取，不会导出或上传。"
          }
        }
      }
    },
    "diagnostics.artifacts.read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read locally"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机读取"
          }
        }
      }
    },
    "diagnostics.artifacts.readSensitive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read sensitive content locally"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机读取敏感内容"
          }
        }
      }
    },
    "diagnostics.artifacts.openElsewhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A published Trace can open in Trace Viewer. Other files can be exported explicitly from History. Job times are never used as screenshot timestamps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布的 Trace 可在 Trace Viewer 打开；其他文件可从 History 显式导出。不会使用 Job 时间推算截图时刻。"
          }
        }
      }
    },
    "diagnostics.preview.clipped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview shows the first 120,000 characters. Export the artifact from History to read the complete file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览显示前 120,000 个字符。可从 History 导出产物以读取完整文件。"
          }
        }
      }
    },
    "diagnostics.mark.timeMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time not reported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录时刻"
          }
        }
      }
    },
    "diagnostics.artifacts.openTrace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open sensitive Trace in Viewer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Viewer 中打开敏感 Trace"
          }
        }
      }
    },
    "diagnostics.artifacts.openTrace.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the selected Job’s immutable Trace into the local viewer cache. No upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选 Job 的不可变 Trace 读取到本机查看器缓存，不上传。"
          }
        }
      }
    },
    "diagnostics.preview.replacedInvalidUTF8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some bytes are not valid UTF-8 and appear as � in this preview. The original Artifact and its SHA-256 are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分字节不是有效 UTF-8，在此预览中显示为 �。原始 Artifact 及其 SHA-256 未改变。"
          }
        }
      }
    },
    "diagnostics.preview.invalidStructuredText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This structured text is not valid UTF-8. Inspect or export the original Artifact from History."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份结构化文本不是有效 UTF-8。请在 History 中检查或导出原始 Artifact。"
          }
        }
      }
    },
    "diagnostics.hilog.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HiLog summary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HiLog 摘要"
          }
        }
      }
    },
    "diagnostics.hilog.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to verify the HiLog summary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核验 HiLog 摘要"
          }
        }
      }
    },
    "diagnostics.hilog.failed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to History to inspect this Job and its Artifacts. Reload to try reading the same record again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回 History 检查此 Job 与 Artifact；重新加载只会重读同一记录。"
          }
        }
      }
    },
    "diagnostics.hilog.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only view of the saved summary. Opening or reloading it does not run another analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读查看已保存的摘要。打开或重新加载不会再次执行分析。"
          }
        }
      }
    },
    "diagnostics.hilog.coverage.complete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All nonblank line headers recognized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部非空行的行首已识别"
          }
        }
      }
    },
    "diagnostics.hilog.coverage.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some line headers unrecognized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分行首未识别"
          }
        }
      }
