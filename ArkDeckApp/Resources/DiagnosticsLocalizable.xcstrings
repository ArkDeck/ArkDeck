{
  "sourceLanguage": "en",
  "strings": {
    "diagnostics.capture.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session capture is not available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断会话采集尚不可用"
          }
        }
      }
    },
    "diagnostics.capture.unavailable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive arm, append-marker and stop controls are not connected. Open a saved bounded capture from History, or use Trace and Debug › Logs to capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交互式布防、追加标记和停止尚未接通。可从 History 打开已保存的有界采集，或使用 Trace 与 Debug › Logs 采集。"
          }
        }
      }
    },
    "diagnostics.alignment.calibrated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已校准"
          }
        }
      }
    },
    "diagnostics.alignment.cannotAlign": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot align"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法对齐"
          }
        }
      }
    },
    "diagnostics.alignment.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks are host time. Without a calibration nothing here can be lined up against what the device recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记走的是主机时间。没有校准，这里的任何东西都无法与设备记录的内容对齐。"
          }
        }
      }
    },
    "diagnostics.alignment.sameClock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一时钟"
          }
        }
      }
    },
    "diagnostics.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another session holds this device. A capture and a gesture cannot share it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备正被另一个会话持有。采集与手势不能共用同一台设备。"
          }
        }
      }
    },
    "diagnostics.busy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another session holds it. The request was refused rather than queued behind that session, so nothing of yours has run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它被另一个会话持有。你的请求被拒绝了，而不是排在那个会话后面——所以你的操作一件都没有执行。"
          }
        }
      }
    },
    "diagnostics.busy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is busy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备正忙"
          }
        }
      }
    },
    "diagnostics.capture.arm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm a session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布防会话"
          }
        }
      }
    },
    "diagnostics.capture.armed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Armed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已布防"
          }
        }
      }
    },
    "diagnostics.capture.armed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring is holding. Reproduce the problem, then mark it — the run-up is already kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环形缓冲正在持有。去复现问题，然后打标——之前发生的事已经留下了。"
          }
        }
      }
    },
    "diagnostics.capture.arming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arming…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布防中…"
          }
        }
      }
    },
    "diagnostics.capture.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集失败"
          }
        }
      }
    },
    "diagnostics.capture.mark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark (⌘M)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打标记（⌘M）"
          }
        }
      }
    },
    "diagnostics.capture.markAndShoot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark and screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打标记并截图"
          }
        }
      }
    },
    "diagnostics.capture.markIsHostTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mark records a host instant and touches nothing on the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记只记录一个主机时刻，不碰设备上的任何东西。"
          }
        }
      }
    },
    "diagnostics.capture.marks.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "marks so far"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打标记"
          }
        }
      }
    },
    "diagnostics.capture.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopt one device to capture from"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先纳管一台设备再采集"
          }
        }
      }
    },
    "diagnostics.capture.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并查看"
          }
        }
      }
    },
    "diagnostics.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集"
          }
        }
      }
    },
    "diagnostics.mark.auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动标记"
          }
        }
      }
    },
    "diagnostics.mark.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动标记"
          }
        }
      }
    },
    "diagnostics.marks.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was marked in this session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次会话没有任何标记。"
          }
        }
      }
    },
    "diagnostics.marks.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记"
          }
        }
      }
    },
    "diagnostics.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing products"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失的产物"
          }
        }
      }
    },
    "diagnostics.notDerived.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These marker kinds were never derived, so their absence says nothing about the run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些标记种类从未被反推，所以它们的缺席不说明这次运行发生了什么。"
          }
        }
      }
    },
    "diagnostics.notDerived.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not looked for"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查的种类"
          }
        }
      }
    },
    "diagnostics.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不完整"
          }
        }
      }
    },
    "diagnostics.partial.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is missing a product it declared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次会话缺少它自己声明过的产物。"
          }
        }
      }
    },
    "diagnostics.selection.driftedAway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the cursor has left this event"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标已离开该事件"
          }
        }
      }
    },
    "diagnostics.selection.timeOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a time point is selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅选择了时间点"
          }
        }
      }
    },
    "diagnostics.session.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No session open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无诊断会话"
          }
        }
      }
    },
    "diagnostics.session.none.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a capture.diagnostics Job from History to read its verified artifacts. No connected device is needed to read a saved capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 History 打开 capture.diagnostics 记录，读取校验后的产物。读取已保存的采集无需连接设备。"
          }
        }
      }
    },
    "diagnostics.shot.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图失败"
          }
        }
      }
    },
    "diagnostics.shot.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screenshot was taken here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处未拍摄截图"
          }
        }
      }
    },
    "diagnostics.shot.standsFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot stands for the moment it was taken, not the moment it was asked for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图只代表拍摄时刻，不代表标记时刻的画面。"
          }
        }
      }
    },
    "diagnostics.shot.takenAfter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "taken after the mark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄于标记之后"
          }
        }
      }
    },
    "diagnostics.shot.tooFar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture proves this moment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一时刻没有可证明对应的画面"
          }
        }
      }
    },
    "diagnostics.shot.tooFar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nearest screenshot is too far from this mark to stand for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的一张截图距这个标记太远，不能代表它。"
          }
        }
      }
    },
    "diagnostics.shot.undecidable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here can tell"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处无法判定"
          }
        }
      }
    },
    "diagnostics.shot.undecidable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot was taken around this mark, but the interval it could have been taken in is wider than the tolerance, so it cannot be said to be this moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个标记附近确有一张截图，但它可能被拍摄的时间区间宽于容差，因此无法断定它就是这一时刻。"
          }
        }
      }
    },
    "diagnostics.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        }
      }
    },
