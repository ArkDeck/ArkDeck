    "diagnostics.session.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved capture · read only. Viewing does not start a new Job."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的采集 · 只读。查看不会启动新 Job。"
          }
        }
      }
    },
    "diagnostics.session.timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime timeline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 时间线"
          }
        }
      }
    },
    "diagnostics.ring.covered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime found the coverage anchor in the ring snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 已在环形快照中找到覆盖锚点。"
          }
        }
      }
    },
    "diagnostics.ring.lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring snapshot lost its coverage anchor. Earlier events may be missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环形快照未保留覆盖锚点，较早事件可能缺失。"
          }
        }
      }
    },
    "diagnostics.artifacts.title": {
      "extractionState": "manual",
      "localizations": {
