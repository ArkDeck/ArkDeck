    "diagnostics.artifacts.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text previews stay in this App. Sensitive content is read only when you select it; nothing is exported or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本预览仅留在此 App。敏感内容仅在选择后读取，不会导出或上传。"
          }
        }
      }
    },
    "diagnostics.artifacts.read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read locally"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机读取"
          }
        }
      }
    },
    "diagnostics.artifacts.readSensitive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read sensitive content locally"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机读取敏感内容"
          }
        }
      }
