    "flash.plan.prerequisitesAwaitPlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile prerequisites are listed once an exact plan exists."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生成精确计划后展示 profile 前置条件。"}}}},
    "flash.plan.prerequisitesNote": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The profile declares these requirements. An authorized Runtime must verify them again immediately before dispatch; this App has not marked them satisfied."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备配置声明了以下要求。已授权的 Runtime 必须在派发前再次验证；此 App 不会把它们标记为已满足。"}}}},
    "flash.plan.size": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive size"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档大小"}}}},
    "flash.plan.stepSetDigest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step-set digest"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"步骤集摘要"}}}},
    "flash.plan.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精确计划"}}}},
    "flash.plan.toolchain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pinned toolchain"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"固定工具链"}}}},
    "flash.plan.writeForbidden": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive members excluded from writes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"禁止写入的归档成员"}}}},
    "flash.planOnly.noSubmission": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan only: every deviceMutation and destructive step remains notExecuted(planned). No operation was submitted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅计划：所有 deviceMutation 与 destructive 步骤均保持 notExecuted(planned)，未提交任何操作。"}}}},
    "flash.prerequisite.loader": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loader mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Loader 模式"}}}},
