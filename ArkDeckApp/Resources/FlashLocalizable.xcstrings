    "flash.review.selectImageBlocker": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an image bundle before preparing a plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先选择镜像包，再生成计划。"}}}},
    "flash.review.selectTargetBlocker": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an adopted target with a durable binding before preparing this plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先选择已有持久绑定的已接管目标，再生成此计划。"}}}},
    "flash.review.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审核与确认"}}}},
    "flash.runtime.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Runtime Flash jobs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚无 Runtime 刷机 Job"}}}},
    "flash.runtime.emptyDescription": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing or confirming a local plan does not create a Job. Authorized Runtime execution will appear here."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在本地生成或确认计划不会创建 Job；经授权的 Runtime 执行会显示在这里。"}}}},
    "flash.runtime.job": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Job"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Job"}}}},
    "flash.runtime.jobCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime Flash jobs: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 刷机 Job：%d"}}}},
    "flash.runtime.openRecord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Runtime record"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Runtime 记录"}}}},
    "flash.runtime.outcomeUnknownGuidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The device effect is unknown. Keep the current device state unchanged when possible. Do not start another flash until the outstanding step has been reconciled through an approved Runtime path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备影响未知。条件允许时请保持设备当前状态；在通过已批准的 Runtime 路径核对未决步骤前，不要开始下一次刷机。"}}}},
    "flash.runtime.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read only: this card cannot cancel, retry, reconcile, or resume."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只读：此卡片不能取消、重试、核对或恢复执行。"}}}},
    "flash.runtime.recoveryTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A Runtime Flash job needs attention"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 刷机 Job 需要处理"}}}},
    "flash.runtime.residue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Outstanding cleanup items: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未清理项目：%d"}}}},
    "flash.runtime.result.cancelled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime reports cancellation. Review the last confirmed stage before disconnecting the device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 报告已取消。断开设备前，请核对最后确认的阶段。"}}}},
    "flash.runtime.result.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime reports failure. Use the Job record to find the last confirmed stage before recovery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 报告失败。开始恢复前，请从 Job 记录确认最后完成的阶段。"}}}},
    "flash.runtime.result.inProgress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime is still processing this Job. Progress is stage-based; no percentage is fabricated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 仍在处理此 Job。进度按真实阶段展示，不生成虚假百分比。"}}}},
    "flash.runtime.result.interrupted": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime reports an interruption. Open the Job record before deciding the device state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 报告执行中断。判断设备状态前，请打开 Job 记录。"}}}},
    "flash.runtime.result.needsAction": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime stopped for human action. This page cannot resume or reconcile the Job."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 已停下等待人工操作。此页面不能恢复执行或核对 Job。"}}}},
    "flash.runtime.result.outcomeUnknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device effect is unknown. Do not treat this Job as finished or start another flash."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备影响未知。不要把此 Job 视为完成，也不要开始下一次刷机。"}}}},
    "flash.runtime.result.planned": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan-only Job completed. No device mutation was dispatched."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅计划 Job 已完成，未派发设备变更。"}}}},
    "flash.runtime.result.succeeded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime reports success after the Flash and postflight checks."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 报告刷机及 postflight 检查成功。"}}}},
    "flash.runtime.result.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime returned an unfamiliar state. Open the record before deciding what to do."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 返回了未知状态。决定下一步前，请打开记录。"}}}},
    "flash.runtime.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标"}}}},
    "flash.runtime.timeline": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Observed Runtime timeline"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 观测时间线"}}}},
    "flash.runtime.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime Flash activity"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 刷机活动"}}}},
    "flash.runtime.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime Flash activity is unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 刷机活动不可用"}}}},
    "flash.runtime.unavailableNote": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An unreadable history is not an empty history. Refresh after Runtime becomes reachable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取历史不等于历史为空。Runtime 恢复可达后请刷新。"}}}},
    "flash.runtime.waitingForHumanGuidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime stopped for an operator decision. Open the Job record and follow its exact recovery instruction; confirmation on this page cannot resume it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 已停下等待操作员决定。请打开 Job 记录并遵循其精确恢复指引；此页面的确认不能恢复执行。"}}}},
    "flash.simulated.previewOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build can prepare a simulated plan, but it has no published simulation runner. No real device is contacted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此构建可以生成模拟计划，但尚未发布模拟执行器；不会连接真实设备。"}}}},
    "flash.state.awaitingRebindConfirmation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for device rebind confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待设备重新绑定确认"}}}},
