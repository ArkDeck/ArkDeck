    "flash.action.submitLocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Submit to Runtime (locked)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提交到 Runtime（已锁定）"}}}},
    "flash.availability.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AVAILABLE — Runtime can materialize flash.dayu200@1"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AVAILABLE — Runtime 可生成 flash.dayu200@1 计划"}}}},
    "flash.availability.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking Runtime availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查 Runtime 可用性"}}}},
    "flash.availability.scope": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Availability describes the production Runtime. Preparing a preview never submits or runs an operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用性来自生产 Runtime。生成预览不会提交或执行任何操作。"}}}},
    "flash.availability.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用性"}}}},
    "flash.availability.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"UNAVAILABLE — Flash execution is blocked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"UNAVAILABLE — 刷机执行已阻断"}}}},
    "flash.confirm.accept": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认精确计划"}}}},
    "flash.confirm.acceptNamed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm the flash plan for %1$@ (%2$lld partitions)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认 %1$@ 的刷机计划（%2$lld 个分区）"}}}},
    "flash.confirm.cancel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "flash.confirm.destructiveHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The phrase starts with FLASH and includes this plan's first 12 digest characters."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此短语以 FLASH 开头，并包含该计划摘要的前 12 个字符。"}}}},
    "flash.confirm.destructiveLabel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type the plan phrase exactly"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"准确输入计划确认短语"}}}},
    "flash.confirm.destructivePlaceholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the displayed FLASH phrase"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入上方显示的 FLASH 短语"}}}},
    "flash.confirm.error.destructivePhraseMismatch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type the displayed FLASH phrase exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请准确输入显示的 FLASH 短语。"}}}},
    "flash.confirm.error.missingOrStaleTarget": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The target or binding changed. Refresh and prepare the plan again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标或绑定已变化，请刷新并重新生成计划。"}}}},
    "flash.confirm.error.notExecutePlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare a fresh execute plan before confirming."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先重新生成执行计划，再进行确认。"}}}},
    "flash.confirm.error.stalePlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plan changed. Close this sheet and review the fresh plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划已变化，请关闭此窗口并审核新计划。"}}}},
    "flash.confirm.error.userdataPhraseMismatch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type ERASE-USERDATA exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请准确输入 ERASE-USERDATA。"}}}},
    "flash.confirm.exactPlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pinned facts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"固定事实"}}}},
    "flash.confirm.image": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像包"}}}},
    "flash.confirm.noJob": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirming creates only a local review receipt. It does not create a Runtime Job or dispatch a device operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认后只生成本地审核回执，不会创建 Runtime Job，也不会派发设备操作。"}}}},
    "flash.confirm.powerWarning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If this plan is later executed through an authorized Runtime path, keep the Mac awake and connected to power, and do not disconnect the device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果之后通过已授权的 Runtime 通道执行此计划，请保持 Mac 唤醒并连接电源，且不要断开设备。"}}}},
    "flash.confirm.profile": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备配置"}}}},
    "flash.confirm.recoveryPath": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A failed write can leave the device unable to boot; recovery requires the vendor's recovery tooling, and ArkDeck does not promise automatic recovery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写入失败可能导致设备无法启动；恢复需使用厂商恢复工具，ArkDeck 不保证可自动恢复。"}}}},
    "flash.confirm.stepSet": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step-set SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"步骤集 SHA-256"}}}},
    "flash.confirm.summary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plan overwrites the selected device. Verify every pinned fact before entering both phrases."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划会覆盖所选设备。输入两个确认短语前，请核对每项固定事实。"}}}},
    "flash.confirm.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标"}}}},
    "flash.confirm.targetUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No exact target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有精确目标"}}}},
    "flash.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm this exact Flash plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认此精确刷机计划"}}}},
    "flash.confirm.userdataHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type ERASE-USERDATA exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请准确输入 ERASE-USERDATA。"}}}},
    "flash.confirm.userdataLabel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm userdata erasure"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认清除 userdata"}}}},
    "flash.confirm.userdataPlaceholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter ERASE-USERDATA"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入 ERASE-USERDATA"}}}},
    "flash.disposition.executionLocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (E2 locked)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（E2 已锁定）"}}}},
    "flash.disposition.planned": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (planned)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（仅计划）"}}}},
    "flash.disposition.simulatedPreview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (simulation preview)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（模拟预览）"}}}},
    "flash.effect.destructive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Destructive"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"破坏性"}}}},
