    "flash.plan.emptyDescription": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an image bundle and target, then prepare the plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择镜像包和目标设备，然后生成计划。"}}}},
    "flash.plan.imageHash": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像 SHA-256"}}}},
