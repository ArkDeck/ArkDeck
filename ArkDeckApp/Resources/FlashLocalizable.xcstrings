    "flash.postflight.comparison": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Expected %1$@ · observed %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"期望 %1$@ · 实测 %2$@"}}}},
    "flash.postflight.match": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ matches. Expected %2$@; observed %3$@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$@ 匹配。期望 %2$@；实测 %3$@。"}}}},
