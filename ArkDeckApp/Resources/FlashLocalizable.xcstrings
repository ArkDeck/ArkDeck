    "flash.prerequisite.optional": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional for this profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备配置为可选"}}}},
    "flash.prerequisite.recoveryPath": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery path available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"具备恢复路径"}}}},
