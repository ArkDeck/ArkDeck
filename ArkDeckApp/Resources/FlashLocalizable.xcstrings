{
  "sourceLanguage": "en",
  "strings": {
    "flash.action.preparePlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生成精确计划"}}}},
    "flash.action.preparePlanAgain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare plan again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新生成计划"}}}},
    "flash.action.refresh": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh Flash facts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新刷机状态"}}}},
    "flash.action.reviewImpact": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review destructive impact…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审核破坏性影响…"}}}},
    "flash.action.submitLocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Submit to Runtime (locked)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提交到 Runtime（已锁定）"}}}},
    "flash.availability.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AVAILABLE — Runtime can materialize flash.dayu200@1"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AVAILABLE — Runtime 可生成 flash.dayu200@1 计划"}}}},
    "flash.availability.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking Runtime availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查 Runtime 可用性"}}}},
    "flash.availability.scope": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Availability describes the production Runtime. Preparing a preview never submits or runs an operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用性来自生产 Runtime。生成预览不会提交或执行任何操作。"}}}},
    "flash.availability.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用性"}}}},
    "flash.availability.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"UNAVAILABLE — Flash execution is blocked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"UNAVAILABLE — 刷机执行已阻断"}}}},
    "flash.disposition.executionLocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (E2 locked)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（E2 已锁定）"}}}},
    "flash.disposition.planned": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (planned)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（仅计划）"}}}},
    "flash.disposition.simulatedPreview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (simulation preview)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（模拟预览）"}}}},
    "flash.effect.destructive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Destructive"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"破坏性"}}}},
    "flash.effect.deviceMutation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device mutation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备变更"}}}},
    "flash.effect.hostOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅主机"}}}},
    "flash.effect.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只读"}}}},
    "flash.error.fileAccess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to read the selected file. Select the image bundle again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取所选文件，请重新选择镜像包。"}}}},
    "flash.error.invalid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a complete, valid images.tar.gz bundle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择完整且有效的 images.tar.gz 镜像包。"}}}},
    "flash.error.plan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to materialize the exact plan. Review the detail below."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法生成精确计划，请查看下方详情。"}}}},
    "flash.error.unreadable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to read the image bundle. Select it again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取镜像包，请重新选择。"}}}},
    "flash.error.unsupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This image bundle does not match the selected DAYU200 profile."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此镜像包与所选 DAYU200 配置不匹配。"}}}},
    "flash.execute.confirmationRequired": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact-plan confirmation is still required."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仍需确认精确计划。"}}}},
    "flash.execute.confirmed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact plan confirmed for human handoff"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已确认精确计划，可供人工交接"}}}},
    "flash.execute.confirmedAt": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmed at"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认时间"}}}},
    "flash.execute.locked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime submission is locked: this App build has no reviewed E2 mutation transport. Reviewing the exact plan cannot dispatch a device operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 提交已锁定：此 App 构建尚无经审查的 E2 变更通道。审核精确计划不会派发设备操作。"}}}},
    "flash.execute.reviewNotAuthority": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This review receipt is not E2 authority. No Runtime Job was created."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此审核回执不是 E2 授权，未创建 Runtime Job。"}}}},
    "flash.execute.submitLockReason": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime submission remains unavailable because the App's reviewed transport is read only. No device operation can cross it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 提交仍不可用，因为 App 的经审查通道仅支持读取，任何设备操作都无法通过。"}}}},
    "flash.image.choose": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose image bundle…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择镜像包…"}}}},
    "flash.image.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck streams and hashes the archive once. It does not extract or execute anything inside it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 只流式读取并哈希归档一次，不会解压或执行其中的任何内容。"}}}},
    "flash.image.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像包"}}}},
    "flash.image.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未选择"}}}},
    "flash.confirm.accept": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认精确计划"}}}},
    "flash.confirm.cancel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "flash.confirm.destructiveHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The phrase starts with FLASH and includes this plan's first 12 digest characters."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此短语以 FLASH 开头，并包含该计划摘要的前 12 个字符。"}}}},
    "flash.confirm.destructiveLabel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type the plan phrase exactly"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"准确输入计划确认短语"}}}},
    "flash.confirm.destructivePlaceholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the displayed FLASH phrase"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入上方显示的 FLASH 短语"}}}},
    "flash.confirm.error.destructivePhraseMismatch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type the displayed FLASH phrase exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请准确输入显示的 FLASH 短语。"}}}},
    "flash.confirm.error.missingOrStaleTarget": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The target or binding changed. Refresh and prepare the plan again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标或绑定已变化，请刷新并重新生成计划。"}}}},
    "flash.confirm.error.notExecutePlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare a fresh execute plan before confirming."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先重新生成执行计划，再进行确认。"}}}},
    "flash.confirm.error.stalePlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plan changed. Close this sheet and review the fresh plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划已变化，请关闭此窗口并审核新计划。"}}}},
    "flash.confirm.error.userdataPhraseMismatch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type ERASE-USERDATA exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请准确输入 ERASE-USERDATA。"}}}},
    "flash.confirm.exactPlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pinned facts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"固定事实"}}}},
    "flash.confirm.image": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像包"}}}},
    "flash.confirm.noJob": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirming creates only a local review receipt. It does not create a Runtime Job or dispatch a device operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认后只生成本地审核回执，不会创建 Runtime Job，也不会派发设备操作。"}}}},
    "flash.confirm.powerWarning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If this plan is later executed through an authorized Runtime path, keep the Mac awake and connected to power, and do not disconnect the device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果之后通过已授权的 Runtime 通道执行此计划，请保持 Mac 唤醒并连接电源，且不要断开设备。"}}}},
    "flash.confirm.profile": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备配置"}}}},
    "flash.confirm.stepSet": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step-set SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"步骤集 SHA-256"}}}},
    "flash.confirm.summary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plan overwrites the selected device. Verify every pinned fact before entering both phrases."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划会覆盖所选设备。输入两个确认短语前，请核对每项固定事实。"}}}},
    "flash.confirm.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标"}}}},
    "flash.confirm.targetUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No exact target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有精确目标"}}}},
    "flash.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm this exact Flash plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认此精确刷机计划"}}}},
    "flash.confirm.userdataHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type ERASE-USERDATA exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请准确输入 ERASE-USERDATA。"}}}},
    "flash.confirm.userdataLabel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm userdata erasure"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认清除 userdata"}}}},
    "flash.confirm.userdataPlaceholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter ERASE-USERDATA"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入 ERASE-USERDATA"}}}},
    "flash.impact.partitions": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plan overwrites %d mapped partitions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划将覆盖 %d 个已映射分区。"}}}},
    "flash.impact.preserved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Orphan images, unmapped partitions, and sector gaps remain untouched."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"孤立镜像、未映射分区和扇区间隙均不会被写入。"}}}},
    "flash.impact.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data impact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据影响"}}}},
    "flash.impact.userdata": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"userdata is overwritten; existing user data is destroyed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"userdata 将被覆盖，现有用户数据会被清除。"}}}},
    "flash.mode.execute": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Execute"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行"}}}},
    "flash.mode.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Execution mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行模式"}}}},
    "flash.mode.planOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅计划"}}}},
    "flash.mode.planOnly.badge": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"PLANNED — no deviceMutation or destructive dispatch"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"PLANNED — 不派发 deviceMutation 或 destructive 步骤"}}}},
    "flash.mode.simulated": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Simulated"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模拟"}}}},
    "flash.mode.simulated.badge": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SIMULATED PREVIEW — no real device access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SIMULATED PREVIEW — 不接触真实设备"}}}},
    "flash.plan.archiveHash": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档 SHA-256"}}}},
    "flash.plan.build": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Embedded build"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内嵌系统版本"}}}},
    "flash.plan.digest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan digest"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划摘要"}}}},
    "flash.plan.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No exact plan yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未生成精确计划"}}}},
    "flash.plan.emptyDescription": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an image bundle and target, then prepare the plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择镜像包和目标设备，然后生成计划。"}}}},
    "flash.plan.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading, hashing, and validating the image bundle…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在读取、哈希并校验镜像包……"}}}},
    "flash.plan.size": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive size"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档大小"}}}},
    "flash.plan.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精确计划"}}}},
    "flash.planOnly.noSubmission": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan only: every deviceMutation and destructive step remains notExecuted(planned). No operation was submitted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅计划：所有 deviceMutation 与 destructive 步骤均保持 notExecuted(planned)，未提交任何操作。"}}}},
    "flash.profile.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备配置"}}}},
    "flash.profileImage.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile and image set"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置与镜像集"}}}},
    "flash.review.selectImageBlocker": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an image bundle before preparing a plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先选择镜像包，再生成计划。"}}}},
    "flash.review.selectTargetBlocker": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an adopted target with a durable binding before preparing this plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先选择已有持久绑定的已接管目标，再生成此计划。"}}}},
    "flash.review.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审核与确认"}}}},
    "flash.simulated.previewOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build can prepare a simulated plan, but it has no published simulation runner. No real device is contacted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此构建可以生成模拟计划，但尚未发布模拟执行器；不会连接真实设备。"}}}},
    "flash.target.binding": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Binding revision"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"绑定修订号"}}}},
    "flash.target.guidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect and adopt a DAYU200 in ArkDeck Runtime, then refresh this workspace."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先在 ArkDeck Runtime 中连接并接管 DAYU200，然后刷新此工作区。"}}}},
    "flash.target.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精确目标"}}}},
