{
  "sourceLanguage": "en",
  "strings": {
    "flash.action.cancel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel remaining steps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消后续步骤"}}}},
    "flash.action.cancel.help": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If a partition write is in progress, Runtime finishes that critical step and stops only at the next safe boundary."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"若正在写入分区，Runtime 会完成该临界步骤，仅在下一个安全边界停止。"}}}},
    "flash.action.preparePlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生成精确计划"}}}},
    "flash.action.preparePlanAgain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare plan again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新生成计划"}}}},
    "flash.action.refresh": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh Flash facts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新刷机状态"}}}},
    "flash.action.submit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Erase userdata and flash"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"擦除用户数据并刷机"}}}},
    "flash.action.submitting": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Importing and flashing…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在导入并刷机…"}}}},
    "flash.availability.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AVAILABLE — Runtime can materialize flash.dayu200"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AVAILABLE — Runtime 可生成 flash.dayu200 计划"}}}},
    "flash.availability.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking Runtime availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查 Runtime 可用性"}}}},
    "flash.availability.scope": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Availability describes the production Runtime. Preparing a preview never submits or runs an operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用性来自生产 Runtime。生成预览不会提交或执行任何操作。"}}}},
    "flash.availability.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Availability"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用性"}}}},
    "flash.availability.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"UNAVAILABLE — Flash execution is blocked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"UNAVAILABLE — 刷机执行已阻断"}}}},
    "flash.binding.unprepared.hdc.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected board matches one adopted Runtime target, while another board is still the active Flash binding. Click Flash once; Runtime will re-read the unique USB identity, atomically activate only the exact selected target, refresh prerequisites, and stop before any write if those facts drift."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选开发板精确匹配一个已采用的 Runtime 目标，但另一台设备仍是当前刷机绑定。只需点击一次刷机；Runtime 会重新读取唯一 USB 身份，仅原子激活精确选中的目标并刷新前置条件；若事实发生漂移，将在任何写入前停止。"}}}},
    "flash.binding.unprepared.hdc.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected DAYU200 needs active binding"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 DAYU200 需要切换为当前绑定"}}}},
    "flash.bootloader.bound": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loader is bound to the selected device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Loader 已绑定到所选设备"}}}},
    "flash.bootloader.unbound.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck found one DAYU200 in Loader mode, but it is not yet linked to a durable target. Select the device, then click Flash once; Runtime will bind the Loader, refresh the exact plan, and continue only if every prerequisite passes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 已发现一台处于 Loader 模式的 DAYU200，但它尚未关联到持久设备。请选择该设备，然后只需点击一次刷机；Runtime 会绑定 Loader、刷新精确计划，并仅在全部前置条件通过后继续。"}}}},
    "flash.bootloader.unprepared.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck found the selected DAYU200 in Loader mode, but its historical binding needs a fresh Runtime attestation. Click Flash once; Runtime will re-attest the selected Loader, refresh the exact plan, and continue only if every prerequisite passes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 已发现所选 DAYU200 处于 Loader 模式，但其历史绑定需要由 Runtime 重新核验。只需点击一次刷机；Runtime 会重新核验所选 Loader、刷新精确计划，并仅在全部前置条件通过后继续。"}}}},
    "flash.bootloader.unbound.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DAYU200 is already in Loader mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"DAYU200 已进入 Loader 模式"}}}},
    "flash.disposition.executionLocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (execute plan)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（执行计划）"}}}},
    "flash.disposition.planned": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (planned)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（仅计划）"}}}},
    "flash.disposition.simulatedPreview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"notExecuted (simulation preview)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"notExecuted（模拟预览）"}}}},
    "flash.deviceAccess.checking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking RockUSB device access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查 RockUSB 设备访问"}}}},
    "flash.deviceAccess.nextStep": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Minimum next step"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最小修复步骤"}}}},
    "flash.deviceAccess.observations": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Observed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已发现"}}}},
    "flash.deviceAccess.observationValue": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$d device(s) · %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$d 台设备 · %2$@"}}}},
    "flash.deviceAccess.remediation.chooseSupportedLoaderObservation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the supported DAYU200 Loader device shown above, then re-check."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择上方受支持的 DAYU200 Loader 设备，然后重新检查。"}}}},
    "flash.deviceAccess.remediation.inspectControlledDiagnostics": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Have the device or tool vendor inspect the controlled probe diagnostics."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请设备或工具供应方检查受控探测诊断。"}}}},
    "flash.deviceAccess.remediation.reconnectOrEnterLoader": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reconnect the board or put it into Loader mode, then re-check."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新连接开发板或让其进入 Loader 模式，然后重新检查。"}}}},
    "flash.deviceAccess.remediation.repairDriverOutsideArkDeck": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask the device or tool vendor to repair the host USB driver or libusb backend outside ArkDeck, then re-check."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请设备或工具供应方在 ArkDeck 外修复主机 USB 驱动或 libusb backend，然后重新检查。"}}}},
    "flash.deviceAccess.remediation.reviewDevicePermissionOutsideArkDeck": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask a system administrator to grant this user access to the RockUSB device outside ArkDeck, then re-check."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请系统管理员在 ArkDeck 外为当前用户授予 RockUSB 设备访问权限，然后重新检查。"}}}},
    "flash.deviceAccess.reprobe": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Re-check device access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查设备访问"}}}},
    "flash.deviceAccess.responsibility": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Responsible party"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"处理责任方"}}}},
    "flash.deviceAccess.responsibility.deviceOrToolVendor": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device or tool vendor"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备或工具供应方"}}}},
    "flash.deviceAccess.responsibility.systemAdministrator": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System administrator"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统管理员"}}}},
    "flash.deviceAccess.responsibility.user": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device operator"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备操作员"}}}},
    "flash.deviceAccess.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rockchip device access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Rockchip 设备访问"}}}},
    "flash.deviceAccess.toolUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkForge RockUSB discovery is unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkForge RockUSB 探测不可用"}}}},
    "flash.deviceAccess.verdict.accessible": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loader device access is ready"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Loader 设备访问就绪"}}}},
    "flash.deviceAccess.verdict.driverUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host driver or libusb backend is unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主机驱动或 libusb backend 不可用"}}}},
    "flash.deviceAccess.verdict.malformedOutput": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The registered probe returned unknown output"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已注册探测返回未知输出"}}}},
    "flash.deviceAccess.verdict.offline": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device is offline or not in Loader mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备离线或未进入 Loader 模式"}}}},
    "flash.deviceAccess.verdict.permissionDenied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host permission denies RockUSB access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主机权限拒绝 RockUSB 访问"}}}},
    "flash.deviceAccess.verdict.probeFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The registered device probe failed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已注册设备探测失败"}}}},
    "flash.deviceAccess.verdict.protocolBlocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A device was found, but it is not a supported DAYU200 Loader target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已发现设备，但它不是受支持的 DAYU200 Loader 目标"}}}},
    "flash.effect.destructive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Destructive"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"破坏性"}}}},
    "flash.effect.deviceMutation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device mutation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备变更"}}}},
    "flash.effect.hostOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Host only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅主机"}}}},
    "flash.effect.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只读"}}}},
    "flash.error.fileAccess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to read the selected file. Select the image bundle again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取所选文件，请重新选择镜像包。"}}}},
    "flash.error.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a .tar.gz, .zip, or .7z image archive."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择 .tar.gz、.zip 或 .7z 格式的镜像压缩包。"}}}},
    "flash.error.invalid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a complete, valid DAYU200 image archive."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择完整且有效的 DAYU200 镜像压缩包。"}}}},
    "flash.error.plan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to materialize the exact plan. Review the detail below."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法生成精确计划，请查看下方详情。"}}}},
    "flash.error.unreadable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to read the image bundle. Select it again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取镜像包，请重新选择。"}}}},
    "flash.error.unsupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This image bundle does not match the selected DAYU200 profile."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此镜像包与所选 DAYU200 配置不匹配。"}}}},
    "flash.execute.planRequired": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare an exact execute plan before flashing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷机前请先生成精确执行计划。"}}}},
    "flash.execute.prerequisiteBlocker": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Required Runtime prerequisites are unknown or not satisfied. Keep the intended DAYU200 connected, prepare its cross-mode binding, then prepare the exact plan again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"必需的 Runtime 前置条件未知或未满足。请保持目标 DAYU200 连接，完成跨模式绑定后重新生成精确计划。"}}}},
    "flash.execute.powerWarning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"During Flash, keep the Mac awake and connected to power, and do not disconnect the device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷机期间请保持 Mac 唤醒并连接电源，且不要断开设备。"}}}},
    "flash.execute.recoveryPath": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A failed write can leave the system unable to boot. Protected Runtime may recover only through ArkForge's proven complete-overwrite path; Maskrom rescue remains a separate operator procedure."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写入失败可能导致系统无法启动。受保护 Runtime 仅可通过 ArkForge 已证明的完整覆写路径恢复；Maskrom 救援仍是独立的人工流程。"}}}},
    "flash.execute.reviewNotAuthority": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clicking “Erase userdata and flash” acknowledges the exact target, image, partitions, and data impact shown above. This is UX only: Runtime owns capability admission and rechecks every fact before dispatch."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点击“擦除用户数据并刷机”即表示已知晓上方展示的精确目标、镜像、分区与数据影响。此操作仅是界面确认：Runtime 负责 capability 准入，并在派发前重新校验全部事实。"}}}},
    "flash.execute.terminal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime Flash finished: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Runtime 刷机结束：%@"}}}},
    "flash.image.choose": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose image bundle…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择镜像包…"}}}},
    "flash.image.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck streams and hashes the archive once. It does not extract or execute anything inside it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 只流式读取并哈希归档一次，不会解压或执行其中的任何内容。"}}}},
    "flash.image.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像包"}}}},
    "flash.image.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未选择"}}}},
    "flash.impact.partitions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The plan overwrites %d mapped partitions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划将覆盖 %d 个已映射分区。"}}}},
    "flash.impact.preserved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Orphan images, unmapped partitions, and sector gaps remain untouched."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"孤立镜像、未映射分区和扇区间隙均不会被写入。"}}}},
    "flash.impact.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data impact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据影响"}}}},
    "flash.impact.userdata": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"userdata is overwritten; existing user data is destroyed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"userdata 将被覆盖，现有用户数据会被清除。"}}}},
    "flash.mode.execute": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Execute"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行"}}}},
    "flash.mode.label": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Execution mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行模式"}}}},
    "flash.mode.planOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅计划"}}}},
    "flash.mode.planOnly.badge": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"PLANNED — no deviceMutation or destructive dispatch"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"PLANNED — 不派发 deviceMutation 或 destructive 步骤"}}}},
    "flash.mode.simulated": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Simulated"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模拟"}}}},
    "flash.mode.simulated.badge": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SIMULATED PREVIEW — no real device access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SIMULATED PREVIEW — 不接触真实设备"}}}},
    "flash.inputs.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan inputs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划输入"}}}},
    "flash.plan.archiveHash": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档 SHA-256"}}}},
    "flash.plan.build": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Embedded build"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内嵌系统版本"}}}},
    "flash.plan.column.arguments": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Arguments"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数"}}}},
    "flash.plan.column.disposition": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disposition"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行方式"}}}},
    "flash.plan.column.effect": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Effect"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"效果"}}}},
    "flash.plan.column.number": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"#"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"序号"}}}},
    "flash.plan.column.step": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"步骤"}}}},
    "flash.plan.digest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan digest"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划摘要"}}}},
    "flash.plan.digest.materializedAtSubmission": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Materialized by Runtime at submission (recorded on the job)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提交时由 Runtime 物化（记录于任务）"}}}},
    "flash.plan.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No exact plan yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未生成精确计划"}}}},
    "flash.plan.emptyDescription": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an image bundle and target, then prepare the plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择镜像包和目标设备，然后生成计划。"}}}},
    "flash.plan.imageHash": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像 SHA-256"}}}},
    "flash.plan.imageSize": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image size"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"镜像大小"}}}},
    "flash.plan.partitionCount": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mapped partition images: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已映射分区镜像：%d"}}}},
    "flash.plan.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading, hashing, and validating the image bundle…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在读取、哈希并校验镜像包……"}}}},
    "flash.plan.prerequisites": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Execution prerequisites"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行前置条件"}}}},
    "flash.plan.prerequisitesAwaitPlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile prerequisites are listed once an exact plan exists."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生成精确计划后展示 profile 前置条件。"}}}},
    "flash.plan.prerequisitesNote": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These are the latest read-only Runtime observations. Unknown is never upgraded by the App; Runtime verifies every required prerequisite again before a critical write."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以下为 Runtime 最新只读探测结果。App 不会把 unknown 猜成满足；Runtime 会在临界写入前再次验证全部必需前置条件。"}}}},
    "flash.plan.size": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive size"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档大小"}}}},
    "flash.plan.stepSetDigest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step-set digest"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"步骤集摘要"}}}},
    "flash.plan.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精确计划"}}}},
    "flash.plan.writeForbidden": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive members excluded from writes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"禁止写入的归档成员"}}}},
    "flash.planOnly.noSubmission": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan only: every deviceMutation and destructive step remains notExecuted(planned). No operation was submitted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅计划：所有 deviceMutation 与 destructive 步骤均保持 notExecuted(planned)，未提交任何操作。"}}}},
    "flash.prerequisite.loader": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loader mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Loader 模式"}}}},
    "flash.prerequisite.notApplicable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not applicable for this profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备配置不适用"}}}},
    "flash.prerequisite.optional": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional for this profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备配置为可选"}}}},
    "flash.prerequisite.recoveryPath": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery path available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"具备恢复路径"}}}},
    "flash.prerequisite.required": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Required by this profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备配置要求"}}}},
    "flash.prerequisite.stablePower": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stable host and device power"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主机与设备供电稳定"}}}},
    "flash.prerequisite.status.satisfied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Satisfied"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已满足"}}}},
    "flash.prerequisite.status.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unknown"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未知"}}}},
