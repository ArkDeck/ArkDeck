    "settings.storage.futureJobs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changing the root affects only new Jobs. Existing Sessions are not moved or deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更换根目录只影响新任务；已有 Session 不会被移动或删除。"}}}},
