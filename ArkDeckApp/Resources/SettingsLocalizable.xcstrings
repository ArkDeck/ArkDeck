    "settings.general.localFirst.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session artifacts stay in the configured local storage root unless you explicitly export them."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"除非你主动导出，否则 Session 产物始终保存在已配置的本地存储目录。"}}}},
    "settings.general.noUpload": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No automatic diagnostics upload"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不会自动上传诊断信息"}}}},
    "settings.general.noUpload.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Crashes and Job failures never create or upload a diagnostic bundle automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"崩溃或任务失败都不会自动生成或上传诊断包。"}}}},
