    "settings.remoteSources.privateKeyReadFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The private key could not be read. Choose the file again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取该私钥，请重新选择文件。"}}}},
    "settings.remoteSources.privateKeyInvalid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a non-empty OpenSSH private key no larger than 256 KiB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择不超过 256 KiB 的非空 OpenSSH 私钥。"}}}},
