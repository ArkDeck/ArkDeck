    "settings.storage.measurementUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current usage is unavailable. The saved quota and retention policy remain visible above."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前用量不可用；已保存的配额与保留策略仍显示在上方。"}}}},
