    "settings.remoteSources.remove": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove server"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除服务器"}}}},
    "settings.remoteSources.remove.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The server profile and its Keychain credential will be removed from this Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器配置及其 Keychain 凭据将从这台 Mac 上移除。"}}}},
    "settings.remoteSources.remove.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove this server?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除此服务器？"}}}},
    "settings.remoteSources.save": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save verified server"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存已验证服务器"}}}},
    "settings.remoteSources.security.hostKey": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pinned SSH host key"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"固定 SSH 主机密钥"}}}},
    "settings.remoteSources.security.hostKey.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The first verified fingerprint is saved explicitly. A changed host key is rejected on every later connection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首次验证的指纹需显式保存；后续连接若主机密钥变化将直接拒绝。"}}}},
    "settings.remoteSources.security.keychain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential secrets stay protected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据秘密始终受保护"}}}},
    "settings.remoteSources.security.keychain.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Imported secrets stay in Keychain. System default reads only owner-private id_rsa and id_ed25519 files; secrets never enter profiles, logs, command lines, or Runtime XPC."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入的凭据只存入 Keychain；系统默认仅只读当前用户私有的 id_rsa 与 id_ed25519，秘密不会进入配置、日志、命令行或 Runtime XPC。"}}}},
    "settings.remoteSources.security.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read-only SFTP surface"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只读 SFTP 能力"}}}},
    "settings.remoteSources.security.readOnly.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck exposes no SSH command, shell, upload, delete, rename, or arbitrary path API."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 不开放 SSH 命令、Shell、上传、删除、重命名或任意路径接口。"}}}},
    "settings.remoteSources.security.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Security boundary"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全边界"}}}},
    "settings.remoteSources.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage SSH servers used to browse and import remote build artifacts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理用于浏览和导入远端编译产物的 SSH 服务器。"}}}},
    "settings.remoteSources.systemDefaultHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If no file is selected, ArkDeck tries ~/.ssh/id_rsa, then ~/.ssh/id_ed25519. SSH config, known_hosts, and other files are not read."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不选择文件时，ArkDeck 依次尝试 ~/.ssh/id_rsa、~/.ssh/id_ed25519；不会读取 SSH config、known_hosts 或其他文件。"}}}},
    "settings.remoteSources.systemDefaultIdentity": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System default (id_rsa → id_ed25519)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统默认（id_rsa → id_ed25519）"}}}},
    "settings.remoteSources.testConnection": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Test connection and inspect host key"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"测试连接并检查主机密钥"}}}},
    "settings.remoteSources.testing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connecting through SSH/SFTP…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在通过 SSH/SFTP 连接……"}}}},
    "settings.remoteSources.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved servers"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存服务器"}}}},
    "settings.remoteSources.trustOnSave": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review this fingerprint. Saving will trust this exact host key for later connections."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请核对该指纹；保存后只信任这一枚主机密钥。"}}}},
    "settings.remoteSources.useSystemDefault": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use system default"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用系统默认"}}}},
    "settings.remoteSources.usingStoredCredential": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The saved Keychain credential will be used for this test."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次测试将使用 Keychain 中已保存的凭据。"}}}},
    "settings.remoteSources.verified": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection, credential, SFTP root, and host key verified"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接、凭据、SFTP 根目录与主机密钥均已验证"}}}},
    "settings.diagnostics.chooseAndPreview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose destination and preview…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择位置并预览…"}}}},
    "settings.diagnostics.defaultScope": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default scope"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认范围"}}}},
    "settings.diagnostics.destination": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Destination"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出位置"}}}},
    "settings.diagnostics.deviceRaw": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device raw"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备原始数据"}}}},
    "settings.diagnostics.entries": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Included entries"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"包含条目"}}}},
    "settings.diagnostics.excluded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Excluded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已排除"}}}},
    "settings.diagnostics.export": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export diagnostic bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出诊断包"}}}},
    "settings.diagnostics.exportNow": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export approved preview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出已确认的预览"}}}},
    "settings.diagnostics.exported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The approved diagnostic bundle was exported locally."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已将确认过的诊断包导出到本地。"}}}},
    "settings.diagnostics.metadata": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Application and platform metadata"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用与平台元数据"}}}},
    "settings.diagnostics.metadata.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Includes ArkDeck version, build, macOS version, and architecture."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"包含 ArkDeck 版本、构建号、macOS 版本与架构。"}}}},
    "settings.diagnostics.noAutomaticUpload": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck never uploads this bundle automatically. Export is available only after this preview and your explicit button press."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 绝不会自动上传此诊断包；只有完成预览并由你显式点击后才会导出。"}}}},
    "settings.diagnostics.notExcluded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not excluded — do not export"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未排除——请勿导出"}}}},
    "settings.diagnostics.panelPrompt": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预览"}}}},
    "settings.diagnostics.panelTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export ArkDeck Diagnostics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 ArkDeck 诊断包"}}}},
    "settings.diagnostics.previewFirst": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a new destination to calculate the exact entries, size, and scope hash. Previewing does not write a bundle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个新位置以计算精确条目、大小和范围哈希；预览不会写入诊断包。"}}}},
    "settings.diagnostics.rawExcluded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device raw excluded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"排除设备原始数据"}}}},
    "settings.diagnostics.rawExcluded.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"UI Dump, Trace, hilog, device identifiers, and Session artifact bytes are not included by default."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认不包含 UI Dump、Trace、hilog、设备标识符和 Session 产物字节。"}}}},
    "settings.diagnostics.redactedHDC": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Redacted HDC state"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已脱敏的 HDC 状态"}}}},
    "settings.diagnostics.redactedHDC.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tool path and server endpoint are represented only by redacted or unverified states."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工具路径与服务端点只以“已脱敏”或“未验证”状态表示。"}}}},
    "settings.diagnostics.reveal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reveal in Finder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在访达中显示"}}}},
    "settings.diagnostics.scopeHash": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scope SHA-256"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"范围 SHA-256"}}}},
    "settings.diagnostics.size": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated size"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预计大小"}}}},
    "settings.diagnostics.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview a bounded, local diagnostic bundle before explicitly exporting it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先预览范围受限的本地诊断包，再显式导出。"}}}},
    "settings.diagnostics.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagnostics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"诊断"}}}},
    "settings.diagnostics.warning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review the preview before sharing. Even a redacted bundle may reveal build and platform details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分享前请检查预览；即使经过脱敏，诊断包仍可能披露构建与平台信息。"}}}},
    "settings.error.exportDiagnostics": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The approved diagnostic scope changed or could not be exported. Create a fresh preview before retrying."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已确认的诊断范围发生变化或无法导出，请重新生成预览后再试。"}}}},
    "settings.error.previewDiagnostics": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The diagnostic preview could not be created. Choose a new, empty destination."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法生成诊断预览，请选择一个尚不存在的新位置。"}}}},
    "settings.error.refresh": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Settings could not be loaded. Try refreshing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载设置，请尝试刷新。"}}}},
    "settings.error.resetRoot": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The default Session folder could not be restored. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法恢复默认 Session 目录，请刷新后重试。"}}}},
    "settings.error.savePolicy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The storage policy changed or could not be saved. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"存储策略已变化或无法保存，请刷新后重试。"}}}},
    "settings.error.selectRoot": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ArkDeck could not retain safe read/write access to that folder. Choose another folder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ArkDeck 无法安全保留该目录的读写权限，请选择其他目录。"}}}},
