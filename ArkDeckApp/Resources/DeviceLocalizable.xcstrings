      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save As…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另存为…"
          }
        }
      }
    },
    "device.record.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存录屏"
          }
        }
      }
    },
    "device.record.again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再录一段"
          }
        }
      }
    },
    "device.record.rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "measured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实测"
          }
        }
      }
    },
    "device.record.gap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "frames were lost"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧丢失"
          }
        }
      }
    },
    "device.record.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopt exactly one device to record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采纳且仅采纳一台设备才能录制"
          }
        }
      }
    },
    "device.record.ceiling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device offers no recorder, so this is a run of stills composed here. About 1.8 a second is what its display readback allows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没有录屏接口，这是在本机把一串静止画面合成出来的。它的显示回读只允许约每秒 1.8 帧。"
          }
        }
      }
    },
    "device.record.timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames are laid out at the spacing they were taken at, not at an average."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各帧按实际拍摄间距排布，不是按平均值。"
          }
        }
      }
    },
    "device.record.noRoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough room to keep this recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放不下这段录屏"
          }
        }
      }
    },
    "device.record.noRoom.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The artifact store refuses a new recording rather than deleting one you already have."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "制品库会拒绝新录屏，而不是删掉你已有的那一段。"
          }
        }
      }
    },
    "device.record.wouldFit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "would fit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放得下"
          }
        }
      }
    },
    "device.record.needs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "needs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要"
          }
        }
      }
    },
    "device.record.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "free"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余"
          }
        }
      }
    },
    "device.record.headroomUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the artifact store's remaining room, so this run was not checked against it. The runtime still refuses a recording it cannot keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不到制品库剩余空间，这次运行没有对它做检查。运行时仍会拒绝一段它存不下的录屏。"
          }
        }
      }
    },
    "device.performance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing captures on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自行取帧。"
          }
        }
      }
    },
    "device.performance.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every picture is one you asked for, and a recording is a bounded run of stills. Capturing raises the device's load while it runs, so what you are watching can move with it. The rate shown is the one that was measured, never a promised one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张画面都是你要来的，录屏是一段有限的连拍。采集期间会抬高设备负载，你正在观察的东西可能随之变化。显示的帧率是实测值，不是承诺值。"
          }
        }
      }
    }
  }
}
