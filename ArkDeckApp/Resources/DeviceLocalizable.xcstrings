    "device.screen.empty.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopt exactly one device to use Device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管且仅接管一台设备后才能使用真机操作。"
          }
        }
      }
    },
    "device.screen.empty.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a screenshot to act on the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取一张截图后即可在其上操作设备。"
          }
        }
      }
    },
    "device.screen.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screenshot yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未获取截图"
          }
        }
      }
    },
    "device.stale.badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期"
          }
        }
      }
    },
    "device.stale.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent — this picture is out of date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送——这张画面已经过期"
          }
        }
      }
    },
    "device.stale.refused.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last gesture changed the device. Get a new screenshot before pressing again; a point picked on this one no longer means what it did."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一个手势已经改变了设备。再点之前先取一张新截图——在这张图上选的位置，已经不是它原来指的东西了。"
          }
        }
      }
    },
    "device.target.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无设备"
          }
        }
      }
    },
    "device.target.none.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device sends device mutations and will not guess which device you meant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真机操作会写设备，因此不会替你猜是哪一台。"
          }
        }
      }
    },
    "device.record.title": {
      "extractionState": "manual",
      "localizations": {
