{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "device.screen.picture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": { "state": "translated", "value": "Device screenshot" }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "设备截图" }
        }
      }
    },
    "device.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A still, not a live view. Each gesture is one typed operation; an unknown outcome is never resent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是静止画面，不是实时预览。每个手势都是一次 typed operation；结果未知时绝不重发。"
          }
        }
      }
    },
    "device.frame.age": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture taken"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面拍摄于"
          }
        }
      }
    },
    "device.frame.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无画面"
          }
        }
      }
    },
    "device.frame.unknownAge": {
      "extractionState": "manual",
      "localizations": {
