    "device.gestures.longPress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for half a second to send a long press."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住半秒以上，发送一次长按。"
          }
        }
      }
    },
    "device.gestures.swipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to send a swipe; the time you held it is the swipe's duration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动发送一次滑动；你按住的时长就是滑动时长。"
          }
        }
      }
    },
    "device.gestures.tap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the picture to send a tap at that point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击画面，在该点发送一次点击。"
          }
        }
      }
    },
