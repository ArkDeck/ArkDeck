    "viewer.empty.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture View creates a typed Runtime Job and shows only verified, same-Job Artifacts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「抓取视图」会创建一个 typed Runtime Job，并且只展示同一个 Job 里通过校验的 Artifact。"
          }
        }
      }
    },
