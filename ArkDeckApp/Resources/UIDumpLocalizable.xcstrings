    "uiDump.blocker.component": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid decimal component ID for Component detail."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请为组件详情输入有效的十进制组件 ID。"}}}},
    "uiDump.blocker.persistConfirmation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm the persistent debug-parameter impact."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认永久启用调试参数的影响。"}}}},
    "uiDump.blocker.readOnlyTransport": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This App build has a read-only Runtime transport and cannot create a Job."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前 App 构建只有只读 Runtime 通道，无法创建 Job。"}}}},
    "uiDump.blocker.recipeInputs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"capture.diagnostics@1 lacks the accepted window-scoped recipe inputs."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"capture.diagnostics@1 缺少已接受的窗口级配方输入。"}}}},
    "uiDump.blocker.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an adopted target with a complete binding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择具有完整绑定的已接管目标。"}}}},
    "uiDump.blocker.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The production Runtime operation is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生产 Runtime 操作不可用。"}}}},
    "uiDump.blocker.window": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an inventory row or enter a valid decimal window ID."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择窗口清单行，或输入有效的十进制窗口 ID。"}}}},
    "uiDump.component.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Decimal digits only; options and command text are rejected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只能输入十进制数字；选项和命令文本会被拒绝。"}}}},
