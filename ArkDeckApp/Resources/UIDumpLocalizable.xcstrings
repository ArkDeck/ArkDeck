    "uiDump.inventory.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a parsed WindowManagerService row when available. A parse failure must preserve raw output."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用时请选择 WindowManagerService 解析行；解析失败必须保留原始输出。"}}}},
    "uiDump.inventory.notLoaded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No window inventory has been loaded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未加载窗口清单"}}}},
    "uiDump.inventory.raw.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Runtime response. This is not an empty device inventory."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有 Runtime 响应；这不代表设备窗口清单为空。"}}}},
    "uiDump.inventory.raw.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw WindowManagerService response"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"WindowManagerService 原始响应"}}}},
    "uiDump.inventory.refresh": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh inventory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新窗口清单"}}}},
    "uiDump.inventory.refreshBlocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Inventory refresh is locked because the App exposes no reviewed diagnostics submission path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"窗口清单刷新已锁定，因为 App 尚无经审查的诊断提交通道。"}}}},
    "uiDump.inventory.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Window inventory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"窗口清单"}}}},
    "uiDump.jobs.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Existing diagnostics Jobs are shown read-only. Controls on this page cannot resume, cancel or retry them."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有诊断 Job 仅供读取；本页面无法恢复、取消或重试。"}}}},
    "uiDump.jobs.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Related Runtime Jobs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"相关 Runtime Job"}}}},
    "uiDump.policy.mutation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DEVICE MUTATION"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备变更"}}}},
    "uiDump.policy.originalUnknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original debug-parameter value is not readable through the current App facade. Temporary enable-and-restore remains unavailable rather than guessing a restore value."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前 App facade 无法读取原始调试参数值。临时启用并恢复保持不可用，不会猜测恢复值。"}}}},
    "uiDump.policy.persist.confirm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I understand this keeps the debug parameter enabled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我了解这会让调试参数保持启用"}}}},
    "uiDump.policy.persist.confirmDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A second explicit confirmation is required before persistent mutation may be reviewed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审核永久变更前需要第二次明确确认。"}}}},
    "uiDump.policy.readOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"UNCHANGED"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持不变"}}}},
    "uiDump.policy.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose how the device debug parameter should be treated; unsafe restore guesses are disabled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择设备调试参数处理方式；不安全的恢复猜测已禁用。"}}}},
    "uiDump.policy.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Debug parameter policy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调试参数策略"}}}},
    "uiDump.policy.unchanged.name": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Leave unchanged"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持不变"}}}},
    "uiDump.policy.unchanged.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Do not read or modify the debug parameter. Capture may fail if the device is not already configured."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不读取或修改调试参数；若设备尚未配置，采集可能失败。"}}}},
    "uiDump.policy.temporaryRestore.name": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable temporarily, then restore"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"临时启用后恢复"}}}},
    "uiDump.policy.temporaryRestore.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Available only when the original value is readable and writable, so the exact value can be restored."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅在原始值可读且可写时可用，以便准确恢复。"}}}},
    "uiDump.policy.persistentlyEnabled.name": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep enabled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持启用"}}}},
    "uiDump.policy.persistentlyEnabled.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Persist the debug setting after capture. This is a device mutation and requires a second confirmation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集后继续保持调试设置；这是设备变更，需要第二次确认。"}}}},
    "uiDump.recipe.candidate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CANDIDATE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"候选"}}}},
    "uiDump.recipe.candidateNote": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Argument mappings are accepted candidates, not verified device compatibility claims. Runtime integration must pin them before execution."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数映射是已接受候选，不代表已验证设备兼容性；执行前必须由 Runtime 集成固定。"}}}},
    "uiDump.recipe.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose one canonical recipe. There is no free-form command field."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只能选择一个规范配方；不提供自由命令输入。"}}}},
