    "uiDump.availability.recipeGap": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The published operation does not expose recipeId, windowId or componentId. Candidate recipes can be reviewed here, but they cannot be lowered or submitted by this App build."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已发布操作未暴露 recipeId、windowId 或 componentId。本页面可审核候选配方，但当前 App 无法将其 lowering 或提交。"}}}},
