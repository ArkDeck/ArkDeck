    "device.record.ceiling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device offers no recorder, so this is a run of stills composed here. About 1.8 a second is what its display readback allows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没有录屏接口，这是在本机把一串静止画面合成出来的。它的显示回读只允许约每秒 1.8 帧。"
          }
        }
      }
    },
    "device.record.timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames are laid out at the spacing they were taken at, not at an average."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各帧按实际拍摄间距排布，不是按平均值。"
          }
        }
      }
    },
    "device.record.noRoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough room to keep this recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放不下这段录屏"
          }
        }
      }
    },
    "device.record.noRoom.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The artifact store refuses a new recording rather than deleting one you already have."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "制品库会拒绝新录屏，而不是删掉你已有的那一段。"
          }
        }
      }
    },
    "device.record.wouldFit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "would fit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放得下"
          }
        }
      }
    },
    "device.record.needs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "needs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要"
          }
        }
      }
    },
    "device.record.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "free"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余"
          }
        }
      }
    },
    "device.record.headroomUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the artifact store's remaining room, so this run was not checked against it. The runtime still refuses a recording it cannot keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不到制品库剩余空间，这次运行没有对它做检查。运行时仍会拒绝一段它存不下的录屏。"
          }
        }
      }
    },
    "device.performance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture affects device load"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图会影响设备负载"
          }
        }
      }
    },
    "device.performance.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview and recording add device load. Stop capture before measuring baseline performance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览和录屏都会增加设备负载。测量基线性能前请停止采集。"
          }
        }
      }
    },
