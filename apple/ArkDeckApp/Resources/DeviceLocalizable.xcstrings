    "device.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview refreshes still images. Each gesture is one typed operation; an unknown outcome is never resent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览按次刷新静止画面。每个手势都是一次 typed operation；结果未知时绝不重发。"
          }
        }
      }
    },
    "device.frame.age": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
