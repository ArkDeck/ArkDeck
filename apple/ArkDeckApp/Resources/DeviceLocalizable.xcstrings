{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "device.keyboard.focus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move pointer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动指针"
          }
        }
      }
    },
    "device.keyboard.swipeEnd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to pointer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动到指针"
          }
        }
      }
    },
    "device.keyboard.swipeStart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set swipe start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置滑动起点"
          }
        }
      }
    },
    "device.keyboard.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus the picture with Tab. Arrows move the pointer; Shift moves faster. Return or Space taps; Option-Return holds. Shift-Return sets a swipe start, then sends at the new position. Escape clears the start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Tab 聚焦画面。方向键移动指针，Shift 加速；回车或空格点击，Option-回车长按；Shift-回车设置滑动起点，移动后再按一次发送；Esc 清除起点。"
          }
        }
      }
    },
    "device.keyboard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device keyboard pointer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备键盘指针"
          }
        }
      }
    },
    "device.preview.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 60 seconds / 30 frames, with 2 seconds between captures. Stop preview before sending input or recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 60 秒／30 帧，每次截图间隔 2 秒。操作设备或录屏前请停止预览。"
          }
        }
      }
    },
    "device.preview.contextChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview stopped · device or binding changed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览已停止 · 设备或绑定发生变化"
          }
        }
      }
    },
    "device.preview.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview finished · 60 seconds or 30 frames reached"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览结束 · 已达 60 秒或 30 帧上限"
          }
        }
      }
    },
    "device.preview.stopping": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping · waiting for the current capture"
          }
