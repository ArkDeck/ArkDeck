{
  "schemaVersion": "1.0.0",
  "id": "workspace.build-openharmony",
  "version": 1,
  "title": "Build through an exact repository-managed ProjectProfile preset",
  "provider": "workspace",
  "effect": {
    "minimum": "deviceMutation",
    "permitted": [
      "deviceMutation"
    ]
  },
  "authorization": {
    "deviceMutation": "standingCapability"
  },
  "binding": "none",
  "concurrencyKey": "host-exclusive",
  "inputs": {
    "fields": {
      "projectRef": {
        "type": "string",
        "required": true,
        "maxLength": 128,
        "description": "Registered workspace project. This build ships `demo-app` and `ArkDeck`; which one a host offers depends on how its daemon was configured."
      },
      "buildPresetRef": {
        "type": "string",
        "required": true,
        "maxLength": 128,
        "description": "Build preset within that project's profile: `waterflow-debug` for `demo-app`, `arkdeck-debug` for `ArkDeck`. The preset owns the executable and every argument; the request selects one and supplies none."
      },
      "expectedWorkspaceRevision": {
        "type": "string",
        "required": false,
        "maxLength": 128,
        "description": "Workspace revision the caller decided against; the provider refuses if the tree moved."
      }
    }
  },
  "outputs": {
    "fields": {
      "buildLog": {
        "type": "artifactReference",
        "required": true
      },
      "unsignedHap": {
        "type": "artifactReference",
        "required": false,
        "description": "Immutable HAP when the selected ProjectProfile declares a build product."
      }
    }
  },
  "steps": [
    {
      "stepID": "build-project",
      "kind": "buildWorkspaceOpenHarmony",
      "effect": "deviceMutation",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 900,
  "outputByteBudget": 134217728,
  "retry": {
    "preflightAttempts": 1,
    "mutationAttempts": 1
  },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    {
      "name": "build.log",
      "role": "log",
      "mediaType": "text/plain",
      "privacy": "standard",
      "required": true
    },
    {
      "name": "unsigned.hap",
      "role": "derived",
      "mediaType": "application/vnd.openharmony.hap",
      "privacy": "standard",
      "required": false,
      "retentionClass": "pinnedUntilVerified"
    }
  ],
  "profiles": [
    "workspace-host@1"
  ],
  "defaultPolicyIssuance": "disabled"
}
