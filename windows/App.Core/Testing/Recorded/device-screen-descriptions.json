        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
        "required": false,
        "type": "string"
      },
      {
        "default": true,
        "description": "Capture the bounded HiLog artifact. Set false for a typed UI snapshot that needs the component tree and PNG but not diagnostic logs.",
        "name": "captureHilog",
        "required": false,
        "type": "boolean"
      },
      {
        "description": "Validated ArkUI accessibility/component identifier used only by the componentDetail recipe.",
        "maxLength": 20,
        "name": "componentId",
        "pattern": "^[0-9]{1,20}$",
        "required": false,
        "type": "string"
      },
      {
        "description": "One Faultlogger entry to fetch, named exactly as the index lists it. An entry name, never a path.",
        "maxLength": 200,
        "name": "crashLogName",
        "pattern": "^[a-z]+-[A-Za-z0-9._-]{1,180}$",
        "required": false,
        "type": "string"
      },
      {
        "default": false,
        "description": "Capture the device's Faultlogger index. Read-only: unlike the trace, tree and screenshot legs this does not raise the effective effect.",
        "name": "crashLogs",
        "required": false,
        "type": "boolean"
      },
      {
        "description": "Bounded HiLog capture window.",
        "maximum": 600,
        "minimum": 1,
        "name": "durationSeconds",
        "required": true,
        "type": "integer"
      },
      {
        "description": "Caller-supplied expected digest of the deployment whose liveness is being sampled. Recorded with the observation so a later reader can tell which build was live; it is not trusted as a fact about the device.",
        "maxLength": 64,
        "name": "expectedDeployedArtifactDigest",
        "pattern": "^[0-9a-f]{64}$",
        "required": false,
        "type": "string"
      },
      {
        "description": "Typed HiLog filter expressions; no shell fragments.",
        "maxItems": 16,
        "maxLength": 200,
        "name": "hilogFilters",
        "required": false,
        "type": "stringArray"
      },
      {
        "description": "Host-side marks collected during the captured window, each an RFC 3339 instant with an optional `#label`. They reach no device: a mark is an annotation on host time, and the capture only carries it into `markers.json` so a reader can line it up with what the device recorded.",
        "maxItems": 200,
        "maxLength": 96,
        "name": "markers",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z(#[A-Za-z0-9 ._-]{1,64})?$",
        "required": false,
        "type": "stringArray"
      },
      {
        "description": "Optional process identity. Defaults to bundleName and is lowered only by the HDC provider.",
        "maxLength": 200,
        "name": "processName",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:]*$",
        "required": false,
        "type": "string"
      },
      {
        "default": "standard",
        "description": "Redaction applied to published text. This field is retained as a forward-compatible policy dimension, but currently has one executable value: `standard`. Stronger redaction is not published until its implementation exists.",
        "enum": [
          "standard"
        ],
        "name": "redactionProfile",
        "required": false,
        "type": "string"
      },
      {
        "default": false,
        "description": "Arm the trace ring, let the window pass, then snapshot it, instead of blocking for the window with `-t N`. The snapshot carries everything since the arm, bounded by the buffer, so the decision to keep a trace can be made after the thing worth keeping rather than before it. Only consulted when traceCategories selects the trace leg.",
        "name": "ringBuffered",
        "required": false,
        "type": "boolean"
      },
      {
        "default": "png",
        "description": "Encoding for the screenshot leg. PNG is the evidence format and stays the default; JPEG is measurably cheaper - p50 638 ms against 858 ms and 40,947 bytes against 448,352, over 50 captures each on 2026-08-26 - and is for work that wants a current picture rather than a record. The device validates the file suffix against this, so the type and the owned path are one decision.",
