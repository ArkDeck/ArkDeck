<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSTest, run with `dotnet test` (plain MSTest: no packaged WinUI test host, see SPK-4). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkDeck.ClientKit.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientKit\ArkDeck.ClientKit.csproj" />
  </ItemGroup>
</Project>
