{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkdeck.dev/schemas/manifest-1.0.0.json",
  "title": "ArkDeck Session Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appVersion",
    "coreSpecBaseline",
    "platformProfile",
    "sessionId",
    "jobId",
    "status",
    "executionMode",
    "executionAuthority",
    "outcomeCertainty",
    "sessionDisposition",
    "createdAt",
    "completedAt",
    "archivedAt",
    "originalTarget",
    "bindingHistory",
    "toolchain",
    "workflow",
    "steps",
    "parameters",
    "compensations",
    "confirmations",
    "artifacts",
    "warnings",
    "failure",
    "recovery"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "appVersion": { "type": "string", "minLength": 1 },
    "coreSpecBaseline": { "type": "string", "pattern": "^CORE-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "platformProfile": { "type": "string", "minLength": 1 },
    "sessionId": { "$ref": "#/$defs/id" },
    "jobId": { "$ref": "#/$defs/id" },
    "status": {
      "enum": ["planned", "succeeded", "failed", "cancelled", "interrupted"]
    },
    "executionMode": {
      "enum": ["execute", "planOnly", "simulated"]
    },
    "executionAuthority": {
      "enum": ["interactiveUser", "standardAgent", "controlledHardwareLab"]
    },
    "outcomeCertainty": {
      "enum": ["confirmed", "outcomeUnknown", "mixed"]
    },
    "sessionDisposition": {
      "enum": ["finalized", "archived"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" },
    "originalTarget": { "$ref": "#/$defs/target" },
    "bindingHistory": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "runtimeAuthority": { "oneOf": [{ "$ref": "#/$defs/runtimeAuthority" }, { "type": "null" }] },
    "workflow": { "$ref": "#/$defs/workflow" },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "https://arkdeck.dev/schemas/workflow-step-1.0.0.json#/$defs/executionRecord"
      }
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "compensations": {
      "type": "array",
      "items": { "$ref": "#/$defs/compensationRecord" }
    },
    "confirmations": {
      "type": "array",
      "items": { "$ref": "#/$defs/confirmation" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "failure": {
      "oneOf": [
        { "$ref": "#/$defs/failure" },
        { "type": "null" }
      ]
    },
    "recovery": {
      "oneOf": [
        { "$ref": "#/$defs/recovery" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "not": { "$ref": "#/$defs/consumedRuntimeAuthority" },
        "properties": { "executionAuthority": { "const": "standardAgent" } },
        "required": ["executionAuthority"]
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "if": {
                "properties": { "effect": { "const": "destructive" } },
                "required": ["effect"]
              },
              "then": {
                "properties": {
                  "disposition": { "enum": ["notExecuted(planned)", "skipped"] },
                  "outcomeCertainty": { "const": "notApplicable" },
                  "semanticResult": { "const": "notRun" }
                }
              }
            }
          },
          "compensations": {
            "items": {
              "if": {
                "properties": {
                  "descriptor": {
                    "properties": { "effect": { "const": "destructive" } },
                    "required": ["effect"]
                  }
                },
                "required": ["descriptor"]
              },
              "then": {
                "properties": {
                  "disposition": { "const": "notRun" },
                  "outcomeCertainty": { "const": "notApplicable" },
                  "result": { "const": "notRun" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": { "$ref": "#/$defs/consumedRuntimeAuthority" },
        "allOf": [
          {
            "properties": {
              "executionAuthority": { "const": "standardAgent" },
              "executionMode": { "const": "execute" }
            },
            "required": ["executionAuthority", "executionMode"]
          },
          {
            "properties": {
              "steps": {
                "contains": {
                  "properties": { "effect": { "const": "destructive" } },
                  "required": ["effect"]
                }
              }
            },
            "required": ["steps"]
          }
        ]
      },
      "then": {
        "properties": { "status": { "not": { "const": "succeeded" } } }
      }
    },
    {
      "if": {
        "properties": { "executionMode": { "const": "simulated" } },
        "required": ["executionMode"]
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "if": {
                "properties": { "effect": { "const": "destructive" } },
                "required": ["effect"]
              },
              "then": {
                "properties": {
                  "disposition": { "enum": ["notExecuted(planned)", "skipped"] },
                  "outcomeCertainty": { "const": "notApplicable" },
                  "semanticResult": { "const": "notRun" }
                }
              }
            }
          },
          "originalTarget": {
            "allOf": [
              { "$ref": "#/$defs/target" },
              {
                "properties": {
                  "kind": { "const": "synthetic" },
                  "transport": { "const": "synthetic" },
                  "connectKey": { "type": "null" }
                }
              }
            ]
          },
          "bindingHistory": {
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/binding" },
                {
                  "properties": {
                    "connectKey": { "type": "null" },
                    "transport": { "const": "synthetic" },
                    "confirmedBy": { "const": "simulation" },
                    "channelProtection": { "const": "notApplicable" }
                  }
                }
              ]
            }
          },
          "toolchain": {
            "allOf": [
              { "$ref": "#/$defs/toolchain" },
              { "properties": { "kind": { "const": "none" } } }
            ]
          },
          "workflow": {
            "allOf": [
              { "$ref": "#/$defs/workflow" },
              {
                "required": ["fixtureIdentity", "scenarioIdentity"],
                "properties": {
                  "fixtureIdentity": { "type": "string", "minLength": 1 },
                  "scenarioIdentity": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      },
      "else": {
        "if": {"properties": {"originalTarget": {"properties": {"kind": {"const": "host"}}, "required": ["kind"]}}},
        "then": {
          "properties": {
            "originalTarget": {"properties": {"connectKey": {"type": "null"}, "transport": {"const": "host"}}},
            "bindingHistory": {"maxItems": 0},
            "toolchain": {"properties": {"kind": {"enum": ["none", "hostTool"]}}}
          },
          "anyOf": [
            {"properties": {"runtimeAuthority": false, "steps": {"items": {"properties": {"effect": {"const": "hostOnly"}, "bindingRequirement": {"const": "none"}}}}}},
            {"$ref": "#/$defs/hostWorkspaceMutation"}
          ]
        },
        "else": {
        "properties": {
          "originalTarget": {
            "allOf": [
              { "$ref": "#/$defs/target" },
              {
                "properties": {
                  "kind": { "const": "real" },
                  "transport": { "enum": ["usb", "tcp", "uart"] },
                  "connectKey": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "bindingHistory": {
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/binding" },
                {
                  "properties": {
                    "connectKey": { "type": "string", "minLength": 1 },
                    "transport": { "enum": ["usb", "tcp", "uart"] },
                    "confirmedBy": { "enum": ["corePolicy", "user"] },
                    "channelProtection": { "enum": ["encryptedVerified", "unverifiedAssumeUnprotected"] }
                  }
                }
              ]
            }
          },
          "toolchain": {
            "allOf": [
              { "$ref": "#/$defs/toolchain" },
              { "properties": { "kind": { "enum": ["hdc", "runtimeProvider"] } } }
            ]
          }
        }
        }
      }
    },
    {
      "if": {
        "properties": { "executionMode": { "const": "planOnly" } },
        "required": ["executionMode"]
      },
      "then": {
        "properties": {
          "status": { "not": { "const": "succeeded" } },
          "steps": {
            "items": {
              "if": {
                "properties": { "effect": { "enum": ["deviceMutation", "destructive"] } },
                "required": ["effect"]
              },
              "then": {
                "properties": {
                  "disposition": { "enum": ["notExecuted(planned)", "skipped"] },
                  "outcomeCertainty": { "const": "notApplicable" },
                  "semanticResult": { "const": "notRun" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "planned" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "executionMode": { "const": "planOnly" },
          "outcomeCertainty": { "const": "confirmed" },
          "failure": { "type": "null" },
          "recovery": { "type": "null" },
          "steps": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "disposition": { "not": { "const": "outcomeUnknown" } },
                    "outcomeCertainty": { "not": { "const": "outcomeUnknown" } }
                  }
                },
                {
                  "if": {
                    "properties": { "effect": { "enum": ["deviceMutation", "destructive"] } },
                    "required": ["effect"]
                  },
                  "then": {
                    "properties": {
                      "disposition": { "enum": ["notExecuted(planned)", "skipped"] },
                      "outcomeCertainty": { "const": "notApplicable" },
                      "semanticResult": { "const": "notRun" }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outcomeCertainty": { "const": "confirmed" },
          "failure": { "type": "null" },
          "recovery": { "type": "null" },
          "steps": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "disposition": { "not": { "const": "outcomeUnknown" } },
                    "outcomeCertainty": { "not": { "const": "outcomeUnknown" } }
                  }
                },
                {
                  "not": {
                    "properties": { "semanticResult": { "enum": ["failed", "unknown"] } },
                    "required": ["semanticResult"]
                  }
                }
              ]
            }
          },
          "compensations": {
            "items": {
              "not": {
                "properties": { "result": { "enum": ["failed", "unknown"] } },
                "required": ["result"]
              }
            }
          },
          "parameters": {
            "items": {
              "not": {
                "properties": { "restoreDisposition": { "enum": ["failed", "outcomeUnknown"] } },
                "required": ["restoreDisposition"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outcomeCertainty": { "const": "confirmed" },
          "failure": { "$ref": "#/$defs/failure" },
          "steps": {
            "items": {
              "properties": {
                "disposition": { "not": { "const": "outcomeUnknown" } },
                "outcomeCertainty": { "not": { "const": "outcomeUnknown" } },
                "semanticResult": { "not": { "const": "unknown" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "cancelled" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outcomeCertainty": { "const": "confirmed" },
          "failure": { "type": "null" },
          "steps": {
            "items": {
              "properties": {
                "disposition": { "not": { "const": "outcomeUnknown" } },
                "outcomeCertainty": { "not": { "const": "outcomeUnknown" } },
                "semanticResult": { "not": { "const": "unknown" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "interrupted" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "recovery": {
            "allOf": [
              { "$ref": "#/$defs/recovery" },
              {
                "required": ["interruptedReason", "abandonAuditEventIds", "userConfirmation"],
                "properties": {
                  "interruptedReason": { "type": "string", "minLength": 1 },
                  "needsAttention": { "const": true },
                  "abandonAuditEventIds": { "minItems": 1 },
                  "userConfirmation": { "$ref": "#/$defs/abandonConfirmation" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "sessionDisposition": { "const": "archived" } },
        "required": ["sessionDisposition"]
      },
      "then": {
        "properties": { "archivedAt": { "type": "string", "format": "date-time" } }
      },
      "else": {
        "properties": { "archivedAt": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {"toolchain": {"properties": {"kind": {"const": "runtimeProvider"}}, "required": ["kind"]}},
        "required": ["toolchain"]
      },
      "then": {
        "required": ["runtimeAuthority"],
        "properties": {"executionMode": {"const": "execute"}},
        "allOf": [
          {
            "if": {"properties": {"runtimeAuthority": {"type": "object", "properties": {"kind": {"const": "defaultReadOnlyPolicy"}}}}},
            "then": {
              "properties": {
                "steps": {"items": {"properties": {"effect": {"not": {"enum": ["deviceMutation", "destructive"]}}}}},
                "compensations": {
                  "items": {
                    "properties": {
                      "descriptor": {"properties": {"effect": {"not": {"enum": ["deviceMutation", "destructive"]}}}}
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"runtimeAuthority": {"type": "null"}}},
            "then": {
              "properties": {
                "status": {"enum": ["failed", "cancelled"]},
                "outcomeCertainty": {"const": "confirmed"},
                "steps": {"items": {"properties": {
                  "effect": {"enum": ["hostOnly", "readOnly"]},
                  "compensationDescriptors": {"maxItems": 0}
                }}},
                "compensations": {"maxItems": 0}
              }
            }
          }
        ]
      },
      "else": {
        "if": {"required": ["runtimeAuthority"]},
        "then": {"$ref": "#/$defs/hostWorkspaceMutation"}
      }
    }
  ],
  "$defs": {
    "hostWorkspaceMutation": {
      "required": [
        "runtimeAuthority"
      ],
      "properties": {
        "executionMode": {
          "const": "execute"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "outcomeCertainty": {
          "const": "confirmed"
        },
        "originalTarget": {
          "properties": {
            "kind": {
              "const": "host"
            },
            "connectKey": {
              "type": "null"
            },
            "transport": {
              "const": "host"
            },
            "identitySnapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workspaceScope",
                "projectRef",
                "providerId",
                "catalogDigest"
              ],
              "properties": {
                "workspaceScope": {
                  "type": "string",
                  "minLength": 1
                },
                "projectRef": {
                  "type": "string",
                  "minLength": 1
                },
                "providerId": {
                  "const": "workspace"
                },
                "catalogDigest": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        "bindingHistory": {
          "maxItems": 0
        },
        "toolchain": {
          "properties": {
            "kind": {
              "const": "hostTool"
            },
            "providerIdentity": {
              "const": "workspace"
            }
          }
        },
        "runtimeAuthority": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "runtimeCapability"
            },
            "targetBindingDigest": {
              "const": "f1e9946b2370d1e7acc9363ca0f7a81b52e966edf80a1456e1cf392294073025"
            }
          }
        },
        "workflow": {
          "properties": {
            "providerIdentity": {
              "const": "workspace"
            }
          }
        },
        "steps": {
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "properties": {
              "effect": {
                "const": "deviceMutation"
              },
              "bindingRequirement": {
                "const": "none"
              },
              "bindingRevision": {
                "type": "null"
              },
              "sourceStepId": {
                "type": "null"
              },
              "compensationTrigger": {
                "type": "null"
              },
              "compensationDescriptors": {
                "maxItems": 0
              }
            }
          }
        },
        "compensations": {
          "maxItems": 0
        }
      },
      "oneOf": [
        {
          "properties": {
            "workflow": {
              "properties": {
                "kind": {
                  "const": "workspace.apply-patch@1"
                }
              }
            },
            "toolchain": {
              "properties": {
                "profileIdentifier": {
                  "const": "workspace.apply-patch@1"
                }
              }
            },
            "steps": {
              "items": {
                "properties": {
                  "id": {
                    "const": "apply-patch"
                  },
                  "kind": {
                    "const": "applyWorkspacePatch"
                  },
                  "cancellation": {
                    "const": "atSafeBoundary"
                  },
                  "arguments": {
                    "required": [
                      "projectRef",
                      "patchArtifactId",
                      "patchSha256",
                      "allowedFileGlobs",
                      "patchAttemptRef"
                    ],
                    "properties": {
                      "patchSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            },
            "runtimeAuthority": {
              "properties": {
                "stepSetDigest": {
                  "const": "6886b49a4248c695ee8a3d0ddfdd9ed6ed3e450cb818f3ff4cb9e1d90b97ff75"
                },
                "artifactDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        {
          "properties": {
            "workflow": {
              "properties": {
                "kind": {
                  "const": "workspace.revert-patch@1"
                }
              }
            },
            "toolchain": {
              "properties": {
                "profileIdentifier": {
                  "const": "workspace.revert-patch@1"
                }
              }
            },
            "runtimeAuthority": {
              "properties": {
                "artifactDigest": {
                  "type": "null"
                },
                "stepSetDigest": {
                  "const": "2eed7741a92130d3306a399a2720f0ac7e937e7e34b7dfb9784740eb5b3de181"
                }
              }
            },
            "steps": {
              "items": {
                "properties": {
                  "id": {
                    "const": "revert-patch"
                  },
                  "kind": {
                    "const": "revertWorkspacePatch"
                  },
                  "cancellation": {
                    "const": "atSafeBoundary"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "workflow": {
              "properties": {
                "kind": {
                  "const": "workspace.build-openharmony@1"
                }
              }
            },
            "toolchain": {
              "properties": {
                "profileIdentifier": {
                  "const": "workspace.build-openharmony@1"
                }
              }
            },
            "runtimeAuthority": {
              "properties": {
                "artifactDigest": {
                  "type": "null"
                },
                "stepSetDigest": {
                  "const": "bbc856fb281f21642645b7d0fa0b62486e1e0e5c540bcfacf1d868808fc5a3ad"
                }
              }
            },
            "steps": {
              "items": {
                "properties": {
                  "id": {
                    "const": "build-project"
                  },
                  "kind": {
                    "const": "buildWorkspaceOpenHarmony"
                  },
                  "cancellation": {
                    "const": "immediate"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "workflow": {
              "properties": {
                "kind": {
                  "const": "workspace.create-checkpoint@1"
                }
              }
            },
            "toolchain": {
              "properties": {
                "profileIdentifier": {
                  "const": "workspace.create-checkpoint@1"
                }
              }
            },
            "runtimeAuthority": {
              "properties": {
                "artifactDigest": {
                  "type": "null"
                },
                "stepSetDigest": {
                  "const": "78d0982a8f4e4aa69f2c7e411abcf3fb2938c3ecb6da43d97893df3339961843"
                }
              }
            },
            "steps": {
              "items": {
                "properties": {
                  "id": {
                    "const": "create-checkpoint"
                  },
                  "kind": {
                    "const": "createWorkspaceCheckpoint"
                  },
                  "cancellation": {
                    "const": "atSafeBoundary"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "workflow": {
              "properties": {
                "kind": {
                  "const": "workspace.run-tests@1"
                }
              }
            },
            "toolchain": {
              "properties": {
                "profileIdentifier": {
                  "const": "workspace.run-tests@1"
                }
              }
            },
            "runtimeAuthority": {
              "properties": {
                "artifactDigest": {
                  "type": "null"
                },
                "stepSetDigest": {
                  "const": "f0e8781789b7dc6742baa1b32ea206f77640432fc48133c79e3bf2f3fa0c8ebe"
                }
              }
            },
            "steps": {
              "items": {
                "properties": {
                  "id": {
                    "const": "run-tests"
                  },
                  "kind": {
                    "const": "runWorkspaceTests"
                  },
                  "cancellation": {
                    "const": "immediate"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))(?!.*[. ](?:/|$))[^\\u0000-\\u001F\\u007F<>:\"/\\\\|?*]+(?:/[^\\u0000-\\u001F\\u007F<>:\"/\\\\|?*]+)*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connectKey", "transport", "identitySnapshot"],
      "properties": {
        "kind": { "enum": ["real", "synthetic", "host"] },
        "connectKey": { "type": ["string", "null"] },
        "transport": { "enum": ["usb", "tcp", "uart", "synthetic", "host"] },
        "identitySnapshot": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "connectKey", "transport", "identitySnapshot", "evidence", "confirmedBy", "channelProtection"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "connectKey": { "type": ["string", "null"] },
        "transport": { "enum": ["usb", "tcp", "uart", "synthetic"] },
        "identitySnapshot": {
          "type": "object",
          "minProperties": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confirmedBy": { "enum": ["corePolicy", "user", "simulation"] },
        "channelProtection": { "enum": ["encryptedVerified", "unverifiedAssumeUnprotected", "notApplicable"] }
      }
    },
    "consumedRuntimeAuthority": {
      "anyOf": [
      {
      "properties": {
        "toolchain": {"properties": {"kind": {"const": "runtimeProvider"}}, "required": ["kind"]},
        "runtimeAuthority": {"type": "object", "properties": {"kind": {"const": "runtimeCapability"}}, "required": ["kind"]}
      },
      "required": ["toolchain", "runtimeAuthority"]
      },
      {"$ref": "#/$defs/hostWorkspaceMutation"}
      ]
    },
    "runtimeAuthority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "admittedAtUtc",
            "validUntilUtc",
            "consumptionFingerprintSha256",
            "reservationId",
            "useOrdinal",
            "planDigest",
            "stepSetDigest",
            "targetBindingDigest",
            "artifactDigest"
          ],
          "properties": {
            "kind": {"const": "defaultReadOnlyPolicy"},
            "reference": {"type": "string", "minLength": 1},
            "admittedAtUtc": {"type": "string", "format": "date-time"},
            "validUntilUtc": {"type": "null"},
            "consumptionFingerprintSha256": {"type": "null"},
            "reservationId": {"type": "null"},
            "useOrdinal": {"type": "null"},
            "planDigest": {"type": "null"},
            "stepSetDigest": {"type": "null"},
            "targetBindingDigest": {"type": "null"},
            "artifactDigest": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "admittedAtUtc",
            "validUntilUtc",
            "consumptionFingerprintSha256",
            "reservationId",
            "useOrdinal",
            "planDigest",
            "stepSetDigest",
            "targetBindingDigest",
            "artifactDigest"
          ],
          "properties": {
            "kind": {"const": "runtimeCapability"},
            "reference": {"type": "string", "minLength": 1},
            "admittedAtUtc": {"type": "string", "format": "date-time"},
            "validUntilUtc": {"type": "string", "format": "date-time"},
            "consumptionFingerprintSha256": {"$ref": "#/$defs/sha256"},
            "reservationId": {"type": "string", "minLength": 1},
            "useOrdinal": {"type": "integer", "minimum": 1},
            "planDigest": {"$ref": "#/$defs/sha256"},
            "stepSetDigest": {"$ref": "#/$defs/sha256"},
            "targetBindingDigest": {"$ref": "#/$defs/sha256"},
            "artifactDigest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          }
        }
      ]
    },
    "toolchain": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["hdc", "none"]},
            "source": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "clientVersion": {"type": "string", "minLength": 1},
            "serverVersion": {"type": "string", "minLength": 1},
            "daemonVersion": {"type": ["string", "null"]},
            "endpoint": {"type": "string", "minLength": 1},
            "serverGeneration": {"type": "integer", "minimum": 0},
            "serverOwnership": {"enum": ["external", "arkDeckManaged", "unknown"]}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "hdc"}}, "required": ["kind"]},
              "then": {
                "required": [
                  "source",
                  "path",
                  "sha256",
                  "clientVersion",
                  "serverVersion",
                  "endpoint",
                  "serverGeneration",
                  "serverOwnership"
                ]
              },
              "else": {
                "properties": {
                  "source": false,
                  "path": false,
                  "sha256": false,
                  "clientVersion": false,
                  "serverVersion": false,
                  "daemonVersion": false,
                  "endpoint": false,
                  "serverGeneration": false,
                  "serverOwnership": false
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "providerIdentity", "profileIdentifier", "reportedVersion", "sha256"],
          "properties": {
            "kind": {"const": "runtimeProvider"},
            "providerIdentity": {"enum": ["hdc", "arkforge"]},
            "profileIdentifier": {"type": "string", "minLength": 1},
            "reportedVersion": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "providerIdentity", "profileIdentifier", "reportedVersion", "sha256"],
          "properties": {
            "kind": {"const": "hostTool"},
            "providerIdentity": {"type": "string", "minLength": 1},
            "profileIdentifier": {"type": "string", "minLength": 1},
            "reportedVersion": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profileVersion", "providerIdentity"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "profileVersion": { "type": "string", "minLength": 1 },
        "providerIdentity": { "type": "string", "minLength": 1 },
        "fixtureIdentity": { "type": ["string", "null"] },
        "scenarioIdentity": { "type": ["string", "null"] }
      }
    },
    "parameterState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "missing" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unreadable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "value" },
            "value": { "type": "string", "maxLength": 4096 }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "beforeState", "desiredState", "afterState", "restoreState", "restoreDisposition"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,255}$" },
        "beforeState": { "$ref": "#/$defs/parameterState" },
        "desiredState": {
          "allOf": [
            { "$ref": "#/$defs/parameterState" },
            { "properties": { "state": { "const": "value" } } }
          ]
        },
        "afterState": { "$ref": "#/$defs/parameterState" },
        "restoreState": { "$ref": "#/$defs/parameterState" },
        "restoreDisposition": {
          "enum": ["notRequired", "restored", "persistentChangeAccepted", "failed", "outcomeUnknown"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "restoreDisposition": { "const": "restored" } },
            "required": ["restoreDisposition"]
          },
          "then": {
            "properties": {
              "beforeState": { "properties": { "state": { "const": "value" } } },
              "restoreState": { "properties": { "state": { "const": "value" } } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "beforeState": {
                "properties": { "state": { "enum": ["missing", "unreadable"] } },
                "required": ["state"]
              }
            },
            "required": ["beforeState"]
          },
          "then": {
            "properties": { "restoreDisposition": { "not": { "const": "restored" } } }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "summary"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "compensationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "sourceStepId", "disposition", "outcomeCertainty", "result", "failure", "journalEventIds"],
      "properties": {
        "descriptor": {
          "$ref": "https://arkdeck.dev/schemas/workflow-step-1.0.0.json#/$defs/compensationDescriptor"
        },
        "sourceStepId": { "$ref": "#/$defs/id" },
        "disposition": { "enum": ["executed", "notRun", "outcomeUnknown"] },
        "outcomeCertainty": { "enum": ["confirmed", "outcomeUnknown", "notApplicable"] },
        "result": { "enum": ["succeeded", "failed", "notRun", "unknown"] },
        "failure": {
          "oneOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "null" }
          ]
        },
        "journalEventIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "failed" } }, "required": ["result"] },
          "then": { "properties": { "failure": { "$ref": "#/$defs/failure" }, "outcomeCertainty": { "const": "confirmed" } } }
        },
        {
          "if": { "properties": { "result": { "const": "unknown" } }, "required": ["result"] },
          "then": { "properties": { "disposition": { "const": "outcomeUnknown" }, "outcomeCertainty": { "const": "outcomeUnknown" } } }
        },
        {
          "if": { "properties": { "result": { "const": "notRun" } }, "required": ["result"] },
          "then": { "properties": { "disposition": { "const": "notRun" }, "outcomeCertainty": { "const": "notApplicable" }, "failure": { "type": "null" } } }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationId", "kind", "scopeHash", "decision", "actor", "decidedAt", "relatedStepIds"],
      "properties": {
        "confirmationId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["deviceMutation", "destructive", "serverLifecycle", "recoveryAbandon", "securityBoundary"] },
        "scopeHash": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["accepted", "rejected"] },
        "actor": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "interactiveUser" } } },
        "decidedAt": { "type": "string", "format": "date-time" },
        "relatedStepIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "deviceMode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "unknown" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value", "evidence"],
          "properties": {
            "state": { "const": "known" },
            "value": { "type": "string", "minLength": 1, "maxLength": 128 },
            "evidence": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary", "severity", "outcomeCertainty"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["warning", "blocking", "possibleBrick"] },
        "outcomeCertainty": { "enum": ["confirmed", "outcomeUnknown"] }
      }
    },
    "recoveryGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerIdentity", "automaticRecoveryAvailable", "summary", "steps"],
      "properties": {
        "providerIdentity": { "type": "string", "minLength": 1 },
        "automaticRecoveryAvailable": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "abandonConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationId", "actor", "decision", "confirmedAt"],
      "properties": {
        "confirmationId": { "$ref": "#/$defs/id" },
        "actor": { "const": "user" },
        "decision": { "const": "archiveInterrupted" },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needsAttention",
        "interruptedReason",
        "deviceHazards",
        "abandonAuditEventIds",
        "lastConfirmedStepId",
        "lastDeviceMode",
        "managedHostProcessState",
        "recoveryGuide",
        "unexecutedCompensations",
        "userConfirmation",
        "recoveryOfSessionId",
        "recoveryOfJobId"
      ],
      "properties": {
        "needsAttention": { "type": "boolean" },
        "interruptedReason": { "type": ["string", "null"] },
        "deviceHazards": {
          "type": "array",
          "items": { "$ref": "#/$defs/hazard" }
        },
        "abandonAuditEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "lastConfirmedStepId": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "lastDeviceMode": { "$ref": "#/$defs/deviceMode" },
        "managedHostProcessState": {
          "enum": ["notStarted", "notRunning", "stoppedAtSafeBoundary", "stillRunningUnknown", "notApplicable"]
        },
        "recoveryGuide": { "$ref": "#/$defs/recoveryGuide" },
        "unexecutedCompensations": {
          "type": "array",
          "items": {
            "$ref": "https://arkdeck.dev/schemas/workflow-step-1.0.0.json#/$defs/compensationDescriptor"
          }
        },
        "userConfirmation": {
          "oneOf": [
            { "$ref": "#/$defs/abandonConfirmation" },
            { "type": "null" }
          ]
        },
        "recoveryOfSessionId": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "recoveryOfJobId": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "abandonAuditEventIds": { "minItems": 1 } },
            "required": ["abandonAuditEventIds"]
          },
          "then": { "properties": { "userConfirmation": { "$ref": "#/$defs/abandonConfirmation" } } }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "origin", "relativePath", "size", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["raw", "derived", "log", "plan", "diagnostic", "partial"] },
        "origin": { "type": "string", "minLength": 1 },
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": ["string", "null"] },
        "derivedFrom": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
