{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arkdeck://contracts/hardware-evidence/5.0.0",
  "title": "ArkDeck real-hardware evidence record (V5, CHG-2026-056 r5)",
  "description": "Records real-hardware evidence produced by a human or autonomous agent. Schema validity records provenance but never grants or widens RuntimeCapability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "executor",
    "targetConfirmation",
    "device",
    "toolchain",
    "transport",
    "provider",
    "effectLevel",
    "stepKinds",
    "acceptanceIds",
    "executedAt",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "5.0.0" },
    "evidenceId": { "type": "string", "pattern": "^EVD-[A-Z0-9._-]+$" },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human", "agent"] },
        "id": { "type": "string", "minLength": 1 },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {
              "enum": ["defaultReadOnlyPolicy", "runtimeCapability"]
            },
            "reference": { "type": "string", "minLength": 1 },
            "reservationId": { "type": "string", "minLength": 1 },
            "useOrdinal": { "type": "integer", "minimum": 1 },
            "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "stepSetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "targetBindingDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationReference",
        "jobId",
        "catalogDigest",
        "terminalState",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "operationReference": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
        },
        "jobId": { "type": "string", "minLength": 1 },
        "catalogDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "terminalState": {
          "enum": [
            "succeeded",
            "partial",
            "failed",
            "cancelled",
            "outcomeUnknown"
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "targetConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmedDeviceIdentitySHA256",
        "bindingRevision",
        "confirmedAt",
        "method"
      ],
      "properties": {
        "confirmedDeviceIdentitySHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingRevision": { "type": "integer", "minimum": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "method": { "enum": ["humanPhysical", "machineReadback"] }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "serialSHA256", "firmware", "bindingRevision"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "serialSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firmware": { "type": "string", "minLength": 1 },
        "bindingRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hdcVersion", "hdcSHA256"],
      "properties": {
        "hdcVersion": { "type": "string", "minLength": 1 },
        "hdcSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "otherTools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "transport": { "enum": ["usb", "tcp", "uart"] },
    "provider": { "type": "string", "minLength": 1 },
    "effectLevel": {
      "enum": ["hostOnly", "readOnly", "deviceMutation", "destructive"]
    },
    "stepKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$"
      }
    },
    "executedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "sha256"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": { "type": "string" }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "human" } },
            "required": ["kind"]
          }
        },
        "required": ["executor"]
      },
      "then": {
        "properties": {
          "executor": {
            "not": { "required": ["authority"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          }
        },
        "required": ["executor"]
      },
      "then": {
        "required": ["runtime"],
        "properties": {
          "executor": { "required": ["kind", "id", "authority"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "effectLevel": { "enum": ["hostOnly", "readOnly"] }
        },
        "required": ["executor", "effectLevel"]
      },
      "then": {
        "properties": {
          "executor": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "defaultReadOnlyPolicy" }
                },
                "required": ["kind", "reference"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "effectLevel": { "enum": ["deviceMutation", "destructive"] }
        },
        "required": ["executor", "effectLevel"]
      },
      "then": {
        "properties": {
          "executor": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "runtimeCapability" }
                },
                "required": ["kind", "reference"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "effectLevel": { "const": "destructive" }
        },
        "required": ["executor", "effectLevel"]
      },
      "then": {
        "properties": {
          "executor": {
            "properties": {
              "authority": {
                "required": [
                  "kind",
                  "reference",
                  "reservationId",
                  "useOrdinal",
                  "planDigest",
                  "stepSetDigest",
                  "targetBindingDigest",
                  "artifactDigest"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
