{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arkdeck://contracts/hardware-evidence/1.0.0",
  "title": "ArkDeck real-hardware evidence record (current v1)",
  "description": "Records real-hardware evidence and truthful complete-overwrite recovery lineage in the one current layout. The label is not a compatibility promise: a document must match this complete closed shape, and historical records with other labels or layouts stay as they are. Schema validity records provenance but never grants or widens RuntimeCapability or recovery coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "executor",
    "targetConfirmation",
    "device",
    "toolchain",
    "transport",
    "provider",
    "effectLevel",
    "stepKinds",
    "acceptanceIds",
    "executedAt",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "type": "string", "pattern": "^EVD-[A-Z0-9._-]+$" },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human", "agent"] },
        "id": { "type": "string", "minLength": 1 },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {
              "enum": ["defaultReadOnlyPolicy", "runtimeCapability"]
            },
            "reference": { "type": "string", "minLength": 1 },
            "reservationId": { "type": "string", "minLength": 1 },
            "useOrdinal": { "type": "integer", "minimum": 1 },
            "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "stepSetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "targetBindingDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationReference",
        "jobId",
        "catalogDigest",
        "terminalState",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "operationReference": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*(?:@[1-9][0-9]*)?$"
        },
        "jobId": { "type": "string", "minLength": 1 },
        "catalogDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "terminalState": {
          "enum": [
            "succeeded",
            "recovered",
            "partial",
            "failed",
            "cancelled",
            "outcomeUnknown"
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "targetConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmedDeviceIdentitySHA256",
        "bindingRevision",
        "confirmedAt",
        "method"
      ],
      "properties": {
        "confirmedDeviceIdentitySHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingRevision": { "type": "integer", "minimum": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "method": { "enum": ["humanPhysical", "machineReadback"] }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "serialSHA256", "firmware", "bindingRevision"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "serialSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firmware": { "type": "string", "minLength": 1 },
        "bindingRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hdcVersion", "hdcSHA256"],
      "properties": {
        "hdcVersion": { "type": "string", "minLength": 1 },
        "hdcSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "otherTools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "transport": { "enum": ["usb", "tcp", "uart"] },
    "provider": { "type": "string", "minLength": 1 },
    "effectLevel": {
      "enum": ["hostOnly", "readOnly", "deviceMutation", "destructive"]
    },
    "stepKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$"
      }
    },
    "executedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "sha256"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": { "type": "string" }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "epochId",
        "source",
        "coveredIntents",
        "uncertainEffectSetDigest",
        "coverageContractVersion",
        "coveredEffectSetDigest",
        "recoveryJobId",
        "recoveryIntentEventId",
        "operationReference",
        "profileReference",
        "planDigest",
        "artifactDigest",
        "providerExecutableDigest",
        "target",
        "confirmedStepIds",
        "postflight",
        "resultingTargetEpochDigest",
        "originalOutcomesRemainUnknown",
        "originalJobsSucceeded"
      ],
      "properties": {
        "disposition": { "const": "supersedingRecoveryEpoch" },
        "epochId": {
          "type": "string",
          "pattern": "^recovery-epoch-[0-9a-f]{32}$"
        },
        "source": {
          "enum": ["historicalRecognition", "distinctRecoveryExecution"]
        },
        "coveredIntents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "intentEventId",
              "operationReference",
              "profileReference",
              "possibleEffects"
            ],
            "properties": {
              "jobId": { "type": "string", "minLength": 1 },
              "intentEventId": { "type": "string", "minLength": 1 },
              "operationReference": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*(?:@[1-9][0-9]*)?$"
              },
              "profileReference": { "type": "string", "minLength": 1 },
              "possibleEffects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "uncertainEffectSetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverageContractVersion": { "type": "string", "minLength": 1 },
        "coveredEffectSetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recoveryJobId": { "type": "string", "minLength": 1 },
        "recoveryIntentEventId": { "type": "string", "minLength": 1 },
        "operationReference": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*(?:@[1-9][0-9]*)?$"
        },
        "profileReference": { "type": "string", "minLength": 1 },
        "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "providerExecutableDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stableIdentitySHA256",
            "bindingRevision",
            "confirmationMethod",
            "confirmedAt"
          ],
          "properties": {
            "stableIdentitySHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bindingRevision": { "type": "integer", "minimum": 1 },
            "confirmationMethod": { "const": "machineReadback" },
            "confirmedAt": { "type": "string", "format": "date-time" }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "reservationId", "useOrdinal"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "reservationId": { "type": "string", "minLength": 1 },
            "useOrdinal": { "type": "integer", "minimum": 1 }
          }
        },
        "confirmedStepIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "postflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flashReadbackConfirmed",
            "rebootConfirmed",
            "rebindConfirmed",
            "runtimeBuildConfirmed"
          ],
          "properties": {
            "flashReadbackConfirmed": { "const": true },
            "rebootConfirmed": { "const": true },
            "rebindConfirmed": { "const": true },
            "runtimeBuildConfirmed": { "const": true }
          }
        },
        "resultingTargetEpochDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "originalOutcomesRemainUnknown": { "const": true },
        "originalJobsSucceeded": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": { "const": "distinctRecoveryExecution" }
            },
            "required": ["source"]
          },
          "then": { "required": ["capability"] }
        },
        {
          "if": {
            "properties": {
              "source": { "const": "historicalRecognition" }
            },
            "required": ["source"]
          },
          "then": { "not": { "required": ["capability"] } }
        }
      ]
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "human" } },
            "required": ["kind"]
          }
        },
        "required": ["executor"]
      },
      "then": {
        "properties": {
          "executor": {
            "not": { "required": ["authority"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          }
        },
        "required": ["executor"]
      },
      "then": {
        "required": ["runtime"],
        "properties": {
          "executor": { "required": ["kind", "id", "authority"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "effectLevel": { "enum": ["hostOnly", "readOnly"] }
        },
        "required": ["executor", "effectLevel"]
      },
      "then": {
        "properties": {
          "executor": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "defaultReadOnlyPolicy" }
                },
                "required": ["kind", "reference"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "effectLevel": { "enum": ["deviceMutation", "destructive"] }
        },
        "required": ["executor", "effectLevel"]
      },
      "then": {
        "properties": {
          "executor": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "runtimeCapability" }
                },
                "required": ["kind", "reference"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "effectLevel": { "const": "destructive" }
        },
        "required": ["executor", "effectLevel"]
      },
      "then": {
        "properties": {
          "executor": {
            "properties": {
              "authority": {
                "required": [
                  "kind",
                  "reference",
                  "reservationId",
                  "useOrdinal",
                  "planDigest",
                  "stepSetDigest",
                  "targetBindingDigest",
                  "artifactDigest"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": { "terminalState": { "const": "recovered" } },
            "required": ["terminalState"]
          }
        },
        "required": ["runtime"]
      },
      "then": {
        "required": ["recovery"],
        "properties": {
          "recovery": {
            "properties": {
              "source": { "const": "distinctRecoveryExecution" }
            },
            "required": ["source"]
          }
        }
      }
    },
    {
      "if": { "required": ["recovery"] },
      "then": {
        "properties": {
          "effectLevel": { "const": "destructive" }
        }
      }
    }
  ]
}
