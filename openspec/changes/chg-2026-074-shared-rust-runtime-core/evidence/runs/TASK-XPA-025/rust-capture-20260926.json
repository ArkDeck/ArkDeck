    "ipc.namedPipe": {
      "blockedBy": "a Windows performance capture with a named-pipe client",
      "designRow": "I.2 row 4 (IPC, named-pipe leg)",
      "reason": "the macOS capture uses Unix domain sockets and does not measure the Windows named-pipe transport",
      "status": "NOT_MEASURED"
    },
    "ipc.xpc": {
      "blockedBy": "an absolute XPC measurement from a client the daemon accepts",
      "designRow": "I.2 row 4 (IPC, XPC leg)",
      "reason": "the XPC leg accepts only the signed App as its peer, and this harness is an unsigned Unix-domain-socket client; RuntimeXPCTransportCostTests publishes relative XPC cost only; the Rust daemon's XPC ingress is also opt-in (ARKDECK_APP_INGRESS=history)",
      "status": "NOT_MEASURED"
    },
    "job.cancelReconcile": {
      "blockedBy": "a Rust harness leg that submits, cancels and reconciles a Job, and a device window",
      "designRow": "I.2 row 9 (cancel and reconcile latency)",
      "reason": "the row times the cancellation of a running readOnly Job; this harness is read-only by construction and never submits the Job it would cancel, and the terminal leg needs an HDC child process on a real device; the Rust daemon supports job.reconcile, but this capture does not time a cancellation/reconciliation workload",
      "status": "NOT_MEASURED"
    },
    "job.eventsPage": {
      "blockedBy": "a fixture that produces a 1,000-event Job",
      "designRow": "I.2 row 5 (job.events 1,000-row page)",
      "reason": "job.events is published and read-only, but every seeded Job is an observe.device Job carrying a handful of events, not the 1,000-event Job the budget is written for; a page of a seeded Job would only budget its own scale",
      "status": "NOT_MEASURED"
    },
    "job.eventsWait": {
      "blockedBy": "a registry, schema and client change that publishes job.events.wait",
      "designRow": "I.2 row 5 (job.events.wait idle CPU)",
      "reason": "job.events.wait is a proposal in design section F.2 and is not in the published single v1 method table; only the job.events pull page exists",
      "status": "NOT_MEASURED"
    },
    "job.journalAppend": {
      "blockedBy": "a timed durable-append leg over a 1,000-event Job",
      "designRow": "I.2 row 5 (journal append per event)",
      "reason": "no leg times a durable journal append: this harness only reads, and the soak appends journals without timing them; the Swift per-event figure came from JournalRecoveryContractTests' opt-in journal benchmark, which times the Swift engine",
      "status": "NOT_MEASURED"
    },
    "package.size": {
      "blockedBy": "TASK-XPA-022 (Windows packaging) and a macOS installer producer",
      "designRow": "I.2 row 12 (installer size and update delta)",
      "reason": "no DMG or MSIX producer exists in the repository, so there is no artefact to size",
