<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SPK2_PEER_REQUIREMENT</key>
		<string>anchor apple generic and certificate leaf[subject.OU] = "8AQTYW5FKR" and (identifier "com.arkdeck.spk2-client" or identifier "com.arkdeck.spk2-client2" or identifier "com.arkdeck.spk2-adhoc" or identifier "com.arkdeck.spk2-devcert" or identifier "com.arkdeck.spk2-nolookup" or identifier "com.arkdeck.desktop")</string>
		<key>SPK2_REPLY_MODE</key>
		<string>respond</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.arkdeck.agentd</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>MachServices</key>
	<dict>
		<key>com.arkdeck.agentd</key>
		<true/>
	</dict>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>__SPK2_ROOT__/build/spk2-listener</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__SPK2_ROOT__/results/listener.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__SPK2_ROOT__/results/listener.stdout.log</string>
</dict>
</plist>
