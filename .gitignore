# Generated / local-only artifacts. Nothing governance-relevant may be ignored:
# the protected set (scripts/sdd_protected_set.py) must always be committed.
__pycache__/
*.pyc
.DS_Store

# Local pinned-runtime virtualenv for the SDD toolchain (see
# scripts/requirements-sdd.txt); never committed, recreated per machine.
.venv*/

# Local assistant/session state (not part of the SDD or the product)
.claude/

# Xcode / SwiftPM (for the future macOS implementation)
.build/
DerivedData/
xcuserdata/
*.xcuserstate

# Upstream rkdeveloptool writes `log/log<YYYY-MM-DD>.txt` relative to its
# current directory, and `swift test --package-path Packages/ArkDeckKit` runs
# the test process with that package as its working directory. Any tool spawn
# that inherits it (see FoundationRockchipRuntimeCommandRunner, which does not
# bind RockchipProductToolRuntimeDirectory) lands the log here.
Packages/ArkDeckKit/log/
