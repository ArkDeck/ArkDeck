<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ArkDeck.Spk4.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="{StaticResource ArkDeckSpace6Thickness}" Spacing="{StaticResource ArkDeckSpace4}" MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource ArkDeckPageTitleStyle}" Text="Settings" />
        <Border Style="{StaticResource ArkDeckCardStyle}">
            <StackPanel Spacing="{StaticResource ArkDeckSpace2}">
                <TextBlock Style="{StaticResource ArkDeckCaptionStyle}" Text="Appearance follows Windows (theme, contrast, accent, text size)" />
                <TextBlock x:Name="Environment" Style="{StaticResource ArkDeckMonoStyle}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Settings.Environment" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
