<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ArkDeck.Spk4.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fx="using:ArkDeck.Spk4.Fixtures"
    xmlns:app="using:ArkDeck.Spk4">

    <Grid Padding="{StaticResource ArkDeckSpace6Thickness}" RowSpacing="{StaticResource ArkDeckSpace3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource ArkDeckPageTitleStyle}" Text="History" />
        <TextBlock
            x:Name="Stats"
            Grid.Row="1"
            AutomationProperties.AutomationId="History.LoadStats"
            Style="{StaticResource ArkDeckCaptionStyle}"
            Text="Loading…" />

        <Border Grid.Row="2" Style="{StaticResource ArkDeckCardStyle}" Padding="0">
            <!-- ListView virtualises by default (ItemsStackPanel); rows are compiled x:Bind. -->
            <ListView
                x:Name="List"
                AutomationProperties.AutomationId="History.List"
                AutomationProperties.Name="History, fixture jobs"
                SelectionMode="Single"
                ContainerContentChanging="List_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="fx:HistoryRow">
                        <Grid
                            Height="40"
                            ColumnSpacing="{StaticResource ArkDeckSpace4}"
                            AutomationProperties.Name="{x:Bind AutomationName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="{x:Bind StateGlyph}"
                                FontSize="14"
                                Foreground="{x:Bind app:StateVisuals.Brush(State)}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Style="{StaticResource ArkDeckMonoStyle}" Text="{x:Bind JobId}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource ArkDeckBodyStyle}" Text="{x:Bind Operation}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       Style="{StaticResource ArkDeckBodyStyle}" Text="{x:Bind StateLabel}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                       Style="{StaticResource ArkDeckCaptionStyle}" Text="{x:Bind StartedText}" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Style="{StaticResource ArkDeckCaptionStyle}" Text="{x:Bind DurationText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
