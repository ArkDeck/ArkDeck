{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkdeck.dev/schemas/catalog-operation-1.0.0.json",
  "title": "ArkDeck Operation Catalog document (v1)",
  "description": "Closed schema for one published typed operation. Enforcement authority is scripts/catalog_gen/generate.py::validate_operation (stdlib validator, no jsonschema dependency); this file is the machine-readable contract and its vocabulary is kept in lockstep by scripts/catalog_gen/test_generate.py. The schema is deliberately incapable of expressing a generic shell step: there is no executable, argv, shell or command field anywhere, and step argument keys matching the forbidden set are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "provider",
    "effect",
    "authorization",
    "binding",
    "concurrencyKey",
    "inputs",
    "outputs",
    "steps",
    "timeoutSeconds",
    "outputByteBudget",
    "retry",
    "unknownOutcome",
    "artifacts",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)*$",
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider": {
      "enum": [
        "hdc",
        "rockchip",
        "workspace"
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "permitted"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/effect"
        },
        "permitted": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "authorization": {
      "description": "Map from permitted effect to the authorization policy that gates a plan whose effective effect equals that key.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hostOnly": {
          "$ref": "#/$defs/authorizationPolicy"
        },
        "readOnly": {
          "$ref": "#/$defs/authorizationPolicy"
        },
        "deviceMutation": {
          "$ref": "#/$defs/authorizationPolicy"
        },
        "destructive": {
          "const": "oneShotExactPlan"
        }
      }
    },
    "defaultPolicyIssuance": {
      "description": "disabled: the default capability policy never issues this operation; an explicit experimental profile plus a maintainer-merged capability is required.",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "binding": {
      "enum": [
        "none",
        "confirmedDevice"
      ]
    },
    "concurrencyKey": {
      "enum": [
        "device-exclusive",
        "device-shared-readonly",
        "host-exclusive"
      ]
    },
    "inputs": {
      "$ref": "#/$defs/fieldTable"
    },
    "outputs": {
      "$ref": "#/$defs/fieldTable"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "outputByteBudget": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1073741824
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflightAttempts",
        "mutationAttempts"
      ],
      "properties": {
        "preflightAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "mutationAttempts": {
          "description": "Structurally pinned: a mutating or destructive step is never automatically retried.",
          "const": 1
        }
      }
    },
    "unknownOutcome": {
      "description": "Structurally pinned: an unknown external outcome always requires reconcile, never an automatic replay.",
      "const": "reconcileRequired"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[0-9]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "enum": [
              "observe.device",
              "capture.diagnostics",
              "debug.hap"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "if": {
                "properties": {
                  "kind": {
                    "const": "runApprovedRemoteRead"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "actionRef"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "effect": {
      "enum": [
        "hostOnly",
        "readOnly",
        "deviceMutation",
        "destructive"
      ]
    },
    "authorizationPolicy": {
      "enum": [
        "defaultReadOnly",
        "standingCapability",
        "oneShotExactPlan"
      ]
    },
    "cancellation": {
      "enum": [
        "immediate",
        "atSafeBoundary",
        "criticalNonInterruptible"
      ]
    },
    "binding": {
      "enum": [
        "none",
        "confirmedDevice"
      ]
    },
    "compensation": {
      "enum": [
        "none",
        "bestEffortCleanup",
        "rollbackPublished"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepID",
        "kind",
        "effect",
        "cancellation",
        "binding",
        "compensation"
      ],
      "properties": {
        "stepID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "kind": {
          "description": "Must be a kind registered in openspec/contracts/workflow-step-registry.yaml; the validator rejects unknown kinds and any effect/cancellation/binding below the registry minimum for the kind.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "actionRef": {
          "$ref": "#/$defs/actionRef"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "cancellation": {
          "$ref": "#/$defs/cancellation"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "optional": {
          "type": "boolean"
        },
        "compensation": {
          "$ref": "#/$defs/compensation"
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "captureRemoteStdout"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "actionRef"
            ],
            "properties": {
              "actionRef": {
                "properties": {
                  "catalogId": {
                    "enum": [
                      "arkui-ui-dump",
                      "arkdeck-diagnostics"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "kind": {
                  "const": "runApprovedRemoteRead"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "actionRef": {
                  "properties": {
                    "catalogId": {
                      "const": "arkdeck-remote-operations"
                    }
                  }
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "actionRef"
                ]
              }
            }
          }
        }
      ]
    },
    "actionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogId",
        "actionId"
      ],
      "properties": {
        "catalogId": {
          "enum": [
            "arkui-ui-dump",
            "arkdeck-diagnostics",
            "arkdeck-remote-operations"
          ]
        },
        "actionId": {
          "enum": [
            "nodeSummary",
            "elementTree",
            "fullDefaultTree",
            "componentDetail",
            "renderTreeLegacy",
            "boundedHilog",
            "componentTree",
            "crashIndex",
            "crashLog",
            "windowInventory",
            "deviceSummary",
            "systemProperties",
            "processList",
            "packageInfo",
            "storageUsage",
            "deviceModel",
            "firmwareBuild"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "catalogId": {
              "const": "arkui-ui-dump"
            },
            "actionId": {
              "enum": [
                "nodeSummary",
                "elementTree",
                "fullDefaultTree",
                "componentDetail",
                "renderTreeLegacy"
              ]
            }
          }
        },
        {
          "properties": {
            "catalogId": {
              "const": "arkdeck-diagnostics"
            },
            "actionId": {
              "enum": [
                "boundedHilog",
                "componentTree",
                "crashIndex",
                "crashLog",
                "windowInventory"
              ]
            }
          }
        },
        {
          "properties": {
            "catalogId": {
              "const": "arkdeck-remote-operations"
            },
            "actionId": {
              "enum": [
                "deviceSummary",
                "systemProperties",
                "processList",
                "packageInfo",
                "storageUsage",
                "deviceModel",
                "firmwareBuild"
              ]
            }
          }
        }
      ]
    },
    "fieldTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "maxProperties": 24,
          "propertyNames": {
            "pattern": "^(?!argv$|shell$|exec$|command$|runHDC$|rawCommand$|executable$)[a-z][a-zA-Z0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "stringArray",
            "artifactLease",
            "artifactLeaseArray",
            "artifactReference"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "pattern": {
          "type": "string",
          "maxLength": 200
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "default": {}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "mediaType",
        "privacy",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$",
          "maxLength": 100
        },
        "role": {
          "enum": [
            "raw",
            "derived",
            "log",
            "plan",
            "diagnostic"
          ]
        },
        "mediaType": {
          "type": "string",
          "maxLength": 100
        },
        "privacy": {
          "enum": [
            "standard",
            "sensitive"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "retentionClass": {
          "enum": [
            "default",
            "pinnedUntilVerified",
            "shortLived"
          ]
        }
      }
    }
  }
}
