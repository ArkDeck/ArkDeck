{
  "schemaVersion": "1.0.0",
  "id": "debug.hap",
  "version": 1,
  "title": "Install, start, observe, stop and optionally uninstall a HAP from an artifact lease",
  "provider": "hdc",
  "effect": { "minimum": "deviceMutation", "permitted": ["deviceMutation"] },
  "authorization": { "deviceMutation": "standingCapability" },
  "binding": "confirmedDevice",
  "concurrencyKey": "device-exclusive",
  "inputs": {
    "fields": {
      "hapArtifactLease": {
        "type": "artifactLease",
        "required": true,
        "description": "Entry HAP; must come from an artifact lease, arbitrary local paths are rejected."
      },
      "additionalHapArtifactLeases": {
        "type": "artifactLeaseArray",
        "required": false,
        "maxItems": 16,
        "description": "Feature HAPs and HSPs of the same bundle. Present means the packages are sent into one provider-owned directory and installed by a single bm install -p <dir>; absent leaves the single-package plan unchanged."
      },
      "bundleName": {
        "type": "string",
        "required": true,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
        "maxLength": 200,
        "description": "Application bundle name exactly as the package declares it, for example `com.example.waterflow`. The provider matches package readback against this, so a bundle that is not installed by this exact name reads as a failed install."
      },
      "abilityName": {
        "type": "string",
        "required": true,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$",
        "maxLength": 200,
        "description": "Ability to start within the bundle, as declared in module.json5, for example `EntryAbility`. Never lowered as caller-supplied argv."
      },
      "installPolicy": {
        "type": "string",
        "required": false,
        "enum": ["installOrReplace"],
        "default": "installOrReplace",
        "description": "How an already-installed package is treated. This field is retained as a forward-compatible policy dimension, but currently has one executable value: `installOrReplace`. A fresh-only install is not published until a pre-install absence readback exists."
      },
      "cleanupPolicy": {
        "type": "string",
        "required": false,
        "enum": ["uninstall", "retain"],
        "default": "uninstall",
        "description": "What happens to the package when the job ends. `uninstall` removes it; `retain` leaves it installed, which an external observer needs together with postRunAbilityState `running` to keep watching after the job succeeds. Restoring a previous package is not published until a snapshot/restore plan exists."
      },
      "postRunAbilityState": {
        "type": "string",
        "required": false,
        "enum": ["stopped", "running"],
        "default": "stopped",
        "description": "Whether the started ability is stopped before cleanup. `running` skips stop-ability so the application is still live when the job succeeds, which is what an external observer needs; the operator then owns stopping it. A failed job still stops the ability during compensation."
      },
      "captureDiagnostics": {
        "type": "boolean", "required": false, "default": true,
        "description": "Collect the bounded HiLog window while the ability runs. Read-only, and its absence does not fail the job — the diagnostics artifact is optional."
      },
      "diagnosticsDurationSeconds": {
        "type": "integer",
        "required": false,
        "minimum": 1,
        "maximum": 300,
        "default": 30,
        "description": "Length of the bounded HiLog window in seconds. A crash that happens after this window is not in the artifact, so a delayed fault needs a window that outlasts it."
      },
      "portForwardProfile": {
        "type": "string",
        "required": false,
        "enum": ["none"],
        "default": "none",
        "description": "Port forwarding to establish alongside the run. This field is retained as a forward-compatible policy dimension, but currently has one executable value: `none`. This operation publishes no port-forward steps; use `port-forward.create@1` separately."
      }
    }
  },
  "outputs": {
    "fields": {
      "installReadback": { "type": "artifactReference", "required": true },
      "processReadback": { "type": "artifactReference", "required": true },
      "diagnostics": { "type": "artifactReference", "required": false }
    }
  },
  "steps": [
    {
      "stepID": "verify-hap-artifact",
      "kind": "verifyArtifact",
      "effect": "hostOnly",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    },
    {
      "stepID": "confirm-evidence-target",
      "kind": "probeDevice",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-model",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "deviceModel"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-firmware",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "firmwareBuild"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "send-hap",
      "kind": "sendFile",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "bestEffortCleanup",
      "notes": "Provider-owned staging path; caller cannot choose the remote destination."
    },
    {
      "stepID": "install-hap",
      "kind": "installPackage",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "rollbackPublished",
      "notes": "Success is decided by the package readback step, never by exit code alone."
    },
    {
      "stepID": "package-readback",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "packageInfo"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "start-ability",
      "kind": "startApplication",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "rollbackPublished"
    },
    {
      "stepID": "process-readback",
      "kind": "verifyRemoteState",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none",
      "notes": "Start success requires an observable process/ability state signal."
    },
    {
      "stepID": "capture-diagnostics",
      "kind": "captureRemoteStdout",
      "actionRef": {
        "catalogId": "arkdeck-diagnostics",
        "actionId": "boundedHilog"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none"
    },
    {
      "stepID": "stop-ability",
      "kind": "stopApplication",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "cleanup-uninstall",
      "kind": "uninstallPackage",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Selected by cleanupPolicy."
    },
    {
      "stepID": "cleanup-remote-staging",
      "kind": "cleanupOwnedRemotePath",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "bestEffortCleanup"
    },
    {
      "stepID": "finalize-session",
      "kind": "finalizeSession",
      "effect": "hostOnly",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 600,
  "outputByteBudget": 67108864,
  "retry": { "preflightAttempts": 2, "mutationAttempts": 1 },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    { "name": "install-readback.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true },
    { "name": "process-readback.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true },
    { "name": "debug-hilog.txt", "role": "raw", "mediaType": "text/plain", "privacy": "sensitive", "required": false }
  ],
  "profiles": ["openharmony-standard@1", "dayu200"]
}
