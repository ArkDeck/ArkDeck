{
  "schemaVersion": "1.0.0",
  "id": "input.swipe",
  "version": 1,
  "title": "Inject one swipe between exact device coordinates",
  "provider": "hdc",
  "effect": {
    "minimum": "deviceMutation",
    "permitted": [
      "deviceMutation"
    ]
  },
  "authorization": {
    "deviceMutation": "standingCapability"
  },
  "binding": "confirmedDevice",
  "concurrencyKey": "device-exclusive",
  "inputs": {
    "fields": {
      "fromX": {
        "type": "integer",
        "required": true,
        "minimum": 0,
        "maximum": 32767,
        "description": "Device-pixel X of the pointer-down position after content-rect mapping; never a raw host coordinate."
      },
      "fromY": {
        "type": "integer",
        "required": true,
        "minimum": 0,
        "maximum": 32767,
        "description": "Device-pixel Y of the pointer-down position."
      },
      "toX": {
        "type": "integer",
        "required": true,
        "minimum": 0,
        "maximum": 32767,
        "description": "Device-pixel X of the pointer-up position."
      },
      "toY": {
        "type": "integer",
        "required": true,
        "minimum": 0,
        "maximum": 32767,
        "description": "Device-pixel Y of the pointer-up position."
      },
      "durationMs": {
        "type": "integer",
        "required": true,
        "minimum": 80,
        "maximum": 2000,
        "description": "The caller's real pointer-down-to-up hold time. The device command takes a velocity in px/s, so the provider derives it from this duration and records the conversion in the verified summary; the duration itself is never invented."
      },
      "displayId": {
        "type": "integer",
        "required": false,
        "minimum": 0,
        "maximum": 64,
        "description": "Target display for multi-display devices. Omitted lowers to the device's default display."
      }
    }
  },
  "outputs": {
    "fields": {}
  },
  "steps": [
    {
      "stepID": "confirm-evidence-target",
      "kind": "probeDevice",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-model",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "deviceModel"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-firmware",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "firmwareBuild"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "inject-pointer-input",
      "kind": "injectPointerInput",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "finalize-session",
      "kind": "finalizeSession",
      "effect": "hostOnly",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 60,
  "outputByteBudget": 1048576,
  "retry": {
    "preflightAttempts": 2,
    "mutationAttempts": 1
  },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [],
  "profiles": [
    "openharmony-standard@1",
    "dayu200"
  ]
}
