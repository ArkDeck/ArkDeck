{
  "schemaVersion": "1.0.0",
  "id": "workspace.apply-patch",
  "version": 1,
  "title": "Apply an Artifact-backed patch inside declared ProjectProfile globs",
  "provider": "workspace",
  "effect": {
    "minimum": "deviceMutation",
    "permitted": [
      "deviceMutation"
    ]
  },
  "authorization": {
    "deviceMutation": "standingCapability"
  },
  "binding": "none",
  "concurrencyKey": "host-exclusive",
  "inputs": {
    "fields": {
      "projectRef": {
        "type": "string",
        "required": true,
        "maxLength": 128
      },
      "patchArtifactRef": {
        "type": "artifactLease",
        "required": true
      },
      "allowedFileGlobs": {
        "type": "stringArray",
        "required": true,
        "maxItems": 64,
        "maxLength": 512
      },
      "expectedWorkspaceRevision": {
        "type": "string",
        "required": false,
        "maxLength": 128,
        "description": "Workspace revision the caller decided against; the provider refuses if the tree moved."
      }
    }
  },
  "outputs": {
    "fields": {
      "appliedPatch": {
        "type": "artifactReference",
        "required": true
      },
      "patchAttemptRef": {
        "type": "string",
        "required": true,
        "maxLength": 64
      }
    }
  },
  "steps": [
    {
      "stepID": "apply-patch",
      "kind": "applyWorkspacePatch",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "rollbackPublished"
    }
  ],
  "timeoutSeconds": 180,
  "outputByteBudget": 16777216,
  "retry": {
    "preflightAttempts": 1,
    "mutationAttempts": 1
  },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    {
      "name": "applied-patch.json",
      "role": "derived",
      "mediaType": "application/json",
      "privacy": "standard",
      "required": true,
      "retentionClass": "pinnedUntilVerified"
    }
  ],
  "profiles": [
    "workspace-host@1"
  ],
  "defaultPolicyIssuance": "disabled"
}
