{
  "schemaVersion": "1.0.0",
  "id": "capture.diagnostics",
  "version": 1,
  "title": "Capture bounded HiLog, UI dump and trace with a structured artifact index",
  "provider": "hdc",
  "effect": { "minimum": "readOnly", "permitted": ["readOnly", "deviceMutation"] },
  "authorization": {
    "readOnly": "defaultReadOnly",
    "deviceMutation": "standingCapability"
  },
  "binding": "confirmedDevice",
  "concurrencyKey": "device-exclusive",
  "inputs": {
    "fields": {
      "durationSeconds": {
        "type": "integer",
        "required": true,
        "minimum": 1,
        "maximum": 600,
        "description": "Bounded HiLog capture window."
      },
      "bundleName": {
        "type": "string",
        "required": false,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
        "maxLength": 200,
        "description": "Optional typed application identity. When present, the same bounded job publishes an application-specific process readback."
      },
      "abilityName": {
        "type": "string",
        "required": false,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$",
        "maxLength": 200,
        "description": "Optional ability identity carried into the liveness artifact; never lowered as caller-supplied argv."
      },
      "processName": {
        "type": "string",
        "required": false,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:]*$",
        "maxLength": 200,
        "description": "Optional process identity. Defaults to bundleName and is lowered only by the HDC provider."
      },
      "expectedDeployedArtifactDigest": {
        "type": "string",
        "required": false,
        "pattern": "^[0-9a-f]{64}$",
        "maxLength": 64,
        "description": "Caller-supplied expected digest of the deployment whose liveness is being sampled. Recorded with the observation so a later reader can tell which build was live; it is not trusted as a fact about the device."
      },
      "hilogFilters": {
        "type": "stringArray",
        "required": false,
        "maxItems": 16,
        "maxLength": 200,
        "description": "Typed HiLog filter expressions; no shell fragments."
      },
      "traceCategories": {
        "type": "stringArray",
        "required": false,
        "maxItems": 24,
        "maxLength": 64,
        "description": "Trace categories; presence selects the remote-file trace leg and escalates the effective effect to deviceMutation."
      },
      "traceBufferKB": {
        "type": "integer",
        "required": false,
        "minimum": 1024,
        "maximum": 65536,
        "default": 8192,
        "description": "Per-capture trace buffer size in KiB. Only consulted when traceCategories selects the trace leg; ignored otherwise."
      },
      "uiDump": {
        "type": "boolean", "required": false, "default": true,
        "description": "Capture the accessibility/window dump. Read-only: unlike the trace, screenshot and component-tree legs this does not raise the effective effect."
      },
      "crashLogs": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Capture the device's Faultlogger index. Read-only: unlike the trace, tree and screenshot legs this does not raise the effective effect."
      },
      "crashLogName": {
        "type": "string",
        "required": false,
        "pattern": "^[a-z]+-[A-Za-z0-9._-]{1,180}$",
        "maxLength": 200,
        "description": "One Faultlogger entry to fetch, named exactly as the index lists it. An entry name, never a path."
      },
      "uiScreenshot": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Capture a PNG screenshot of the display. Presence selects the file-producing snapshot_display leg and escalates the effective effect to deviceMutation; absent or false leaves the plan unchanged."
      },
      "uiComponentTree": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Capture the on-screen component tree. Presence selects the file-producing dumpLayout leg and escalates the effective effect to deviceMutation; absent or false leaves the plan unchanged."
      },
      "totalArtifactByteBudget": {
        "type": "integer",
        "required": false,
        "minimum": 1048576,
        "maximum": 536870912,
        "default": 134217728,
        "description": "Ceiling on the total bytes this job may publish across all of its artifacts. Reaching it ends collection rather than silently dropping a product."
      },
      "redactionProfile": {
        "type": "string",
        "required": false,
        "enum": ["standard"],
        "default": "standard",
        "description": "Redaction applied to published text. This field is retained as a forward-compatible policy dimension, but currently has one executable value: `standard`. Stronger redaction is not published until its implementation exists."
      }
    }
  },
  "outputs": {
    "fields": {
      "artifactIndex": { "type": "artifactReference", "required": true },
      "captureSummary": { "type": "artifactReference", "required": true },
      "applicationLiveness": { "type": "artifactReference", "required": false }
    }
  },
  "steps": [
    {
      "stepID": "preflight-host-storage",
      "kind": "preflightHostStorage",
      "effect": "hostOnly",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    },
    {
      "stepID": "confirm-evidence-target",
      "kind": "probeDevice",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-model",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "deviceModel"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-firmware",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "firmwareBuild"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "preflight-device-storage",
      "kind": "preflightDeviceStorage",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "observe-application-liveness",
      "kind": "verifyRemoteState",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Selected only when bundleName is present. The provider lowers a typed process readback and publishes HEALTHY, UNHEALTHY or UNKNOWN without treating unrelated HiLog as application evidence."
    },
    {
      "stepID": "capture-hilog",
      "kind": "captureRemoteStdout",
      "actionRef": {
        "catalogId": "arkdeck-diagnostics",
        "actionId": "boundedHilog"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none",
      "notes": "Bounded by durationSeconds and per-stream byte budget; partial success is recorded per artifact."
    },
    {
      "stepID": "capture-ui-dump",
      "kind": "captureRemoteStdout",
      "actionRef": {
        "catalogId": "arkdeck-diagnostics",
        "actionId": "windowInventory"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none"
    },
    {
      "stepID": "capture-crash-index",
      "kind": "captureRemoteStdout",
      "actionRef": {
        "catalogId": "arkdeck-diagnostics",
        "actionId": "crashIndex"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Lists the device's own crash ledger. An empty list is a truthful result, not a failure."
    },
    {
      "stepID": "capture-crash-log",
      "kind": "captureRemoteStdout",
      "actionRef": {
        "catalogId": "arkdeck-diagnostics",
        "actionId": "crashLog"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Fetches one entry by the name the index gave; selected only when crashLogName is present."
    },
    {
      "stepID": "capture-ui-tree",
      "kind": "captureRemoteFile",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "bestEffortCleanup",
      "notes": "Writes the component tree to a provider-owned remote JSON path; selected only by uiComponentTree, which is what raises the plan's effect."
    },
    {
      "stepID": "receive-ui-tree",
      "kind": "receiveFile",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Size/hash verified on receive. The artifact is published from the received bytes through the redacting path - the tree carries on-screen text."
    },
    {
      "stepID": "cleanup-ui-tree-temp",
      "kind": "cleanupOwnedRemotePath",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "bestEffortCleanup",
      "notes": "Failure records cleanup debt for later reconcile; never silently dropped."
    },
    {
      "stepID": "capture-screenshot",
      "kind": "captureRemoteFile",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "bestEffortCleanup",
      "notes": "snapshot_display writes a provider-owned remote PNG; the device validates the file suffix against the requested type, so both are load-bearing."
    },
    {
      "stepID": "receive-screenshot",
      "kind": "receiveFile",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Size, hash and PNG magic verified on receive; a file that is not a PNG is not published."
    },
    {
      "stepID": "cleanup-screenshot-temp",
      "kind": "cleanupOwnedRemotePath",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "bestEffortCleanup",
      "notes": "Failure records cleanup residue for later reconcile; never silently dropped."
    },
    {
      "stepID": "capture-trace",
      "kind": "captureRemoteFile",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "bestEffortCleanup",
      "notes": "Provider-owned unique remote temp path bound to session/step; selected only when traceCategories is present."
    },
    {
      "stepID": "receive-trace-artifact",
      "kind": "receiveFile",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "none",
      "notes": "Size/hash verified on receive."
    },
    {
      "stepID": "cleanup-remote-temp",
      "kind": "cleanupOwnedRemotePath",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "optional": true,
      "compensation": "bestEffortCleanup",
      "notes": "Failure records cleanup debt for later reconcile; never silently dropped."
    },
    {
      "stepID": "postprocess-index",
      "kind": "postprocessArtifact",
      "effect": "hostOnly",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    },
    {
      "stepID": "finalize-session",
      "kind": "finalizeSession",
      "effect": "hostOnly",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 900,
  "outputByteBudget": 536870912,
  "retry": { "preflightAttempts": 2, "mutationAttempts": 1 },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    { "name": "hilog.txt", "role": "raw", "mediaType": "text/plain", "privacy": "sensitive", "required": true },
    { "name": "ui-dump.json", "role": "raw", "mediaType": "application/json", "privacy": "sensitive", "required": false },
    { "name": "ui-tree.json", "role": "raw", "mediaType": "application/json", "privacy": "sensitive", "required": false },
    { "name": "screenshot.png", "role": "raw", "mediaType": "image/png", "privacy": "sensitive", "required": false },
    { "name": "crash-index.txt", "role": "raw", "mediaType": "text/plain", "privacy": "sensitive", "required": false },
    { "name": "crash-log.txt", "role": "raw", "mediaType": "text/plain", "privacy": "sensitive", "required": false },
    { "name": "application-liveness.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": false },
    { "name": "trace.htrace", "role": "raw", "mediaType": "application/octet-stream", "privacy": "sensitive", "required": false },
    { "name": "capture.log", "role": "log", "mediaType": "text/plain", "privacy": "standard", "required": false },
    { "name": "artifact-index.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true },
    { "name": "capture-summary.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true }
  ],
  "profiles": ["openharmony-standard@1", "dayu200"]
}
