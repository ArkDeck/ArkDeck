{
  "schemaVersion": "1.0.0",
  "id": "deploy.native-library.system",
  "version": 1,
  "title": "Replace a system/vendor partition native library through Runtime-owned exact-plan admission",
  "provider": "hdc",
  "effect": { "minimum": "destructive", "permitted": ["destructive"] },
  "authorization": { "destructive": "runtimeCapability" },
  "defaultPolicyIssuance": "enabled",
  "binding": "confirmedDevice",
  "concurrencyKey": "device-exclusive",
  "inputs": {
    "fields": {
      "libraryArtifactLease": { "type": "artifactLease", "required": true },
      "targetPathProfile": {
        "type": "string",
        "required": true,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Named system-path profile resolved by the provider; the capability pins the exact absolute path. Callers can never submit a raw remote path, and app-owned inputs can never resolve to a system path."
      },
      "expectedBuildFingerprint": {
        "type": "string",
        "required": true,
        "maxLength": 200,
        "description": "Must equal the device's current build fingerprint at preflight; drift invalidates the capability."
      },
      "originalFileSHA256": {
        "type": "string",
        "required": true,
        "pattern": "^[0-9a-f]{64}$"
      },
      "expectedABI": {
        "type": "string",
        "required": true,
        "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"]
      },
      "restartPlan": {
        "type": "string",
        "required": true,
        "enum": ["restartService", "rebootDevice"]
      }
    }
  },
  "outputs": {
    "fields": {
      "publishReport": { "type": "artifactReference", "required": true },
      "verificationReport": { "type": "artifactReference", "required": true }
    }
  },
  "steps": [
    {
      "stepID": "verify-elf-locally",
      "kind": "verifyArtifact",
      "effect": "hostOnly",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    },
    {
      "stepID": "hash-library",
      "kind": "hashFile",
      "effect": "hostOnly",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    },
    {
      "stepID": "preflight-system-state",
      "kind": "runApprovedRemoteRead",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none",
      "notes": "Build fingerprint, partition, writability, free space and original file hash must all match the capability pins."
    },
    {
      "stepID": "remount-writable",
      "kind": "runApprovedRemoteMutation",
      "effect": "destructive",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "rollbackPublished",
      "notes": "Effect escalated above registry minimum by design: system partition remount is treated as destructive."
    },
    {
      "stepID": "send-to-staging",
      "kind": "sendFile",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "bestEffortCleanup"
    },
    {
      "stepID": "backup-original",
      "kind": "runApprovedRemoteMutation",
      "effect": "destructive",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "rollbackPublished",
      "notes": "Backup to a trusted location; backup hash verified before replacement."
    },
    {
      "stepID": "atomic-replace",
      "kind": "runApprovedRemoteMutation",
      "effect": "destructive",
      "cancellation": "criticalNonInterruptible",
      "binding": "confirmedDevice",
      "compensation": "rollbackPublished",
      "notes": "Unknown outcome requires human reconcile; automatic re-replacement is forbidden."
    },
    {
      "stepID": "restart-per-plan",
      "kind": "rebootDevice",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "none",
      "notes": "Executed per restartPlan; service restart uses the same step with a service-scoped profile."
    },
    {
      "stepID": "wait-for-reconnect",
      "kind": "waitForReconnect",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "verify-system-state",
      "kind": "verifyRemoteState",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none",
      "notes": "Device returns to HDC, target component runs, new library hash/build-id loaded."
    },
    {
      "stepID": "finalize-session",
      "kind": "finalizeSession",
      "effect": "hostOnly",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 1800,
  "outputByteBudget": 134217728,
  "retry": { "preflightAttempts": 1, "mutationAttempts": 1 },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    { "name": "publish-report.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true },
    { "name": "verification-report.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true },
    { "name": "backup-receipt.json", "role": "derived", "mediaType": "application/json", "privacy": "standard", "required": true, "retentionClass": "pinnedUntilVerified" }
  ],
  "profiles": ["openharmony-standard@1", "dayu200@1"]
}
