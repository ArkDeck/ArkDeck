{
  "schemaVersion": "1.0.0",
  "id": "workspace.create-checkpoint",
  "version": 1,
  "title": "Create a rollback checkpoint object for declared workspace source",
  "provider": "workspace",
  "effect": {
    "minimum": "deviceMutation",
    "permitted": [
      "deviceMutation"
    ]
  },
  "authorization": {
    "deviceMutation": "standingCapability"
  },
  "binding": "none",
  "concurrencyKey": "host-exclusive",
  "inputs": {
    "fields": {
      "projectRef": {
        "type": "string",
        "required": true,
        "description": "Declared project to checkpoint; the provider resolves its root."
      },
      "expectedWorkspaceRevision": {
        "type": "string",
        "required": false,
        "maxLength": 128,
        "description": "Workspace revision the caller decided against; the provider refuses if the tree moved."
      },
      "checkpointFilePaths": {
        "type": "stringArray",
        "required": false,
        "maxItems": 64,
        "maxLength": 512,
        "description": "Exact profile-scoped files to seal when the ProjectProfile uses an archive checkpoint instead of Git."
      }
    }
  },
  "outputs": {
    "fields": {
      "inspection": {
        "type": "artifactReference",
        "required": true
      }
    }
  },
  "timeoutSeconds": 120,
  "outputByteBudget": 1048576,
  "retry": {
    "preflightAttempts": 1,
    "mutationAttempts": 1
  },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    {
      "name": "checkpoint.txt",
      "role": "raw",
      "mediaType": "text/plain",
      "privacy": "standard",
      "required": true
    }
  ],
  "profiles": [
    "workspace-host@1"
  ],
  "steps": [
    {
      "stepID": "create-checkpoint",
      "kind": "createWorkspaceCheckpoint",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "none",
      "notes": "Writes either a Git object or a provider-owned archive and never changes declared workspace source."
    }
  ],
  "defaultPolicyIssuance": "disabled"
}
