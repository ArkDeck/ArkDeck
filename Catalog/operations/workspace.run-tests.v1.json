{
  "schemaVersion": "1.0.0",
  "id": "workspace.run-tests",
  "version": 1,
  "title": "Run tests through an exact repository-managed ProjectProfile preset",
  "provider": "workspace",
  "effect": {
    "minimum": "deviceMutation",
    "permitted": [
      "deviceMutation"
    ]
  },
  "authorization": {
    "deviceMutation": "standingCapability"
  },
  "binding": "none",
  "concurrencyKey": "host-exclusive",
  "inputs": {
    "fields": {
      "projectRef": {
        "type": "string",
        "required": true,
        "maxLength": 128
      },
      "testPresetRef": {
        "type": "string",
        "required": true,
        "maxLength": 128
      },
      "expectedWorkspaceRevision": {
        "type": "string",
        "required": false,
        "maxLength": 128,
        "description": "Workspace revision the caller decided against; the provider refuses if the tree moved."
      }
    }
  },
  "outputs": {
    "fields": {
      "testOutput": {
        "type": "artifactReference",
        "required": true
      }
    }
  },
  "steps": [
    {
      "stepID": "run-tests",
      "kind": "runWorkspaceTests",
      "effect": "deviceMutation",
      "cancellation": "immediate",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 900,
  "outputByteBudget": 134217728,
  "retry": {
    "preflightAttempts": 1,
    "mutationAttempts": 1
  },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [
    {
      "name": "test-output.log",
      "role": "log",
      "mediaType": "text/plain",
      "privacy": "standard",
      "required": true
    }
  ],
  "profiles": [
    "workspace-host@1"
  ],
  "defaultPolicyIssuance": "disabled"
}
