{
  "schemaVersion": "1.0.0",
  "id": "input.keyboard",
  "version": 1,
  "title": "Send one private key or UTF-8 text input to the focused default display",
  "provider": "hdc",
  "effect": {
    "minimum": "deviceMutation",
    "permitted": [
      "deviceMutation"
    ]
  },
  "authorization": {
    "deviceMutation": "standingCapability"
  },
  "binding": "confirmedDevice",
  "concurrencyKey": "device-exclusive",
  "inputs": {
    "fields": {
      "keyboardArtifactLease": {
        "type": "artifactLease",
        "required": true,
        "description": "Immutable sensitive keyboard-input JSON Import; only its lease enters the Job."
      },
      "inputEpochUtc": {
        "type": "string",
        "required": true,
        "maxLength": 32,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
        "description": "UTC time of the explicit input decision. Dispatch refuses future, invalid or older-than-ten-second intents; this is not a claim of current application focus or screen capture time."
      }
    }
  },
  "outputs": {
    "fields": {}
  },
  "steps": [
    {
      "stepID": "confirm-evidence-target",
      "kind": "probeDevice",
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-model",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "deviceModel"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "read-evidence-firmware",
      "kind": "runApprovedRemoteRead",
      "actionRef": {
        "catalogId": "arkdeck-remote-operations",
        "actionId": "firmwareBuild"
      },
      "effect": "readOnly",
      "cancellation": "immediate",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "inject-keyboard-input",
      "kind": "injectKeyboardInput",
      "effect": "deviceMutation",
      "cancellation": "atSafeBoundary",
      "binding": "confirmedDevice",
      "compensation": "none"
    },
    {
      "stepID": "finalize-session",
      "kind": "finalizeSession",
      "effect": "hostOnly",
      "cancellation": "atSafeBoundary",
      "binding": "none",
      "compensation": "none"
    }
  ],
  "timeoutSeconds": 60,
  "outputByteBudget": 1048576,
  "retry": {
    "preflightAttempts": 2,
    "mutationAttempts": 1
  },
  "unknownOutcome": "reconcileRequired",
  "artifacts": [],
  "profiles": [
    "openharmony-standard@1",
    "dayu200"
  ]
}
