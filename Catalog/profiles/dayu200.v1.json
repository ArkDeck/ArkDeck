{
  "schemaVersion": "1.0.0",
  "id": "dayu200",
  "version": 1,
  "provider": "rockchip",
  "title": "DAYU200 (RK3568) development board",
  "constraints": {
    "deviceModel": "DAYU200 (RK3568)",
    "loaderTransport": ["usb"],
    "partitionVocabulary": [
      "uboot",
      "boot_linux",
      "system",
      "vendor",
      "userdata",
