{
  "name": "@arkdeck/ds",
  "version": "0.1.0",
  "private": true,
  "description": "ArkDeck design system — the component vocabulary of the OpenHarmony device workbench",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test scripts/*interactions.test.mjs",
    "build": "npm run check:tokens && npm run check:previews && npm run build:types && npm run build:js && npm run build:previews && npm run build:css",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:previews": "tsc -p tsconfig.previews.json",
    "build:types": "tsc -p tsconfig.json",
    "build:js": "esbuild src/index.ts --bundle --format=esm --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --outfile=dist/index.js",
    "build:previews": "node scripts/build-previews.mjs",
    "build:review": "esbuild scripts/session-review.tsx --bundle --format=esm --jsx=automatic --alias:@arkdeck/ds=./src/index.ts --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom --outfile=dist/session-review.js",
    "build:css": "node scripts/copy-css.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
